+# every rate UNKNOWN and no sixth column at all.
+echo "  Q. transcript -> labelled rate + freshness; no usage -> UNKNOWN + fresh; none -> UNKNOWN/- (live file)"
+WORKQ=$(mktemp -d /private/tmp/weizigo/wf-tx-XXXXXX)
