# ── helpers ──────────────────────────────────────────────────────────

def _parse_cputime(s):
    """Parse a ps-style CPU time string to total seconds (float).

    Accepts formats (all three from macOS / Linux `ps`):
      [[hh:]mm:]ss          (Linux, whole seconds)
      [[hh:]mm:]ss.cc       (macOS, centiseconds suffix)
      [dd-]hh:mm:ss[.cc]    (days-hours:minutes:seconds[.centiseconds])
      0                     (single digit, edge case)
    """
    s = s.strip()
    if not s:
        return 0.0
    # Days prefix: "dd-hh:mm:ss" or "dd-hh:mm:ss.cc"
    if '-' in s:
        days_part, rest = s.split('-', 1)
        try:
            days = int(days_part)
        except ValueError:
            return 0.0
        return days * 86400 + _parse_hms(rest)
    # [[hh:]mm:]ss or [[hh:]mm:]ss.cc
    return _parse_hms(s)


def _parse_hms(s):
    """Parse [[hh:]mm:]ss[.cc] to float seconds."""
    parts = s.split(':') if ':' in s else ['0', s]
    try:
        if len(parts) == 3:
            h, m, rest = parts
            secs = float(rest) if '.' in rest else int(rest)
            return int(h) * 3600 + int(m) * 60 + secs
        if len(parts) == 2:
            m, rest = parts
            secs = float(rest) if '.' in rest else int(rest)
            return int(m) * 60 + secs
        if len(parts) == 1:
            return float(parts[0]) if '.' in parts[0] else int(parts[0])
    except ValueError:
        return 0.0
    return 0.0


def _format_duration(secs):
    """Format seconds per the operator rule (2026-08-19): a duration never
    contains a colon. >= 3600 s -> NhMM (e.g. 4h28); 60-3599 s -> N'SS
    (e.g. 19'48); < 60 s -> SSs (e.g. 48s) or SS.cc bare when fractional."""
    secs = float(secs)
    if secs < 60:
        if secs == int(secs):
            return f"{int(secs)}s"
        return f"{secs:.2f}"
    if secs < 3600:
        m, s = divmod(int(secs), 60)
        return f"{m}'{s:02d}"
    h, r = divmod(int(secs), 3600)
    return f"{h}h{r // 60:02d}"


def _cpu_time_seconds(pid):
    """Return cumulative CPU time in seconds for `pid`, or None.

    Uses the `time` column (total CPU = user + system) from `ps`.
    On macOS the format is [[hh:]mm:]ss.cc; on Linux [[hh:]mm:]ss.
    """
    try:
        out = subprocess.run(
            ["ps", "-o", "time=", "-p", str(pid)],
            capture_output=True, text=True, timeout=0.5,
        )
        if out.returncode == 0 and out.stdout.strip():
            return _parse_cputime(out.stdout.strip())
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


# ── repo root (git rev-parse first, walk-up fallback) ───────────────────────

def _find_repo_root():
    """Resolve the repo root, worktree-aware (T449).

    A git WORKTREE's `.git` is a FILE carrying a `gitdir:` pointer, not a
    directory, so the isdir-only walk-up could not see a worktree root and
    walked to the filesystem root, returning None — silently killing
    heartbeats, directive reads, and the auto-claim path for any runner
    launched from a worktree (the T447 race ran five lanes with no
    heartbeats, 2026-08-18).  Prefer git's own answer: `git rev-parse
    --show-toplevel` accepts both the normal `.git` directory and the
    worktree `.git` file (T376 fixed the identical defect in
    tools/bakeoff.sh).  Do NOT simply add os.path.isfile: a `.git` file's
    `gitdir:` may point outside the tree, and the git command already
    answers correctly for both forms.

    The walk-up remains only as the fallback for a non-git directory — the
    runner is a general-purpose command wrapper that must keep working
    outside any repository (heartbeat/directive features are then inert,
    exactly as before the fix).
    """
    try:
        proc = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            timeout=2.0,
        )
        if proc.returncode == 0:
            root = proc.stdout.strip()
            if root:
                return root
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    # Not inside a git repository (or no git on PATH): walk up for a
    # `.git` DIRECTORY, the normal-checkout form.
    current = os.getcwd()
    while True:
        if os.path.isdir(os.path.join(current, ".git")):
            return current
        parent = os.path.dirname(current)
        if parent == current:
            return None
        current = parent


# ── directive checking (WORKER-CHANNEL) ────────────────────────────────────

def _check_directives(task_id, repo_root, verbose=True):
    """Check for pending directives addressed to `task_id`.

    Reads docs/infra/managent/directives.jsonl (one JSON object per line)
    and looks for unread entries targeting this task.  With verbose=True
    (launch-time use) prints any pending directives on stderr.  Returns
    the list of pending STOP directives (pause/kill) — empty when none;
    the caller exits 124 when it is non-empty.

    T370 (2026-08-06): the mid-run poll calls this with verbose=False so
    an unread `amend`/`question` does not spam stderr every poll — stop
    directives are the only ones the runner acts on mid-run.
    """
    if not repo_root or not task_id:
        return []

    dir_path = os.path.join(repo_root, "docs", "infra", "managent", "directives.jsonl")
    if not os.path.isfile(dir_path):
        return []

    try:
        pending = []
        with open(dir_path) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if d.get("target") == task_id and d.get("read") is False:
                    pending.append(d)
    except OSError:
        return []

    stops = [d for d in pending if d.get("directive") in ("pause", "kill")]
    if not pending or not verbose:
        return stops

    print("[runner] === pending directives ===", file=sys.stderr)
    for d in pending:
        directive = d.get("directive", "?")
        note = d.get("note", "")
        from_who = d.get("from", "?")
        print(f"[runner]   {directive.upper()}  from {from_who}", file=sys.stderr)
        if note:
            print(f"[runner]     {note}", file=sys.stderr)

    return stops


# ── run records (T364, 2026-08-20) — parent-side exit evidence ──────────────
#
# A SIGKILLed runner cannot write its own exit heartbeat — on 2026-08-04 the
# Orchestrator's load-16 sweep killed every process above 50% CPU with
# `kill -9`, and T355/T356 ended with NO exit beat at all (wall 5.5s, launch
# only).  `managent liveness` cannot tell "never started" from "killed
# mid-flight" from heartbeats alone.
#
# The run record fixes the structural gap: the PARENT records the child's
# fate, not the child.  The runner writes untracked/runs/<task>.json at
# LAUNCH (pid, pgid, start, command, launcher_pid) and REWRITES it at exit
# with the child's outcome (exit status OR signal, wall, peak RSS, kill
# reason).  Two failure classes, both readable afterwards:
#   - kill -9 of the CHILD: the runner survives and writes a COMPLETED
#     record (exit/signal fields present) — evidence exists despite the
#     SIGKILL;
#   - kill -9 of the RUNNER itself: the launch record remains with NO exit
#     fields — the next `managent reap` / `resume` reads "killed mid-flight".
#
# `managent reap` keys the row to the record's "task" field and checks the
# record's "pid" (the runner's own pid) against the process table: alive
# runner = backed row (never reap an idle-but-alive worker — stalled is the
# progress watchdog's job); dead runner = orphan, with the record's fields
# as the evidence for the abandoned note.

def _sanitize_identity(task_identity):
    """Map a task identity to a filesystem-safe filename segment.

    Task identities may carry '/' (e.g. DSPro/2B-5, runner/<pid>); the run
    record path must be a single file, so every character outside the safe
    set becomes '_'.  reap matches on the record's stored "task" field, not
    the filename, so the mangling is cosmetic only.
    """
    return "".join(ch if (ch.isalnum() or ch in "._-") else "_" for ch in task_identity)


def _run_record_path(task_identity, repo_root):
    return os.path.join(repo_root, "untracked", "runs", _sanitize_identity(task_identity) + ".json")


def _write_run_record(record, repo_root):
    """Atomically write a run record (tmp + rename).

    Torn writes matter here: the record is exactly the evidence that
    survives a SIGKILL, so a half-written record must never be what a
    reader sees.  tmp + os.replace keeps the visible file either the old
    version or the complete new one.
    """
    if not repo_root:
        return
    path = _run_record_path(record.get("task", "unknown"), repo_root)
    tmp = path + ".tmp"
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(tmp, "w") as f:
            json.dump(record, f, sort_keys=True)
            f.write("\n")
        os.replace(tmp, path)
    except OSError:
        try:
            if os.path.exists(tmp):
                os.unlink(tmp)
        except OSError:
            pass


def _finalize_run_record(run_record, repo_root, ret=None, signum=None, wall=None, cpu=None, rss_mb=None, killed=None):
    """Stamp the child's outcome onto the in-memory launch record and persist.

    ret is the child's exit code; signum is the signal that killed the child
    (subprocess reports killed-by-signal as a negative returncode, so the
    caller passes signum explicitly on the kill paths).  Either may be None:
    a record with neither is a launch record whose runner died before the
    child's fate was known — "killed mid-flight", not "completed".
    """
    if run_record is None:
        return
    run_record["end"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    if ret is not None:
        run_record["exit"] = ret
    if signum is not None:
        run_record["signal"] = signum
    if wall is not None:
        run_record["wall"] = round(wall, 1)
    if cpu is not None:
        run_record["cpu"] = round(cpu, 1)
    if rss_mb is not None:
        run_record["rss_mb"] = round(rss_mb, 1)
    if killed is not None:
        run_record["killed"] = killed
    _write_run_record(run_record, repo_root)


# ── heartbeat emission (WORKER-CHANNEL) ────────────────────────────────────

def _emit_heartbeat(task_id, command, wall, cpu, rss_mb, repo_root):
    """Append a heartbeat line to untracked/heartbeat.jsonl.

    The heartbeat records the runner invocation so `managent liveness`
    can report per-task liveness.
    """
    if not repo_root:
        return

    hb_dir = os.path.join(repo_root, "untracked")
    os.makedirs(hb_dir, exist_ok=True)
    hb_path = os.path.join(hb_dir, "heartbeat.jsonl")

    ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    record = {
        "identifier": task_id or "unknown/unknown",
        "task": task_id or "unknown",
        "ts": ts,
        "command": command or "",
        "wall": round(wall, 1) if wall >= 0 else None,
        "cpu": round(cpu, 1) if cpu >= 0 else None,
        "rss_mb": round(rss_mb, 1) if rss_mb >= 0 else None,
    }
    # Strip None values for brevity
    record = {k: v for k, v in record.items() if v is not None}

    try:
        with open(hb_path, "a") as f:
            f.write(json.dumps(record, sort_keys=True) + "\n")
    except OSError:
        pass


def prepend_releasefast(argv):
    """Auto-add an optimize flag for `zig` invocations if missing.

    The 2026-07-29 host panic was caused by `zig build-exe` running in Debug
    (LLVM path is the memory hog). The fix: ensure every zig invocation in
    the runner has an explicit -O / -Doptimize, defaulting to ReleaseFast.

      zig build / build install   -> -Doptimize=ReleaseFast (project option)
      zig build-exe / build-lib / build-obj / test / run / install
                                   -> -O ReleaseFast (command-level option)

    T311 (2026-08-03): fix optimize-flag detection.  The old check
    ``"-Doptimize" in argv`` uses exact token equality, which never matches
    ``-Doptimize=ReleaseSafe`` (a single token with an embedded '=').
    Now detects any argv element that *starts with* ``-Doptimize``, so a
    caller who explicitly asks for ReleaseSafe or Debug gets it.
    """
    if not argv:
        return argv
    if Path(argv[0]).name != "zig":
        return argv
    # Detect any existing optimize flag — an argv element that starts
    # with -Doptimize (e.g. -Doptimize=ReleaseSafe) or is exactly -O.
    # Exact token equality (the old check) fails for -Doptimize=<mode>
    # because the token never equals the bare string "-Doptimize".
    has_optimize = any(
        arg == "-O" or arg.startswith("-Doptimize")
        for arg in argv
    )
    if has_optimize:
        return argv
    if len(argv) < 2:
        return argv
    sub = argv[1]
    if sub in ("build",):
        return [argv[0], sub, "-Doptimize=ReleaseFast", *argv[2:]]
    if sub in ("build-exe", "build-lib", "build-obj", "test", "run", "install"):
        return [argv[0], sub, "-O", "ReleaseFast", *argv[2:]]
    return argv


# ── sweep (standalone) ───────────────────────────────────────────────

def sweep():
    """List top CPU consumers on the host (finding orphan zig processes).

    Orphaned `zig test` / `zig build-exe` binaries compile to anonymous
    paths under .zig-cache/ and are invisible to name-based greps.  This
    mode lists every process by cumulative CPU time, so the human or a
    follow-up agent can identify spinners.
    """
    print("[runner] === SWEEP: top processes by CPU time ===", file=sys.stderr)
    try:
        out = subprocess.run(
            ["ps", "-axo", "pid=,etime=,cputime=,command="],
            capture_output=True, text=True, timeout=5.0,
        )
    except FileNotFoundError:
        print("[runner] SWEEP failed: `ps` not found", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print("[runner] SWEEP failed: `ps` timed out", file=sys.stderr)
        sys.exit(1)

    lines = out.stdout.splitlines()
    if not lines:
        print("[runner] SWEEP: no processes", file=sys.stderr)
        sys.exit(0)

    def sort_key(line):
        # cputime is the third whitespace-delimited column after pid, etime
        parts = line.split(None, 3)
        if len(parts) >= 3:
            return _parse_cputime(parts[2])
        return 0

    data = sorted(lines, key=sort_key, reverse=True)
    header = data[0] if data else ""
    body = data[1:] if len(data) > 1 else []
    n_show = min(20, len(body))

    print(f"  PID  ELAPSED    CPU        COMMAND", file=sys.stderr)
    print(f"  ---  --------   --------   -------", file=sys.stderr)
    for line in body[:n_show]:
        parts = line.split(None, 3)
        if len(parts) >= 4:
            pid, etime, cputime, cmd = parts
            el = _format_duration(_parse_cputime(etime))
            ct = _format_duration(_parse_cputime(cputime))
            print(f"  {pid:<5s} {el:<10s} {ct:<10s} {cmd}", file=sys.stderr)
        else:
            print(f"  {line}", file=sys.stderr)
    print(f"[runner] === {len(body)} processes total, showing top {n_show} ===", file=sys.stderr)
    sys.exit(0)


# ── process tree walking ─────────────────────────────────────────────

def _descendant_pids_linux(root_pid):
    """Walk /proc and return root_pid + all descendants (Linux)."""
    pids = set()
    children = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        try:
            with open(f"/proc/{pid}/status") as f:
                ppid = None
                for line in f:
                    if line.startswith("PPid:"):
                        ppid = int(line.split()[1])
                        break
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
        if ppid is not None:
            children.setdefault(ppid, []).append(pid)
    # BFS from root_pid
    stack = [root_pid]
    while stack:
        pid = stack.pop()
        pids.add(pid)
        stack.extend(children.get(pid, []))
    return pids


def _descendant_pids_ps(root_pid):
    """Walk via `ps` and return root_pid + all descendants (macOS / BSD)."""
    out = subprocess.run(
        ["ps", "-axo", "pid=,ppid="], capture_output=True, text=True, timeout=2.0,
    )
    children = {}
    for line in out.stdout.splitlines():
        parts = line.split()
        if len(parts) != 2:
            continue
        try:
            pid, ppid = int(parts[0]), int(parts[1])
        except ValueError:
            continue
        children.setdefault(ppid, []).append(pid)
    pids = set()
    stack = [root_pid]
    while stack:
        pid = stack.pop()
        pids.add(pid)
        stack.extend(children.get(pid, []))
    return pids


# ── platform detection (once at import) ──────────────────────────────

def _detect_walker():
    """Detect platform process-tree walker once at startup.

    On Linux with /proc available, uses the fast /proc-based walker.
    On all other platforms (macOS, BSD, containers without /proc),
    falls back to `ps`.  Called once at module load; the result is
    stored in _WALKER_FN / _WALKER_NAME for the lifetime of the run.
    """
    if sys.platform == 'linux' and os.path.isdir('/proc'):
        return _descendant_pids_linux, 'linux /proc'
    return _descendant_pids_ps, 'ps'

_WALKER_FN, _WALKER_NAME = _detect_walker()


# ── runner message dedup ─────────────────────────────────────────────

_LAST_RUNNER_MSG = [None]  # mutable single-element list as closure cell

def _runner_print(msg, file=None):
    """Print a [runner] line, suppressing consecutive identical repeats.

    Rate-limits per-poll messages that would otherwise drown the log
    (the linux walker fallback on darwin, per-poll RSS logging, etc.).
    Different messages always pass through; only identical back-to-back
    repeats are suppressed.  The one-element-list cell avoids `global`.
    """
    if msg == _LAST_RUNNER_MSG[0]:
        return
    _LAST_RUNNER_MSG[0] = msg
    print(msg, file=file or sys.stderr)


# ── RSS reading ──────────────────────────────────────────────────────

def _rss_bytes(pid):
    """Return RSS in bytes for `pid`, or None on any read failure.

    Linux: read VmRSS from /proc/<pid>/status (kB -> bytes).
    macOS: `ps -o rss= -p <pid>` (kB -> bytes, on macOS this is 1024-byte
    pages reported as kB; rounding is fine for the cap check).

    The platform split is per *pid*, not per process invocation: a runner
    that itself runs on Linux must still tolerate a macOS-style ps when
    /proc is unavailable (containers, chroots, etc.). The Linux branch
    returns the bytes; if /proc is not present it returns the macOS-style
    sentinel `'NOPROC'` and the caller falls through to ps. The function
    does NOT return None for "platform unsupported" — None is for "I tried
    everything and the pid is gone or unreadable."
    """
    # Linux: /proc/<pid>/status has VmRSS in kB. If /proc itself does not
    # exist (macOS / BSD), signal the caller to try the ps path.
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("VmRSS:"):
                    return int(line.split()[1]) * 1024
    except FileNotFoundError as e:
        # /proc may not exist on this host (macOS, BSD, some containers).
        # Distinguish "no /proc" from "pid is gone": the former opens the
        # directory and raises ENOENT for the *directory*, the latter is
        # the file. We treat "no /proc" as the platform signal.
        if "/proc" in str(e):
            return "NOPROC"
        return None
    except (ProcessLookupError, PermissionError):
        return None

    # macOS / BSD: ps -o rss= -p <pid> gives RSS in kB.
    try:
        out = subprocess.run(
            ["ps", "-o", "rss=", "-p", str(pid)],
            capture_output=True, text=True, timeout=0.5,
        )
        if out.returncode == 0 and out.stdout.strip():
            return int(out.stdout.strip()) * 1024
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


# ── host memory (fleet-aware guard, T362) ───────────────────────────
#
# The per-process RSS cap bounds ONE worker.  It says nothing about five
# workers at once.  This host has 48 GB and took a watchdog-timeout kernel
# PANIC under OOM on 2026-07-29 (docs/infra/host/incident-2026-07-29.md:
# zig at 12.5 GB resident, system free ~46 MB of 48 GB, watchdogd starved
# 91 s, Apple silicon watchdog fired).  The fleet-aware guard reads
# system-wide available memory and, below a danger floor derived from
# hw.memsize, SIGKILLs the LARGEST member of this process group — a fleet
# citizen relieving host pressure before the host panics.  The floor is
# derived, never hardcoded; do not raise it casually.
#
# The danger floor is NEVER tested by actually exhausting host memory;
# WEIZIGO_HOST_MEM_AVAIL_MB injects the reading for the composition test.

def _host_mem_bytes():
    """Return total physical memory in bytes, or None.

    macOS: `sysctl -n hw.memsize`.
    Linux: /proc/meminfo `MemTotal:` in kB.
    """
    if sys.platform == 'linux' and os.path.isdir('/proc'):
        try:
            with open("/proc/meminfo") as f:
                for line in f:
                    if line.startswith("MemTotal:"):
                        return int(line.split()[1]) * 1024
        except (OSError, ValueError, IndexError):
            return None
        return None
    try:
        out = subprocess.run(
            ["sysctl", "-n", "hw.memsize"],
            capture_output=True, text=True, timeout=2.0,
        )
        if out.returncode == 0 and out.stdout.strip():
            return int(out.stdout.strip())
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


def _host_avail_bytes():
    """Return system-wide available memory in bytes, or None.

    Available = memory reclaimable without swapping.  When the env var
    WEIZIGO_HOST_MEM_AVAIL_MB is set, that value is returned verbatim —
    the test hook that lets the composition case reproduce without
    exhausting the host (T362 bar: inject the reading).

    macOS: vm_stat (free + inactive + purgeable + speculative) * page size.
    Linux: /proc/meminfo `MemAvailable:` in kB.
    """
    injected = os.environ.get("WEIZIGO_HOST_MEM_AVAIL_MB")
    if injected is not None:
        try:
            return int(injected) * 1024 * 1024
        except ValueError:
            pass  # fall through to the real reading

    if sys.platform == 'linux' and os.path.isdir('/proc'):
        try:
            with open("/proc/meminfo") as f:
                for line in f:
                    if line.startswith("MemAvailable:"):
                        return int(line.split()[1]) * 1024
        except (OSError, ValueError, IndexError):
            return None
        return None

    # macOS / BSD: vm_stat.  The first line carries the page size; the
    # reclaimable page classes are free / inactive / purgeable / speculative.
    try:
        out = subprocess.run(
            ["vm_stat"], capture_output=True, text=True, timeout=2.0,
        )
        if out.returncode != 0:
            return None
        page = 4096
        classes = {"Pages free:": 0, "Pages inactive:": 0,
                  "Pages purgeable:": 0, "Pages speculative:": 0}
        for line in out.stdout.splitlines():
            ls = line.strip()
            if "page size of" in ls:
                m = re.search(r'page size of (\d+)', ls)
                if m:
                    page = int(m.group(1))
                continue
            for key in classes:
                if ls.startswith(key):
                    # "Pages free:  832602." -> strip the trailing dot
                    tail = ls[len(key):].strip().rstrip('.')
                    try:
                        classes[key] = int(tail)
                    except ValueError:
                        pass
        return sum(classes.values()) * page
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


# ── logging ──────────────────────────────────────────────────────────

def _log_peaks(peak_rss, peak_cpu=None, t0=None):
    elapsed = f" in {time.monotonic() - t0:.1f} s" if t0 else ""
    print(f"[runner] peak RSS by PID:{elapsed}", file=sys.stderr)
    for pid in sorted(peak_rss, key=lambda p: -peak_rss[p]):
        mb = peak_rss[pid] // (1024 * 1024)
        print(f"[runner]   pid {pid:>7d}  {mb:>6d} MB", file=sys.stderr)
    if peak_cpu:
        print(f"[runner] peak total CPU by PID:{elapsed}", file=sys.stderr)
        for pid in sorted(peak_cpu, key=lambda p: -peak_cpu[p]):
            secs = peak_cpu[pid]
            print(f"[runner]   pid {pid:>7d}  {_format_duration(secs):>10s} ({secs}s)", file=sys.stderr)


# ── main ─────────────────────────────────────────────────────────────

def _drain_stderr(proc, progress_seen, last_progress_time, task_identity, command, repo_root):
    """Read any remaining stderr from the child after it exits.

    Forwards lines to the runner's stderr, checks for [progress] markers,
    and emits a heartbeat on each one found.
    """
    try:
        import fcntl as _fcntl
        fd = proc.stderr.fileno()
        fl = _fcntl.fcntl(fd, _fcntl.F_GETFL)
        _fcntl.fcntl(fd, _fcntl.F_SETFL, fl & ~os.O_NONBLOCK)
        remaining = proc.stderr.read()
        if remaining:
            for line in remaining.splitlines():
                print(line, file=sys.stderr)
                if '[progress]' in line:
                    _emit_heartbeat(task_identity, command, time.monotonic(), -1, -1, repo_root)
    except (ValueError, OSError):
        pass


def main():
    ap = argparse.ArgumentParser(
        prog="tools/runner",
        description="Guarded runner for weizigo agent builds. "
                    "Default -O ReleaseFast; SIGKILL the group at the "
                    "RSS / wall / CPU ceiling.  Also: --sweep for "
                    "orphan-zig detection.",
    )
    ap.add_argument("--rss-cap-mb", type=int, default=12288,
                    help="secondary bound: SIGKILL the process group when any "
                         "member exceeds this RSS in MB (default 12288 — "
                         "generous now that the host guard exists; catches a "
                         "single runaway allocation, not a legitimate 4.1 GB "
                         "check). 0 disables the per-process cap.")
    ap.add_argument("--host-mem-floor-mb", type=int, default=0,
                    help="fleet-aware guard: when system-wide available "
                         "memory falls below this floor, SIGKILL the LARGEST "
                         "member of the process group (a fleet citizen relieving "
                         "host pressure before the host panics).  Default 0 = "
                         "derive from hw.memsize (total // 8).  The 2026-07-29 "
                         "host panic (system free ~46 MB of 48 GB) is the "
                         "precedent — do not raise it casually.  See "
                         "docs/infra/host/incident-2026-07-29.md.")
    ap.add_argument("--no-host-guard", action="store_true",
                    help="disable the fleet-aware host-pressure guard "
                         "(the per-process cap and progress watchdog remain)")
    ap.add_argument("--max-wall", type=int, default=1800,
                    help="(fallback for silent children) SIGKILL after this "
                         "many wall seconds if no [progress] lines seen "
                         "(default 1800 = 30 min; 0 to disable)")
    ap.add_argument("--max-cpu", type=int, default=3600,
                    help="(fallback for silent children) SIGKILL when "
                         "cumulative CPU exceeds this if no [progress] lines "
                         "seen (default 3600 = 1h; 0 to disable)")
    ap.add_argument("--progress-timeout", type=int, default=600,
                    help="SIGKILL when child emits no [progress] line for "
                         "this many seconds (default 600 = 10 min). "
                         "Set 0 to disable progress watchdog (fallback "
                         "ceilings still apply).")
    ap.add_argument("--poll-ms", type=int, default=250,
                    help="RSS / CPU / wall check interval in ms (default 250)")
    ap.add_argument("--no-prepend-zig", action="store_true",
                    help="do not auto-add -O ReleaseFast to zig commands")
    ap.add_argument("--log-rss", action="store_true",
                    help="log per-member RSS every poll (verbose)")
    ap.add_argument("--show-peak-on-exit", dest="show_peak", action="store_true", default=True,
                    help="log per-member peak RSS on exit (default true)")
    ap.add_argument("--no-show-peak-on-exit", dest="show_peak", action="store_false",
                    help="do not log per-member peak RSS on exit")
    ap.add_argument("--task-id", type=str, default=None,
                    help="worker/task identifier for heartbeat and directive "
                         "checking, e.g. DSPro/2B-5 or WORKER-CHANNEL")
    ap.add_argument("--directive-poll-s", type=int, default=10,
                    help="re-check directives every N seconds during the run, "
                         "so a `managent tell <id> pause|kill` stops a RUNNING "
                         "command too (default 10; 0 to disable) (T370)")
    ap.add_argument("--sweep", action="store_true",
                    help="standalone: list top CPU consumers on the host "
                         "(no command needed)")
    ap.add_argument("rest", nargs=argparse.REMAINDER,
                    help="command and arguments after `--`")
    args = ap.parse_args()

    # Handle --sweep (standalone)
    if args.sweep:
        sweep()
        # sweep() calls sys.exit, but be safe:
        return

    # argparse.REMAINDER includes the leading `--` if present; strip it
    if not args.rest:
        ap.error("missing command; pass `-- <command> [args...]` or use `--sweep`")
    if args.rest[0] == "--":
        argv = args.rest[1:]
    else:
        argv = args.rest
    if not argv:
        ap.error("missing command after `--`")

    if not args.no_prepend_zig:
        argv = prepend_releasefast(argv)

    cap_bytes = args.rss_cap_mb * 1024 * 1024
    poll_s = args.poll_ms / 1000.0

    # ── fleet-aware host-pressure guard (T362) ────────────────────────────
    # The danger floor is derived from hw.memsize (total // 8) unless the
    # caller sets --host-mem-floor-mb.  0 with no explicit override means
    # "derive"; --no-host-guard disables.  If the reading is unavailable
    # on the host, the guard is inert (cannot measure = cannot fire).
    host_total = _host_mem_bytes()
    if args.no_host_guard:
        host_floor_bytes = 0
    elif args.host_mem_floor_mb > 0:
        host_floor_bytes = args.host_mem_floor_mb * 1024 * 1024
    elif host_total is not None:
        host_floor_bytes = host_total // 8
    else:
        host_floor_bytes = 0
    host_guard_on = host_floor_bytes > 0
    host_guard_fired = False  # set when the guard SIGKILLs a member

    # New process group so SIGKILL reaches the whole tree, not just the
    # wrapper's child. (The child becomes its own session leader; the
    # group ID == its PID.)
    preexec_fn = lambda: os.setsid() if hasattr(os, "setsid") else None

    print(f"[runner] argv = {shlex.join(argv)}", file=sys.stderr)
    guards = []
    if args.rss_cap_mb:
        guards.append(f"rss {args.rss_cap_mb} MB")
    else:
        guards.append("rss off")
    if host_guard_on:
        floor_mb = host_floor_bytes // (1024 * 1024)
        total_gb = (host_total // (1024 ** 3)) if host_total else 0
        guards.append(f"host-floor {floor_mb} MB (of {total_gb} GB)")
    else:
        guards.append("host-guard off")
    if args.progress_timeout:
        guards.append(f"progress-timeout {args.progress_timeout}s ({_format_duration(args.progress_timeout)})")
    else:
        guards.append("progress-timeout off")
    guards.append(f"fallback: wall {args.max_wall}s cpu {args.max_cpu}s (silent children)")
    print(f"[runner] guards: {', '.join(guards)}, poll = {args.poll_ms} ms", file=sys.stderr)
    print(f"[runner] process walker: {_WALKER_NAME} ({sys.platform})", file=sys.stderr)

    # ── WORKER-CHANNEL: directive check before launch ──────────────────────
    repo_root = _find_repo_root()
    identity_degraded = False
    task_identity = args.task_id or os.environ.get("MANAGENT_TASK_ID")
    if not task_identity:
        # T370 (2026-08-06): identity was NOT propagated by the launch site
        # (no --task-id, no MANAGENT_TASK_ID).  The pid form keeps the
        # heartbeat file self-describing, but `managent liveness` cannot
        # attribute the beats to any row and `managent tell <id>` directives
        # cannot reach this run.  This fallback must be LOUD, not silent —
        # a degraded mode nobody can see is how the fleet ran blind.
        identity_degraded = True
        task_identity = f"runner/{os.getpid()}"
        print("[runner] WARNING: no task identity (no --task-id, no MANAGENT_TASK_ID)", file=sys.stderr)
        print("[runner]   liveness cannot attribute this run's heartbeats, and directives cannot reach it.", file=sys.stderr)
        print(f"[runner]   heartbeats will land under '{task_identity}'.", file=sys.stderr)
        print("[runner]   fix: export MANAGENT_TASK_ID=<task-id> (preferred — children inherit it)", file=sys.stderr)
        print("[runner]        or pass --task-id <task-id> (explicit per-run override).", file=sys.stderr)
    else:
        identity_source = "--task-id" if args.task_id else "MANAGENT_TASK_ID"
        print(f"[runner] task identity: {task_identity} (source: {identity_source})", file=sys.stderr)
    pending_stops = _check_directives(task_identity, repo_root)
    if pending_stops:
        _emit_heartbeat(task_identity, shlex.join(argv), -1, -1, -1, repo_root)
        print(f"[runner] exit 124 (directive: pause/kill pending)", file=sys.stderr)
        sys.exit(124)

    # ── WORKER-CHANNEL: auto-claim via managent ──────────────────────────
    if args.task_id:
        model = os.environ.get("PI_MODEL", "unknown")
        managent = os.path.join(repo_root, "bin", "managent") if repo_root else "bin/managent"
        result = subprocess.run([managent, "claim", args.task_id, "--agent", model], capture_output=True, text=True)
        if result.returncode != 0:
            stderr_text = result.stderr.strip()
            if not stderr_text:
                stderr_text = result.stdout.strip()
            print(f"[runner] manage claim FAILED (exit {result.returncode}): {stderr_text}", file=sys.stderr)
            sys.exit(1)

    t0 = time.monotonic()
    run_record = None  # T364: set after Popen; None guards the exception path if spawn itself fails
    proc = subprocess.Popen(argv, preexec_fn=preexec_fn, stderr=subprocess.PIPE, text=True)
    sys.stderr.flush()

    # ── T364: launch run record — written BEFORE any exit path can run, so
    # a SIGKILL of this runner leaves the evidence (pid, pgid, start) even
    # though the exit record can never be written.  The exit paths below
    # stamp the child's fate onto this same record.
    run_record = {
        "task": task_identity,
        "pid": os.getpid(),
        "pgid": proc.pid,
        "launcher_pid": os.getppid(),
        "start": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "command": shlex.join(argv),
    }
    _write_run_record(run_record, repo_root)

    # Make stderr non-blocking for select-based reading
    import fcntl
    fd = proc.stderr.fileno()
    fl = fcntl.fcntl(fd, fcntl.F_GETFL)
    fcntl.fcntl(fd, fcntl.F_SETFL, fl | os.O_NONBLOCK)

    peak_rss = {}   # pid -> max RSS bytes
    peak_cpu = {}   # pid -> cumulative CPU seconds (peak snapshot per PID)

    # Progress watchdog state
    last_progress_time = t0  # time of last [progress] line seen
    progress_seen = False     # True if at least one [progress] line parsed
    progress_summary = None   # last progress summary for diagnostics
    stderr_buf = ""           # partial-line buffer
    last_log_rss_time = 0.0   # throttle per-poll RSS logging (T311: once per 2 s)

    logs_done = False  # suppress finally-block logging if kill path already did it

    # T370: mid-run directive poll state (gated on identity, see loop)
    last_directive_check = t0

    try:
        while True:
            ret = proc.poll()
            if ret is not None:
                # Read any remaining stderr before exiting loop
                _drain_stderr(proc, progress_seen, last_progress_time,
                              task_identity, shlex.join(argv), repo_root)
                break

            elapsed = time.monotonic() - t0

            # ── read child stderr (non-blocking via select) ────────────
            try:
                r, _, _ = select.select([proc.stderr], [], [], poll_s)
                if proc.stderr in r:
                    chunk = proc.stderr.read()
                    if chunk:
                        stderr_buf += chunk
                        # Process complete lines
                        while '\n' in stderr_buf:
                            line, stderr_buf = stderr_buf.split('\n', 1)
                            # Forward to runner's stderr
                            print(line, file=sys.stderr)
                            # Check for progress marker
                            if '[progress]' in line:
                                last_progress_time = time.monotonic()
                                if not progress_seen:
                                    progress_seen = True
                                    print(f"[runner] progress watchdog active (first [progress] line seen)", file=sys.stderr)
                                progress_summary = line.strip()
                                # ── emit heartbeat on progress ──────────
                                _emit_heartbeat(
                                    task_identity, shlex.join(argv),
                                    elapsed, -1, -1, repo_root,
                                )
            except (ValueError, OSError):
                pass  # stderr closed or select interrupted

            # ── RSS check (always on, no exemption) ────────────────────
            pids = _WALKER_FN(proc.pid)

            total_cpu = 0.0
            over_rss = False
            poll_rss = {}  # pid -> current RSS bytes (this poll, for the host guard)

            for pid in pids:
                # RSS check
                try:
                    rss = _rss_bytes(pid)
                except (FileNotFoundError, ProcessLookupError):
                    continue
                if rss is None:
                    continue
                if rss == "NOPROC":
                    try:
                        out = subprocess.run(
                            ["ps", "-o", "rss=", "-p", str(pid)],
                            capture_output=True, text=True, timeout=0.5,
                        )
                        if out.returncode == 0 and out.stdout.strip():
                            rss = int(out.stdout.strip()) * 1024
                        else:
                            continue
                    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
                        continue
                poll_rss[pid] = rss
                peak_rss[pid] = max(peak_rss.get(pid, 0), rss)
                if args.rss_cap_mb and rss > cap_bytes:
                    over_rss = True
                    if not args.log_rss:
                        print(f"[runner] PID {pid} RSS {rss // (1024*1024)} MB > cap {args.rss_cap_mb} MB", file=sys.stderr)
                    break

                # CPU tracking (for fallback ceiling, always collected)
                cpu = _cpu_time_seconds(pid)
                if cpu is not None:
                    total_cpu += cpu
                    peak_cpu[pid] = max(peak_cpu.get(pid, 0.0), cpu)

                if args.log_rss:
                    now = time.monotonic()
                    if now - last_log_rss_time >= 2.0:
                        last_log_rss_time = now
                        extra = ""
                        if not over_rss:
                            extra = f", RSS {rss // (1024*1024)} MB"
                        _runner_print(f"[runner] PID {pid}{extra}")
            sys.stderr.flush()

            # ── fleet-aware host-pressure guard (T362) ──────────────────
            # Read system-wide available memory; below the danger floor,
            # SIGKILL the LARGEST member of the process group — a fleet
            # citizen relieving host pressure before the host panics (the
            # 2026-07-29 watchdog-timeout panic is the precedent).  Surgical:
            # only the largest pid dies.  If that pid is the direct child,
            # the run ends (kill_reason escalates to the exit-124 path);
            # otherwise the loop continues and, if pressure persists, the
            # next poll kills the next-largest.  The reading is injectable
            # via WEIZIGO_HOST_MEM_AVAIL_MB so the danger floor is never
            # tested by actually exhausting host memory.
            kill_reason = None
            if host_guard_on and poll_rss:
                avail = _host_avail_bytes()
                if avail is not None and avail < host_floor_bytes:
                    largest_pid = max(poll_rss, key=lambda p: poll_rss[p])
                    largest_rss = poll_rss[largest_pid]
                    avail_mb = avail // (1024 * 1024)
                    floor_mb = host_floor_bytes // (1024 * 1024)
                    if largest_pid == proc.pid:
                        # killing the direct child ends the run
                        kill_reason = (
                            f"host memory pressure — avail {avail_mb} MB "
                            f"< floor {floor_mb} MB (largest member pid "
                            f"{largest_pid} RSS "
                            f"{largest_rss // (1024*1024)} MB)"
                        )
                    else:
                        try:
                            os.kill(largest_pid, signal.SIGKILL)
                            host_guard_fired = True
                            print(
                                f"[runner] KILL: host memory pressure — "
                                f"avail {avail_mb} MB < floor {floor_mb} MB",
                                file=sys.stderr,
                            )
                            print(
                                f"[runner]   killed largest member: pid "
                                f"{largest_pid} RSS "
                                f"{largest_rss // (1024*1024)} MB",
                                file=sys.stderr,
                            )
                        except ProcessLookupError:
                            pass

            # ── WORKER-CHANNEL: mid-run directive poll (T370) ───────────
            # A `managent tell <id> pause|kill` issued after launch must
            # still land — without identity the seat could not halt an
            # authorised long compute except by signalling the pid by hand.
            # Poll every --directive-poll-s; a pending stop directive is
            # treated exactly like the launch-time check (exit 124).
            midrun_kill_reason = None
            if args.directive_poll_s > 0 and not identity_degraded:
                now_m = time.monotonic()
                if now_m - last_directive_check >= args.directive_poll_s:
                    last_directive_check = now_m
                    midrun_stops = _check_directives(task_identity, repo_root, verbose=False)
                    if midrun_stops:
                        d = midrun_stops[0]
                        midrun_kill_reason = (
                            f"directive {d.get('id', '?')} "
                            f"{str(d.get('directive', '?')).upper()} "
                            f"from {d.get('from', '?')} (mid-run poll)"
                        )

            # ── kill decisions ────────────────────────────────────────
            if kill_reason:
                pass  # host guard already decided (direct-child kill)
            elif midrun_kill_reason:
                kill_reason = midrun_kill_reason
            elif over_rss:
                kill_reason = f"RSS cap {args.rss_cap_mb} MB exceeded"
            elif progress_seen:
                # Progress watchdog: kill if no progress for --progress-timeout
                if args.progress_timeout > 0:
                    since_progress = time.monotonic() - last_progress_time
                    if since_progress >= args.progress_timeout:
                        kill_reason = (
                            f"progress timeout {args.progress_timeout}s "
                            f"({_format_duration(args.progress_timeout)}) — "
                            f"no [progress] for {since_progress:.0f}s"
                        )
            else:
                # Fallback: silent child — use traditional wall/CPU ceilings
                progress_notice_printed = False  # kept in outer scope for diagnostics
                if args.max_wall and elapsed >= args.max_wall:
                    kill_reason = (
                        f"wall ceiling {args.max_wall}s "
                        f"({_format_duration(args.max_wall)}) reached "
                        f"at {elapsed:.1f}s elapsed (no [progress] lines seen)"
                    )
                elif args.max_cpu and total_cpu >= args.max_cpu:
                    kill_reason = (
                        f"CPU ceiling {args.max_cpu}s "
                        f"({_format_duration(args.max_cpu)}) exceeded "
                        f"({total_cpu:.1f}s total) (no [progress] lines seen)"
                    )

            if kill_reason:
                print(f"[runner] KILL: {kill_reason}", file=sys.stderr)
                print(f"[runner] SIGKILL pgid {proc.pid}", file=sys.stderr)
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                try:
                    proc.wait(timeout=2.0)
                except subprocess.TimeoutExpired:
                    pass
                if args.show_peak:
                    _log_peaks(peak_rss, peak_cpu, t0=t0)
                logs_done = True
                elapsed = time.monotonic() - t0
                peak_rss_mb = max(peak_rss.values()) // (1024 * 1024) if peak_rss else 0
                total_cpu_sum = sum(peak_cpu.values()) if peak_cpu else 0.0
                _emit_heartbeat(task_identity, shlex.join(argv), elapsed, total_cpu_sum, peak_rss_mb, repo_root)
                _finalize_run_record(run_record, repo_root, ret=None, signum=signal.SIGKILL,
                                    wall=elapsed, cpu=total_cpu_sum, rss_mb=peak_rss_mb,
                                    killed=kill_reason)
                print(f"[runner] exit 124 ({kill_reason}) in {elapsed:.1f} s", file=sys.stderr)
                sys.exit(124)

        ret = proc.wait()
    except Exception as exc:
        elapsed = time.monotonic() - t0
        _emit_heartbeat(task_identity, shlex.join(argv), elapsed, -1, -1, repo_root)
        _finalize_run_record(run_record, repo_root, wall=elapsed, killed=f"runner exception: {exc}")
        raise
    finally:
        if args.show_peak and not logs_done and (peak_rss or peak_cpu):
            _log_peaks(peak_rss, peak_cpu, t0=t0)

    elapsed = time.monotonic() - t0
    peak_rss_mb = max(peak_rss.values()) // (1024 * 1024) if peak_rss else 0
    total_cpu_sum = sum(peak_cpu.values()) if peak_cpu else 0.0
    _emit_heartbeat(task_identity, shlex.join(argv), elapsed, total_cpu_sum, peak_rss_mb, repo_root)
    # T364: child's fate — subprocess reports killed-by-signal as a negative
    # returncode (-signum).  Record the signal separately so reap's note can
    # name "SIGKILL" instead of a bare code.
    if ret < 0:
        _finalize_run_record(run_record, repo_root, ret=None, signum=-ret,
                            wall=elapsed, cpu=total_cpu_sum, rss_mb=peak_rss_mb)
    else:
        _finalize_run_record(run_record, repo_root, ret=ret,
                            wall=elapsed, cpu=total_cpu_sum, rss_mb=peak_rss_mb)
    if host_guard_fired:
        print(f"[runner] note: host guard fired during this run (relieved host pressure; proc exited {ret})", file=sys.stderr)
    print(f"[runner] exit {ret} in {elapsed:.1f} s", file=sys.stderr)

    # ── WORKER-CHANNEL: auto-done on success ─────────────────────────────
    if ret == 0 and args.task_id:
        managent = os.path.join(repo_root, "bin", "managent") if repo_root else "bin/managent"
        result = subprocess.run([managent, "done", args.task_id], capture_output=True, text=True)
        if result.returncode != 0:
            stderr_text = result.stderr.strip()
            if not stderr_text:
                stderr_text = result.stdout.strip()
            print(f"[runner] manage done FAILED (exit {result.returncode}): {stderr_text}", file=sys.stderr)
            print(f"[runner] exit 1 (manage done rejected)", file=sys.stderr)
            sys.exit(1)

    sys.exit(ret)


if __name__ == "__main__":
    main()
