# ── brief / prompt telemetry (T520, 2026-08-20) ────────────────────────
#
# F8: 16/25 heals were exit-124 wall-kills — briefs too big for their wall.
# The epidemic was anecdotal because nothing recorded the brief's size at
# dispatch.  The runner is the dispatch-time process: it sees the prompt
# the worker ingests (the `-p` argument) and, given a task identity, the
# bundle file the brief came from.  Recording both in the run record makes
# every wall-kill joinable to the brief that caused it.  See
# tools/dispatch_verify.py (WALL_GUIDANCE / wall_advisory) for the
# per-task-class recommendation that turns the measurement into guidance.

def _prompt_bytes(argv):
    """Byte length of the prompt argument the worker ingests, or None.

    All three dispatch providers (deepseek/ollama/claude) pass the brief to
    the worker as `-p <prompt>` (see bin/subagent's command builders).  The
    prompt is what the model reads and what drives wall time, so its byte
    length is the dispatch-time signal for the wall-kill epidemic.  The
    first `-p` wins; every dispatch command carries exactly one.
    """
    for i, a in enumerate(argv):
        if a == "-p" and i + 1 < len(argv):
            try:
                return len(argv[i + 1].encode("utf-8", "surrogatepass"))
            except Exception:
                return None
    return None


def _bundle_bytes(task_identity, repo_root):
    """Byte size of the brief bundle for `task_identity`, or None.

    `task_identity` is a T-id (e.g. T520); the bundle is the single
    `untracked/T<id>-*.md`.  None when identity is not a T-id, when zero or
    several bundles match, or when the file is unreadable — the literal
    brief is then unmeasurable from the runner, but `prompt_bytes` still
    records what the model ingested (prompt = wrapper + brief + nonce).
    """
    if not repo_root or not task_identity:
        return None
    if not re.fullmatch(r"T\d+", task_identity):
        return None
    hits = glob.glob(os.path.join(repo_root, "untracked", task_identity + "-*.md"))
    if len(hits) != 1:
        return None
    try:
        return os.path.getsize(hits[0])
    except OSError:
        return None


# ── helpers ──────────────────────────────────────────────────────────

def _parse_cputime(s):
    """Parse a ps-style CPU time string to total seconds (float).

    Accepts formats (all three from macOS / Linux `ps`):
      [[hh:]mm:]ss          (Linux, whole seconds)
      [[hh:]mm:]ss.cc       (macOS, centiseconds suffix)
      [dd-]hh:mm:ss[.cc]    (days-hours:minutes:seconds[.centiseconds])
      0                     (single digit, edge case)
    """
    s = s.strip()
    if not s:
        return 0.0
    # Days prefix: "dd-hh:mm:ss" or "dd-hh:mm:ss.cc"
    if '-' in s:
        days_part, rest = s.split('-', 1)
        try:
            days = int(days_part)
        except ValueError:
            return 0.0
        return days * 86400 + _parse_hms(rest)
    # [[hh:]mm:]ss or [[hh:]mm:]ss.cc
    return _parse_hms(s)


def _parse_hms(s):
    """Parse [[hh:]mm:]ss[.cc] to float seconds."""
    parts = s.split(':') if ':' in s else ['0', s]
    try:
        if len(parts) == 3:
            h, m, rest = parts
            secs = float(rest) if '.' in rest else int(rest)
            return int(h) * 3600 + int(m) * 60 + secs
        if len(parts) == 2:
            m, rest = parts
            secs = float(rest) if '.' in rest else int(rest)
            return int(m) * 60 + secs
        if len(parts) == 1:
            return float(parts[0]) if '.' in parts[0] else int(parts[0])
    except ValueError:
        return 0.0
    return 0.0


def _format_duration(secs):
    """Format seconds per the operator rule (2026-08-19): a duration never
    contains a colon. >= 3600 s -> NhMM (e.g. 4h28); 60-3599 s -> N'SS
    (e.g. 19'48); < 60 s -> SSs (e.g. 48s) or SS.cc bare when fractional."""
    secs = float(secs)
    if secs < 60:
        if secs == int(secs):
            return f"{int(secs)}s"
        return f"{secs:.2f}"
    if secs < 3600:
        m, s = divmod(int(secs), 60)
        return f"{m}'{s:02d}"
    h, r = divmod(int(secs), 3600)
    return f"{h}h{r // 60:02d}"


def _cpu_time_seconds(pid):
    """Return cumulative CPU time in seconds for `pid`, or None.

    Uses the `time` column (total CPU = user + system) from `ps`.
    On macOS the format is [[hh:]mm:]ss.cc; on Linux [[hh:]mm:]ss.
    """
    try:
        out = subprocess.run(
            ["ps", "-o", "time=", "-p", str(pid)],
            capture_output=True, text=True, timeout=0.5,
        )
        if out.returncode == 0 and out.stdout.strip():
            return _parse_cputime(out.stdout.strip())
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


# ── repo root (git rev-parse first, walk-up fallback) ───────────────────────

def _find_repo_root():
    """Resolve the repo root, worktree-aware (T449).

    A git WORKTREE's `.git` is a FILE carrying a `gitdir:` pointer, not a
    directory, so the isdir-only walk-up could not see a worktree root and
    walked to the filesystem root, returning None — silently killing
    heartbeats, directive reads, and the auto-claim path for any runner
    launched from a worktree (the T447 race ran five lanes with no
    heartbeats, 2026-08-18).  Prefer git's own answer: `git rev-parse
    --show-toplevel` accepts both the normal `.git` directory and the
    worktree `.git` file (T376 fixed the identical defect in
    tools/bakeoff.sh).  Do NOT simply add os.path.isfile: a `.git` file's
    `gitdir:` may point outside the tree, and the git command already
    answers correctly for both forms.

    The walk-up remains only as the fallback for a non-git directory — the
    runner is a general-purpose command wrapper that must keep working
    outside any repository (heartbeat/directive features are then inert,
    exactly as before the fix).
    """
    try:
        proc = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            timeout=2.0,
        )
        if proc.returncode == 0:
            root = proc.stdout.strip()
            if root:
                return root
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    # Not inside a git repository (or no git on PATH): walk up for a
    # `.git` DIRECTORY, the normal-checkout form.
    current = os.getcwd()
    while True:
        if os.path.isdir(os.path.join(current, ".git")):
            return current
        parent = os.path.dirname(current)
        if parent == current:
            return None
        current = parent


# ── directive checking (WORKER-CHANNEL) ────────────────────────────────────

def _check_directives(task_id, repo_root, verbose=True):
    """Check for pending directives addressed to `task_id`, EVALUATED at
    apply time.

    Reads docs/infra/managent/directives.jsonl and the kanban store, and
    applies the T625 discharge/staleness policy (directive_policy): a
    `pause` with `until_done=<row>` is enforced only while <row> is not
    `done`; an unacked `pause` without a condition older than the staleness
    horizon is reported stale, not enforced.  `kill` is always enforced.

    With verbose=True (launch-time use) prints every pending directive on
    stderr with its verdict (ENFORCED / DISCHARGED / STALE / ACKED / other).
    Returns the list of ENFORCED STOP directives (pause/kill) — empty when
    none; the caller exits 124 when it is non-empty.

    T370 (2026-08-06): the mid-run poll calls this with verbose=False so
    an unread `amend`/`question` does not spam stderr every poll — stop
    directives are the only ones the runner acts on mid-run.

    T625: unacked means UNKNOWN, not "still in force" — an unread pause is
    evaluated, and a discharged or stale one must NOT stop the run.
    """
    if not repo_root or not task_id:
        return []

    enforced, not_enforced = directive_policy.evaluate_directives(task_id, repo_root)
    stops = [d for d, _ in enforced]

    if verbose and (enforced or not_enforced):
        print("[runner] === pending directives ===", file=sys.stderr)
        for d, reason in not_enforced:
            directive = d.get("directive", "?")
            from_who = d.get("from", "?")
            print(f"[runner]   {directive.upper()}  from {from_who}  — NOT ENFORCED ({reason})", file=sys.stderr)
            note = d.get("note", "")
            if note:
                print(f"[runner]     {note}", file=sys.stderr)
        for d, reason in enforced:
            directive = d.get("directive", "?")
            from_who = d.get("from", "?")
            print(f"[runner]   {directive.upper()}  from {from_who}  — ENFORCED ({reason})", file=sys.stderr)
            note = d.get("note", "")
            if note:
                print(f"[runner]     {note}", file=sys.stderr)

    return stops


# ── run records (T364, 2026-08-20) — parent-side exit evidence ──────────────
#
# A SIGKILLed runner cannot write its own exit heartbeat — on 2026-08-04 the
# Orchestrator's load-16 sweep killed every process above 50% CPU with
# `kill -9`, and T355/T356 ended with NO exit beat at all (wall 5.5s, launch
# only).  `managent liveness` cannot tell "never started" from "killed
# mid-flight" from heartbeats alone.
#
# The run record fixes the structural gap: the PARENT records the child's
# fate, not the child.  The runner writes untracked/runs/<task>.json at
# LAUNCH (pid, pgid, start, command, launcher_pid) and REWRITES it at exit
# with the child's outcome (exit status OR signal, wall, peak RSS, kill
# reason).  Two failure classes, both readable afterwards:
#   - kill -9 of the CHILD: the runner survives and writes a COMPLETED
#     record (exit/signal fields present) — evidence exists despite the
#     SIGKILL;
#   - kill -9 of the RUNNER itself: the launch record remains with NO exit
#     fields — the next `managent reap` / `resume` reads "killed mid-flight".
#
# `managent reap` keys the row to the record's "task" field and checks the
# record's "pid" (the runner's own pid) against the process table: alive
# runner = backed row (never reap an idle-but-alive worker — stalled is the
# progress watchdog's job); dead runner = orphan, with the record's fields
# as the evidence for the abandoned note.
#
# ── T650 (2026-08-22): run records are NEVER overwritten ─────────────────
# A re-dispatch of the same task used to REWRITE untracked/runs/<task>.json,
# destroying the previous attempt's evidence: its wall, its exit, its kill
# reason, its tokens, its session.  On 2026-08-22 the run records for T615,
# T621 and T622 no longer described the kills — the re-runs had replaced
# them, and the kills survived only in dispatch-heals.jsonl and the .log
# files.  Ruling 32 (2026-08-22) requires guard-killed rows to be PRESENT
# and labeled censored — never dropped.  An overwritten killed attempt is a
# dropped one, silently, by the mechanism that should preserve it.
#
# The fix: the bare untracked/runs/<task>.json ALWAYS holds the LATEST
# attempt; when a new attempt starts, the previous bare record is renamed
# (atomic os.replace, never a copy — a copy would double-count in the AC7
# census, which iterates every file) to untracked/runs/<task>.<N>.json where
# N is the attempt number it carried.  Each record therefore exists exactly
# once, every attempt is a file, and the bare path keeps meaning "the
# current record" for every existing reader (dispatch_verify,
# attribution-backfill, managent reap/resume, the AC7 wall-kill census, the
# regressions).  A reader that globs ALL files now sees every attempt.
#
# Attempt numbering is "from the existing count": the first dispatch of a
# task writes the bare record only (attempt 1 — a single-attempt row is
# byte-identical to pre-T650), the second dispatch archives that record to
# <task>.1.json and writes the bare as attempt 2, and so on.  Every record
# carries its own "attempt" field so attempts are distinguishable at a
# glance without trusting filenames.  Historical records are NEVER
# migrated or back-filled (a back-filled record is a fabricated one).
#
# p95 / percentile computations over run records (T634, T643, and any
# future derivation) count COMPLETED attempts ONLY — a record with an
# exit/end and NO killed/killed_by/signal.  A killed attempt's wall is
# censored (Ruling 32), not a sample of how long the work takes.

# ── T629 (2026-08-22): killed_by — the enumerated guard-kill vocabulary ──
# The verification record (the dispatch-verify ledger line) carries one
# enumerated killed_by value, written from the RUNNER'S OWN terminal record
# — the runner is the only process that knows which guard fired, so it
# stamps the enum on every kill path.  dispatch_verify reads it; every
# scorer refuses a row with killed_by != none (Ruling 32: present, labeled
# censored, never scored).  T634's coordinate: liveness kills already carry
# kill_class=liveness; killed_by is the same vocabulary, stamped as the
# enum on every kill path (launch refusal, mid-run poll, the guard loop,
# and the runner-exception path).  Mirror of
# dispatch_verify.KILLED_BY_VALUES.


def _killed_by(kill_reason):
    """Map a guard kill reason string to the T629 killed_by enum, or None
    when the reason is not a guard kill (the caller guards)."""
    if not kill_reason:
        return None
    kl = kill_reason.lower()
    if kl.startswith("directive"):
        return "directive"
    if "liveness" in kl:
        return "liveness"
    if "progress timeout" in kl:
        return "watchdog"
    if "wall ceiling" in kl:
        return "wall"
    if "cpu ceiling" in kl:
        return "cpu"
    if "rss cap" in kl or "host memory pressure" in kl:
        return "rss"
    return "harness-error"


def _sanitize_identity(task_identity):
    """Map a task identity to a filesystem-safe filename segment.

    Task identities may carry '/' (e.g. DSPro/2B-5, runner/<pid>); the run
    record path must be a single file, so every character outside the safe
    set becomes '_'.  reap matches on the record's stored "task" field, not
    the filename, so the mangling is cosmetic only.
    """
    return "".join(ch if (ch.isalnum() or ch in "._-") else "_" for ch in task_identity)


def _run_record_path(task_identity, repo_root):
    return os.path.join(repo_root, "untracked", "runs", _sanitize_identity(task_identity) + ".json")


def _model_from_argv(argv):
    """The model label from the dispatch command's --model flag, or None.

    Every run record carries an explicit `model` field (T650) so attempts
    are distinguishable at a glance; the label is the literal --model value
    the dispatcher launched with, parsed here once at launch.  The full
    dispatch remains in `command`."""
    for i, a in enumerate(argv):
        if a == "--model" and i + 1 < len(argv):
            return argv[i + 1]
    return None


_ATTEMPT_FILE_RX = None  # compiled lazily below (needs re, imported above)


def _begin_attempt(task_identity, repo_root):
    """Archive the previous attempt's record (if any) and return the new
    attempt number (T650 — run records are never overwritten).

    The bare untracked/runs/<task>.json always holds the LATEST attempt;
    when a new attempt starts, the previous bare record is atomically
    renamed to untracked/runs/<task>.<N>.json where N is the attempt number
    it carried, and the new record takes the bare path.  Attempt numbering
    is "from the existing count": first dispatch of a task is attempt 1
    (bare only), the Nth dispatch is attempt N.  Returns 1 when no record
    can be written (degraded mode) — callers no-op on a falsy record_root
    anyway."""
    global _ATTEMPT_FILE_RX
    if not repo_root or not task_identity:
        return 1
    ident = _sanitize_identity(task_identity)
    runs_dir = os.path.join(repo_root, "untracked", "runs")
    try:
        os.makedirs(runs_dir, exist_ok=True)
    except OSError:
        return 1
    if _ATTEMPT_FILE_RX is None:
        _ATTEMPT_FILE_RX = re.compile(r"^" + re.escape(ident) + r"\.(\d+)\.json$")
    numbered = set()
    try:
        for fn in os.listdir(runs_dir):
            m = _ATTEMPT_FILE_RX.match(fn)
            if m:
                numbered.add(int(m.group(1)))
    except OSError:
        pass
    max_num = max(numbered) if numbered else 0
    bare = os.path.join(runs_dir, ident + ".json")
    if os.path.isfile(bare):
        # The bare holds the most recent attempt: max_num + 1.  Rename it to
        # its own attempt slot, atomically — never a copy, so the AC7 census
        # (which iterates every file) counts each attempt exactly once.
        archive = os.path.join(runs_dir, "%s.%d.json" % (ident, max_num + 1))
        try:
            os.replace(bare, archive)
        except OSError:
            pass
        return max_num + 2
    return max_num + 1


def _write_run_record(record, repo_root):
    """Atomically write a run record (tmp + rename).

    Torn writes matter here: the record is exactly the evidence that
    survives a SIGKILL, so a half-written record must never be what a
    reader sees.  tmp + os.replace keeps the visible file either the old
    version or the complete new one.
    """
    if not repo_root:
        return
    path = _run_record_path(record.get("task", "unknown"), repo_root)
    tmp = path + ".tmp"
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(tmp, "w") as f:
            json.dump(record, f, sort_keys=True)
            f.write("\n")
        os.replace(tmp, path)
    except OSError:
        try:
            if os.path.exists(tmp):
                os.unlink(tmp)
        except OSError:
            pass


def _finalize_run_record(run_record, repo_root, ret=None, signum=None, wall=None, cpu=None, rss_mb=None, killed=None, tokens=None, reap_claimed=None, reap_survivors=None, reap_ok=None, reap_unknown_partial=None):
    """Stamp the child's outcome onto the in-memory launch record and persist.

    ret is the child's exit code; signum is the signal that killed the child
    (subprocess reports killed-by-signal as a negative returncode, so the
    caller passes signum explicitly on the kill paths).  Either may be None:
    a record with neither is a launch record whose runner died before the
    child's fate was known — "killed mid-flight", not "completed".

    tokens (T521) is the capture dict {tokens_in, tokens_out, tokens_fresh,
    tokens_cache_read, source, missing_reason, session_id, session_reason}
    or None.  When provided the record carries the token fields ALWAYS —
    nulls included — so a run record is self-describing: "no reading" is
    visible in the record itself, never a missing key.  T552: the same
    applies to the session handle (session_id / session_reason always
    present).  T558: tokens_fresh / tokens_cache_read are the split behind
    tokens_in (which keeps its meaning, input+cache_read); all three are
    stamped together.
    """
    if run_record is None:
        return
    run_record["end"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    if ret is not None:
        run_record["exit"] = ret
    if signum is not None:
        run_record["signal"] = signum
    if wall is not None:
        run_record["wall"] = round(wall, 1)
    if cpu is not None:
        run_record["cpu"] = round(cpu, 1)
    if rss_mb is not None:
        run_record["rss_mb"] = round(rss_mb, 1)
    if killed is not None:
        run_record["killed"] = killed
    if tokens is not None:
        run_record["tokens_in"] = tokens.get("tokens_in")
        run_record["tokens_out"] = tokens.get("tokens_out")
        # T558: the split behind tokens_in — fresh (input) vs cache_read —
        # stamped ALWAYS (nulls included) so a reader can price the two
        # differently without re-deriving from the raw usage.
        run_record["tokens_fresh"] = tokens.get("tokens_fresh")
        run_record["tokens_cache_read"] = tokens.get("tokens_cache_read")
        run_record["tokens_source"] = tokens.get("source")
        run_record["tokens_missing_reason"] = tokens.get("missing_reason")
        # T552: the resumable session handle, stamped ALWAYS (nulls
        # included) so the record is self-describing about the handle too.
        run_record["session_id"] = tokens.get("session_id")
        run_record["session_reason"] = tokens.get("session_reason")
        # T662: the pi lane's session file path (the meter read from it, or
        # the path that was expected but missing) — stamped ALWAYS so a
        # reader can audit which file a reading came from, or see that a
        # path was named but the file never appeared.
        run_record["session_path"] = tokens.get("session_path")
        run_record["session_path_reason"] = tokens.get("session_path_reason")
        # D044: the deepseek peak/off-peak band at write time (others: null
        # + a reason naming the family's pricing unit) — every token record
        # carries when it happened, so a later reader never re-derives the
        # calendar rule from a bare count.
        run_record["rate_band"] = tokens.get("rate_band")
        run_record["rate_band_reason"] = tokens.get("rate_band_reason")
    if reap_claimed is not None:
        run_record["reap_claimed"] = reap_claimed
    if reap_survivors is not None:
        run_record["reap_survivors"] = reap_survivors
    if reap_ok is not None:
        run_record["reap_ok"] = reap_ok
    if reap_unknown_partial is not None:
        # B-1: a reap whose seed list was empty is unknown-partial — the
        # marker lets the ledger distinguish a blind-spot reap (marker true)
        # from a genuinely clean one (field absent; readers .get, the C6
        # convention for old records).
        run_record["reap_unknown_partial"] = reap_unknown_partial
    _write_run_record(run_record, repo_root)


# ── heartbeat emission (WORKER-CHANNEL) ────────────────────────────────────

def _emit_heartbeat(task_id, command, wall, cpu, rss_mb, repo_root,
                   tokens_in=None, tokens_out=None):
    """Append a heartbeat line to untracked/heartbeat.jsonl.

    The heartbeat records the runner invocation so `managent liveness`
    can report per-task liveness.  T521: the EXIT beats carry the token
    reading (tokens_in/tokens_out) so the heartbeat file is another
    mechanical per-task token surface (the bakeoff finalize already names
    trailer.log and heartbeat.jsonl as sources).
    """
    if not repo_root:
        return

    hb_dir = os.path.join(repo_root, "untracked")
    os.makedirs(hb_dir, exist_ok=True)
    hb_path = os.path.join(hb_dir, "heartbeat.jsonl")

    ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    record = {
        "identifier": task_id or "unknown/unknown",
        "task": task_id or "unknown",
        "ts": ts,
        "command": command or "",
        "wall": round(wall, 1) if wall >= 0 else None,
        "cpu": round(cpu, 1) if cpu >= 0 else None,
        "rss_mb": round(rss_mb, 1) if rss_mb >= 0 else None,
    }
    if tokens_in is not None:
        record["tokens_in"] = tokens_in
        record["tokens_out"] = tokens_out
    # Strip None values for brevity
    record = {k: v for k, v in record.items() if v is not None}

    try:
        with open(hb_path, "a") as f:
            f.write(json.dumps(record, sort_keys=True) + "\n")
    except OSError:
        pass


def prepend_releasefast(argv):
    """Auto-add an optimize flag for `zig` invocations if missing.

    The 2026-07-29 host panic was caused by `zig build-exe` running in Debug
    (LLVM path is the memory hog). The fix: ensure every zig invocation in
    the runner has an explicit -O / -Doptimize, defaulting to ReleaseFast.

      zig build / build install   -> -Doptimize=ReleaseFast (project option)
      zig build-exe / build-lib / build-obj / test / run / install
                                   -> -O ReleaseFast (command-level option)

    T311 (2026-08-03): fix optimize-flag detection.  The old check
    ``"-Doptimize" in argv`` uses exact token equality, which never matches
    ``-Doptimize=ReleaseSafe`` (a single token with an embedded '=').
    Now detects any argv element that *starts with* ``-Doptimize``, so a
    caller who explicitly asks for ReleaseSafe or Debug gets it.
    """
    if not argv:
        return argv
    if Path(argv[0]).name != "zig":
        return argv
    # Detect any existing optimize flag — an argv element that starts
    # with -Doptimize (e.g. -Doptimize=ReleaseSafe) or is exactly -O.
    # Exact token equality (the old check) fails for -Doptimize=<mode>
    # because the token never equals the bare string "-Doptimize".
    has_optimize = any(
        arg == "-O" or arg.startswith("-Doptimize")
        for arg in argv
    )
    if has_optimize:
        return argv
    if len(argv) < 2:
        return argv
    sub = argv[1]
    if sub in ("build",):
        return [argv[0], sub, "-Doptimize=ReleaseFast", *argv[2:]]
    if sub in ("build-exe", "build-lib", "build-obj", "test", "run", "install"):
        return [argv[0], sub, "-O", "ReleaseFast", *argv[2:]]
    return argv


# ── sweep (standalone) ───────────────────────────────────────────────

def sweep():
    """List top CPU consumers on the host (finding orphan zig processes).

    Orphaned `zig test` / `zig build-exe` binaries compile to anonymous
    paths under .zig-cache/ and are invisible to name-based greps.  This
    mode lists every process by cumulative CPU time, so the human or a
    follow-up agent can identify spinners.
    """
    print("[runner] === SWEEP: top processes by CPU time ===", file=sys.stderr)
    try:
        out = subprocess.run(
            ["ps", "-axo", "pid=,etime=,cputime=,command="],
            capture_output=True, text=True, timeout=5.0,
        )
    except FileNotFoundError:
        print("[runner] SWEEP failed: `ps` not found", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print("[runner] SWEEP failed: `ps` timed out", file=sys.stderr)
        sys.exit(1)

    lines = out.stdout.splitlines()
    if not lines:
        print("[runner] SWEEP: no processes", file=sys.stderr)
        sys.exit(0)

    def sort_key(line):
        # cputime is the third whitespace-delimited column after pid, etime
        parts = line.split(None, 3)
        if len(parts) >= 3:
            return _parse_cputime(parts[2])
        return 0

    data = sorted(lines, key=sort_key, reverse=True)
    header = data[0] if data else ""
    body = data[1:] if len(data) > 1 else []
    n_show = min(20, len(body))

    print(f"  PID  ELAPSED    CPU        COMMAND", file=sys.stderr)
    print(f"  ---  --------   --------   -------", file=sys.stderr)
    for line in body[:n_show]:
        parts = line.split(None, 3)
        if len(parts) >= 4:
            pid, etime, cputime, cmd = parts
            el = _format_duration(_parse_cputime(etime))
            ct = _format_duration(_parse_cputime(cputime))
            print(f"  {pid:<5s} {el:<10s} {ct:<10s} {cmd}", file=sys.stderr)
        else:
            print(f"  {line}", file=sys.stderr)
    print(f"[runner] === {len(body)} processes total, showing top {n_show} ===", file=sys.stderr)
    sys.exit(0)


# ── orphan sweeper (T548, 2026-08-22) ──────────────────────────────────
# The runner reaps its OWN descendant tree on every exit path (C1/C2/C3,
# via `managent treekill`), but a SIGKILLed/crashed runner cannot reap —
# its suite children survive reparented to init and hold multi-GB RSS.
# The fleet measured the leak continuously (2026-08-20: 9.1 GB at free
# 0.06 GB, then 2.8 GB again while memory was HEALTHY), so the sweeper is
# the primary backstop: a standalone host-level command, timer/keeper-
# friendly, that finds abandoned suite binaries and kills them.
#
# Conservatism — a reaper that kills live work is far worse than the
# leak — is three guards plus one hardening earned on this host:
#   (a) match ONLY `.zig-cache/o/<hash>/test` suite binaries (the
#       multi-GB memory holders; never the small zig compilers/daemons);
#   (b) walk the live ancestry and skip anything whose chain contains a
#       worker marker (`subagent` / `claude -p` / `runner` /
#       `fleet-keeper`, the brief's guard list) OR any live non-zig
#       session ancestor (console, terminal, interactive shell).  Only
#       chains that reach init (pid 1) through zig-build processes and
#       dead pids are orphans.  The live-session half is the hardening:
#       on 2026-08-22 three live suite binaries on this host had NO
#       worker marker in their chain (a `nohup zig build test` under
#       ppid 1, and a `pi` console chain) — the literal guard set would
#       have reaped live work;
#   (c) two-pass guard: a candidate must be seen orphaned on two runs at
#       least --orphan-pass-min apart (default 45 s), so a freshly
#       spawned test whose parent link is not yet visible is never hit.
# Every reap is logged with pid, RSS and the reason (stderr + the orphan
# log, default /tmp/weizigo/orphan-reap.log — silent process killing is
# unauditable, and today's whole problem was infrastructure deaths being
# invisible).  --orphan-dry-run reports without killing.

ORPHAN_GUARD_PATTERNS = ("subagent", "claude -p", "runner", "fleet-keeper")
ORPHAN_STATE_DEFAULT = "/tmp/weizigo/runner-orphan-sweep.json"
ORPHAN_LOG_DEFAULT = "/tmp/weizigo/orphan-reap.log"
ORPHAN_TEST_RE = re.compile(r"\.zig-cache/o/[^/\s]+/test(?:\s|$)")
ORPHAN_MAX_DEPTH = 64


def _ps_proc_table():
    """Snapshot pid -> {ppid, rss_kb, state, start, cmd} for every process.

    One `ps -axo pid=,ppid=,rss=,state=,lstart=,command=` call (both macOS
    and Linux support all six columns; lstart is the absolute start time,
    the identity anchor against pid reuse).  The command is the full argv
    re-joined after the fixed columns — commands containing spaces survive.
    Zombies are dropped (they are already dead; a kill is a no-op).
    Returns {} on any failure (the caller treats that as fatal).
    """
    try:
        out = subprocess.run(
            ["ps", "-axo", "pid=,ppid=,rss=,state=,lstart=,command="],
            capture_output=True, text=True, timeout=5.0,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return {}
    if out.returncode != 0:
        return {}
    rows = {}
    for line in out.stdout.splitlines():
        toks = line.split()
        # pid ppid rss state Mon Aug 22 09:00:23 2026 <command...>
        if len(toks) < 10:
            continue
        try:
            pid = int(toks[0])
            ppid = int(toks[1])
            rss_kb = int(toks[2])
        except ValueError:
            continue
        if toks[3].startswith("Z"):
            continue  # zombies are already dead — never claimed
        rows[pid] = {
            "ppid": ppid,
            "rss_kb": rss_kb,
            "start": " ".join(toks[4:9]),  # lstart: "Mon Aug 22 09:00:23 2026"
            "cmd": " ".join(toks[9:]),
        }
    return rows


def _is_zig_tree_cmd(cmd):
    """True when the process is part of a zig build tree: a zig compiler /
    daemon / test binary, or the launcher shell that invoked zig (its
    command carries `zig build` / `zig test` / the cache path).

    Deliberately broad: a live session ancestor reached THROUGH a zig
    launcher still protects the candidate (the walk continues past zig
    processes and skips at the session), so over-classifying zig-ness is
    always the safe direction — it can only ADD an ancestor to walk
    through, never a candidate to kill.
    """
    if not cmd:
        return False
    first = cmd.split()[0]
    return (
        os.path.basename(first) == "zig"
        or ".zig-cache" in cmd
        or "zig build" in cmd
        or "zig test" in cmd
    )


def _classify_suite_orphan(pid, rows):
    """Walk the LIVE ancestry of a `.zig-cache/o/*/test` candidate.

    Returns ("orphan", reason) when the chain reaches init (pid 1) through
    only zig-build-tree processes (the seat's DARGUS criterion: "ancestry
    ending at init, with no live worker in the chain"), or ("skip",
    reason) when a worker marker or a live session ancestor is found, or
    when the walk dead-ends at a pid missing from the table (a transient
    ps/reparent race — the two-pass guard resolves it on the next run).
    Skipping is always the safe direction: a false negative costs memory,
    a false positive kills live work.
    """
    cur = pid
    depth = 0
    while True:
        row = rows.get(cur)
        if row is None:
            return ("skip", f"ancestor pid {cur} not in table (transient?)")
        if cur == 1:
            return ("orphan", "ancestry ends at init through zig build tree")
        cmd = row["cmd"]
        if any(g in cmd for g in ORPHAN_GUARD_PATTERNS):
            return ("skip", f"worker marker in ancestry (pid {cur}: {cmd[:60]!r})")
        if not _is_zig_tree_cmd(cmd):
            return ("skip", f"live session ancestor (pid {cur}: {cmd[:60]!r})")
        nxt = row["ppid"]
        if nxt == cur or nxt <= 0:
            return ("skip", f"broken ppid chain at pid {cur}")
        cur = nxt
        depth += 1
        if depth > ORPHAN_MAX_DEPTH:
            return ("skip", "ancestry depth cap exceeded")


def _load_orphan_state(path):
    """Read the two-pass state file {pid: {first_seen, start}}, or {}."""
    if not path or not os.path.isfile(path):
        return {}
    try:
        with open(path) as f:
            state = json.load(f)
        return state if isinstance(state, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def _save_orphan_state(path, state):
    """Atomically write the two-pass state (tmp + rename — a torn state
    file would reset the guard and could double-reap)."""
    if not path:
        return
    tmp = path + ".tmp"
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(tmp, "w") as f:
            json.dump(state, f, sort_keys=True)
            f.write("\n")
        os.replace(tmp, path)
    except OSError:
        try:
            if os.path.exists(tmp):
                os.unlink(tmp)
        except OSError:
            pass


def _append_orphan_log(path, line):
    """Append one reap line to the audit log (best-effort)."""
    if not path:
        return
    try:
        with open(path, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def reap_orphans(state_file=ORPHAN_STATE_DEFAULT, pass_min=45.0,
                 dry_run=False, log_file=ORPHAN_LOG_DEFAULT):
    """One pass of the suite-orphan sweeper (T548).

    Finds `.zig-cache/o/<hash>/test` binaries whose live ancestry contains
    no worker marker and no live session (i.e. the chain reaches init), and
    SIGKILLs those seen orphaned on a previous pass at least `pass_min`
    seconds ago.  Emits one parseable summary line on stdout (data —
    `orphan-sweep: candidates=N reaped=M tracked=K ...`) and per-process
    diagnostics on stderr.  Exit 0 always: a sweep is report + reap, never
    a gate.  Never kills pid <= 1, itself, or its parent (defensive — the
    matcher makes self-kill impossible anyway: the sweeper's own command
    is never a `.zig-cache/o/*/test` binary).
    """
    rows = _ps_proc_table()
    if not rows:
        print("[runner] orphan-sweep: FATAL — process table unreadable (ps failed)", file=sys.stderr)
        sys.exit(1)
    self_pid = os.getpid()
    parent_pid = os.getppid()
    candidates = []  # (pid, row, reason)
    for pid, row in rows.items():
        if pid <= 1 or pid == self_pid or pid == parent_pid:
            continue
        if ORPHAN_TEST_RE.search(row["cmd"]):
            verdict, reason = _classify_suite_orphan(pid, rows)
            if verdict == "orphan":
                candidates.append((pid, row, reason))

    state = _load_orphan_state(state_file)
    now = time.time()
    due = []  # (pid, row, reason, age) — reap these
    new_state = {}
    for pid, row, reason in candidates:
        key = str(pid)
        prior = state.get(key)
        start = row["start"]
        if isinstance(prior, dict) and prior.get("start") == start:
            first_seen = float(prior.get("first_seen", now))
            age = now - first_seen
            if age >= pass_min:
                due.append((pid, row, reason, age))
                continue  # reaped (or due) — do not carry into new_state
            new_state[key] = {"first_seen": first_seen, "start": start}
        else:
            # pass 1 for this pid (or pid reuse — lstart differs)
            new_state[key] = {"first_seen": now, "start": start}
            rss_mb = row["rss_kb"] // 1024
            print(f"[runner] orphan-sweep: track pid {pid} RSS {rss_mb} MB "
                  f"(pass 1; will reap on a second orphaned pass >= {pass_min:.0f}s)",
                  file=sys.stderr)

    _save_orphan_state(state_file, new_state)

    reaped = 0
    for pid, row, reason, age in due:
        rss_mb = row["rss_kb"] // 1024
        why = f"abandoned zig suite binary (pid {pid} RSS {rss_mb} MB, " \
              f"orphaned {age:.0f}s; {reason})"
        if dry_run:
            print(f"[runner] orphan-sweep: WOULD REAP {why}", file=sys.stderr)
            continue
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            print(f"[runner] orphan-sweep: pid {pid} vanished before reap (race, OK)", file=sys.stderr)
            continue
        except PermissionError:
            print(f"[runner] orphan-sweep: pid {pid} REFUSED (permission — not ours)", file=sys.stderr)
            continue
        line = (f"orphan-reap ts={time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} "
                f"pid={pid} rss_mb={rss_mb} age_s={age:.0f} reason={reason}")
        print(f"[runner] orphan-sweep: REAP {why}", file=sys.stderr)
        _append_orphan_log(log_file, line)
        reaped += 1

    mode = "dry-run" if dry_run else "kill"
    print(f"orphan-sweep: candidates={len(candidates)} reaped={reaped} "
          f"tracked={len(new_state)} mode={mode}")


# ── process tree walking ─────────────────────────────────────────────

def _descendant_pids_linux(root_pid):
    """Walk /proc and return root_pid + all descendants (Linux)."""
    pids = set()
    children = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        try:
            with open(f"/proc/{pid}/status") as f:
                ppid = None
                for line in f:
                    if line.startswith("PPid:"):
                        ppid = int(line.split()[1])
                        break
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
        if ppid is not None:
            children.setdefault(ppid, []).append(pid)
    # BFS from root_pid
    stack = [root_pid]
    while stack:
        pid = stack.pop()
        pids.add(pid)
        stack.extend(children.get(pid, []))
    return pids


def _descendant_pids_ps(root_pid):
    """Walk via `ps` and return root_pid + all descendants (macOS / BSD)."""
    out = subprocess.run(
        ["ps", "-axo", "pid=,ppid="], capture_output=True, text=True, timeout=2.0,
    )
    children = {}
    for line in out.stdout.splitlines():
        parts = line.split()
        if len(parts) != 2:
            continue
        try:
            pid, ppid = int(parts[0]), int(parts[1])
        except ValueError:
            continue
        children.setdefault(ppid, []).append(pid)
    pids = set()
    stack = [root_pid]
    while stack:
        pid = stack.pop()
        pids.add(pid)
        stack.extend(children.get(pid, []))
    return pids


# ── platform detection (once at import) ──────────────────────────────

def _detect_walker():
    """Detect platform process-tree walker once at startup.

    On Linux with /proc available, uses the fast /proc-based walker.
    On all other platforms (macOS, BSD, containers without /proc),
    falls back to `ps`.  Called once at module load; the result is
    stored in _WALKER_FN / _WALKER_NAME for the lifetime of the run.
    """
    if sys.platform == 'linux' and os.path.isdir('/proc'):
        return _descendant_pids_linux, 'linux /proc'
    return _descendant_pids_ps, 'ps'

_WALKER_FN, _WALKER_NAME = _detect_walker()


def _reap_tree(anchor, seed=(), since=None, protect=()):
    """Terminate the tree rooted at `anchor` via `managent treekill --kill`.

    Non-raising by contract (D-24): the runner must never die or mis-stamp a
    success because the reaper failed.  Every failure is logged to stderr as
    an unknown-partial leak incident and returned (never raised).  Returns a
    dict {"claimed", "survivors", "ok", "reason", "unknown_partial"} for the
    run record (C6).

    B-1 (critical, phase-7 audit): a reap whose seed list is empty/None is
    unknown-partial, NEVER clean — the child exited before the first poll
    walk, so the closure ran without the seed roots that name r4-class
    nested-session members and completeness is unattestable (01-spec.md §2
    caller-obligations).  The recorded verdict overrides the verb's own
    clean-looking exit 0 / survivors=0; the closure and kill logic are
    untouched.
    """
    result = {"claimed": None, "survivors": None, "ok": False, "reason": "not-run"}
    blind = not seed  # B-1: empty/None seed ⇒ completeness unattestable
    if anchor is None:
        result["reason"] = "no-anchor"
        return result

    # Resolve the binary from the runner's OWN location, never from cwd: the
    # runner's cwd is the dispatch directory (possibly a scratch repo, as in
    # the I1/I2 arms), so a cwd-relative lookup would miss the real binary.
    # MANAGENT_BIN wins when set.
    here = os.path.dirname(os.path.abspath(__file__))
    proj_root = os.path.dirname(here)
    mg = os.environ.get("MANAGENT_BIN")
    if not mg:
        for cand in (os.path.join(proj_root, "zig-out", "bin", "managent"),
                     os.path.join(proj_root, "bin", "managent")):
            if os.path.isfile(cand):
                mg = cand
                break
    if not mg:
        result["reason"] = "no-managent-binary"
        print("[runner] reap FAILED: no managent binary (unknown-partial leak incident)", file=sys.stderr)
        return result

    argv = [mg, "treekill", "--anchor", str(int(anchor)), "--kill",
            "--rounds", "5", "--settle-ms", "250"]
    if since is not None:
        argv += ["--since", str(int(since))]
    if seed:
        argv += ["--seed", ",".join(str(int(p)) for p in seed)]
    for p in protect:
        argv += ["--protect", str(int(p))]

    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        result["reason"] = "timeout"
        print("[runner] reap TIMEOUT after 30s (unknown-partial leak incident)", file=sys.stderr)
        return result
    except OSError as exc:
        result["reason"] = f"spawn-failed: {exc}"
        print(f"[runner] reap FAILED: {exc} (unknown-partial leak incident)", file=sys.stderr)
        return result

    claimed = None
    survivors = None
    summary = ""
    for line in (proc.stdout or "").splitlines():
        if line.startswith("treekill "):
            summary = line
            for field in line.split():
                if field.startswith("claimed="):
                    try:
                        claimed = int(field.split("=", 1)[1])
                    except ValueError:
                        pass
                elif field.startswith("survivors="):
                    try:
                        survivors = int(field.split("=", 1)[1])
                    except ValueError:
                        pass
    result["claimed"] = claimed
    result["survivors"] = survivors
    result["ok"] = (proc.returncode == 0 and (survivors or 0) == 0)
    if blind:
        # B-1: empty seed ⇒ unknown-partial, never clean.  The child exited
        # before the first poll walk, so the closure cannot attest
        # completeness; the verb's own exit-0/survivors=0 report is a blind
        # spot, not a clean reap, and must not be recorded as one.  Only the
        # recorded verdict and its diagnostic differ — closure/kill above
        # ran exactly as before.
        result["ok"] = False
        result["reason"] = "unknown-partial: empty seed"
        result["survivors"] = None          # unattestable — never a misleading 0
        result["unknown_partial"] = True    # C6 partial marker in the run record
        if proc.returncode == 0:
            print("[runner] reap UNKNOWN-PARTIAL: empty seed — completeness unattestable (blind-spot reap, B-1)", file=sys.stderr)
        else:
            err_tail = (proc.stderr or "").strip().splitlines()
            err_line = err_tail[-1] if err_tail else ""
            print(f"[runner] reap exit {proc.returncode}: {summary or '(no summary)'} {err_line} (unknown-partial leak incident)", file=sys.stderr)
    elif proc.returncode == 0:
        result["reason"] = "ok"
        if summary:
            print(f"[runner] reap: {summary}", file=sys.stderr)
    else:
        result["reason"] = f"exit {proc.returncode}"
        err_tail = (proc.stderr or "").strip().splitlines()
        err_line = err_tail[-1] if err_tail else ""
        print(f"[runner] reap exit {proc.returncode}: {summary or '(no summary)'} {err_line} (unknown-partial leak incident)", file=sys.stderr)
    return result


