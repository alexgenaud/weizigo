# ── main ─────────────────────────────────────────────────────────────

def _drain_stream(stream, deadline, chunk_size=65536):
    """Read available text from `stream` until EOF or `deadline`.

    `stream` is left non-blocking (the monitor loop's setting).  A leaked
    grandchild that INHERITED the runner's pipe keeps the write end open
    after the child exits (the T548 leak shape: `zig build`'s test
    binaries hold the build pipe), so EOF may never come — a blocking read
    would hang the runner forever, the C2 reap (which kills those very
    holders) would never run, and the leaked memory would be held
    indefinitely.  The deadline bounds the wait; the caller's exit-path
    reap then closes the pipe by killing the holder.  TextIO on a
    non-blocking fd raises BlockingIOError when no data is ready — loop
    on it with a short grace so a slow writer is not cut off early.
    """
    chunks = []
    while True:
        if time.monotonic() >= deadline:
            break
        try:
            chunk = stream.read(chunk_size)
        except BlockingIOError:
            time.sleep(0.02)
            continue
        except (ValueError, OSError):
            break
        if not chunk:
            break  # EOF — every writer closed the pipe
        chunks.append(chunk)
    return "".join(chunks)


def _drain_stderr(proc, progress_seen, last_progress_time, task_identity, command, repo_root):
    """Read any remaining stderr from the child after it exits.

    Forwards lines to the runner's stderr, checks for [progress] markers,
    and emits a heartbeat on each one found.  Returns the remaining text
    so the caller can accumulate it into the full-stream capture (T521).
    Time-bounded (T548): a leaked grandchild holding the pipe must not
    hang the normal-exit path — 2 s of grace, then the caller's C2 reap
    kills the holder and the runner exits.
    """
    remaining = ""
    try:
        remaining = _drain_stream(proc.stderr, time.monotonic() + 2.0)
        if remaining:
            for line in remaining.splitlines():
                print(line, file=sys.stderr)
                if '[progress]' in line:
                    _emit_heartbeat(task_identity, command, time.monotonic(), -1, -1, repo_root)
    except (ValueError, OSError):
        pass
    return remaining


def _drain_stdout(proc, forward):
    """Read any remaining stdout from the child after it exits.

    forward=False buffers only (a claude JSON lane — the envelope is
    unwrapped after parsing, never streamed raw).  Returns the remaining
    text for the full-stream capture.  Time-bounded (T548): see
    _drain_stderr — a leaked pipe-holding grandchild must not hang the
    normal-exit path.
    """
    remaining = ""
    try:
        remaining = _drain_stream(proc.stdout, time.monotonic() + 2.0)
        if remaining and forward:
            sys.stdout.write(remaining)
            sys.stdout.flush()
    except (ValueError, OSError):
        pass
    return remaining


# ── T521: mechanical token capture (the capture path, at dispatch time) ────
# G1 is run-time, not retroactive (D043): tokens are captured when the lane
# runs or they are lost.  The runner is the one process every lane passes
# through (bin/subagent dispatches, tools/bakeoff.sh races), so the capture
# lives here: parse the claude JSON envelope (text + usage), tee the raw
# stdout+stderr per task, append the per-run ledger record (a reading or an
# explicit missing-with-reason), stamp the run record and the trailer line.

def _load_token_capture():
    """Lazy-load tools/token-capture.py (a sibling module).

    Returns None when absent — the runner is a general-purpose wrapper and
    must keep working (without capture) in any tree that lacks the
    instrument.  Never raises on import failure: capture failing open is
    a missing record with a reason, not a crash.
    """
    try:
        import importlib.util
        here = os.path.dirname(os.path.abspath(__file__))
        path = os.path.join(here, "token-capture.py")
        if not os.path.isfile(path):
            return None
        spec = importlib.util.spec_from_file_location("token_capture", path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:
        return None


def _json_output_lane(argv):
    """True when the child command asks for a claude JSON usage envelope.

    Detection is by the flag pair (`--output-format json`), not the binary
    name, so any shim or future claude driver that emits the envelope is
    captured; a lane that does not opt in is teed but never parsed.
    """
    for i, a in enumerate(argv):
        if a == "--output-format" and i + 1 < len(argv) and argv[i + 1] == "json":
            return True
    return False


def _argv_model(argv):
    """The `--model` value in the child argv, or None."""
    for i, a in enumerate(argv):
        if a == "--model" and i + 1 < len(argv):
            return argv[i + 1]
    return None


def _argv_provider(argv):
    """The dispatch family: the `--provider` value, else the child basename."""
    for i, a in enumerate(argv):
        if a == "--provider" and i + 1 < len(argv):
            return argv[i + 1]
    if argv:
        return os.path.basename(argv[0]) or None
    return None


def _argv_session_path(argv):
    """The `--session <path>` value in the child argv (T662), or None.

    pi accepts `--session <path|id>`; the dispatch path (bin/subagent, and
    tools/bakeoff.sh for deepseek lanes since T558) passes a per-lane FILE
    path, so the runner can read the session JSONL after the child closes
    — the retroactive meter made knowable at dispatch.  Only the flag-pair
    form is matched (the same convention `_argv_model` uses); the value is
    resolved against the child's cwd, which is this process's cwd.
    """
    for i, a in enumerate(argv):
        if a == "--session" and i + 1 < len(argv):
            return argv[i + 1]
    return None


# ── T586: agent-lane detection (the startup-liveness scope) ─────────────────
#
# The nonce-stall failure mode was a dispatched pi/deepseek worker producing
# ZERO stdout/stderr for its whole run — its activity (reasoning, tool
# calls) goes only to ~/.pi/agent/sessions/<cwd-slug>/<uuid>.jsonl, never to
# the captured streams.  tools/runner saw a "silent child" and SIGKILLed at
# --max-wall, so a worker that WAS reading the bundle and working got killed
# mid-task and verify_dispatch mis-reported "nonce: the worker did not read
# the instruction bundle".
#
# The fix has two halves, both scoped to agent lanes (the dispatched model
# workers) so generic `zig build`-shaped runs keep their wall/CPU semantics:
#   1. stdout output from an agent lane counts as a liveness signal — a
#      streaming worker is never mis-classified "silent";
#   2. an agent lane that emits NOTHING within --startup-timeout of launch
#      is killed LOUDLY with a distinct reason — a 10-minute anomaly, not
#      a silent 45-minute burn.
#
# Detection is by the child binary's basename: pi (deepseek), claude, and
# ollama are the three dispatch providers bin/subagent launches.  The
# regression stubs (fake-pi) deliberately do NOT match so the token-capture
# and session-capture controls are untouched.
AGENT_LANE_BINARIES = ("pi", "claude", "ollama")


def _is_agent_lane(argv):
    """True when the wrapped child is a dispatched model worker (pi/claude/
    ollama), the only lanes the startup-liveness check and stdout-as-progress
    signal apply to.  A non-agent command (zig build, a test stub named
    fake-pi) returns False and keeps the silent-child wall/CPU semantics."""
    if not argv:
        return False
    return os.path.basename(argv[0]) in AGENT_LANE_BINARIES


def _is_claude_lane(argv):
    """True when the wrapped child is a headless `claude -p` session — the
    buffering harness (T634).  A claude lane is silent on stdout/stderr for
    its WHOLE run by design (its output is buffered to the end), so the
    stdout-as-liveness signal T586 earned for pi/ollama is the wrong sensor
    here: T616 had already written 43 KB and 33 adjudicated items when the
    600 s startup fuse killed it for being quiet.  Claude lanes get the
    mtime fuse instead."""
    if not argv:
        return False
    return os.path.basename(argv[0]) == "claude"


def _agent_family(argv):
    """The harness family of a dispatched agent lane — the child binary
    basename for pi/claude/ollama, else None (mirrors _run_family for live
    classification; kept separate so the live check never depends on the
    run-record classifier)."""
    if not argv:
        return None
    b = os.path.basename(argv[0])
    return b if b in AGENT_LANE_BINARIES else None


# ── T634: per-harness liveness (claude mtime fuse) ─────────────────────────
#
# The startup-liveness fuse (T586) keys on stdout and is correct for pi/
# ollama (streaming).  It is WRONG for claude: headless `claude -p` buffers
# its output to the end, so a claude lane is silent for its whole run and the
# 600 s fuse killed finished jobs (T616: 600.8 s, 43 KB already on disk, vs
# T615's 598.8 s pass — two seconds separated a pass from a failure).  The
# claude liveness sensor is mtime movement on what the harness actually emits
# while working:
#   - the declared deliverables (the bundle's deliverables= header), and
#   - the claude session transcript (~/.claude/projects/<cwd-slug>/), the
#     harness's per-lane scratch: every assistant turn and tool call appends
#     to the session .jsonl, so a working lane moves mtime continuously; a
#     hung lane's transcript stops moving.
# The shared repo tree is deliberately NOT a sensor: other consoles write to
# the same checkout, so a neighbour's edit would mark a hung lane "alive" —
# noise defeats the fuse.  The threshold is derived, not guessed (see the
# findings file): 3 x observed p95 of claude wall time (n=29, p95=1543.5 s)
# = 4631 s.
#
# WEIZIGO_CLAUDE_TRANSCRIPT_DIR overrides the transcript dir (the test hook
# that lets the regression drive a synthetic transcript without writing to
# ~/.claude — never invent/read the real session store to test the fuse).


def _project_slug(path):
    """Claude Code's on-disk project-directory slug for a working directory
    (mirrors tools/race-p0-verify.sh project_slug)."""
    return re.sub(r"[^A-Za-z0-9]", "-", os.path.abspath(path))


def _claude_transcript_dir(cwd):
    """The claude session transcript directory for `cwd`, overridable via
    WEIZIGO_CLAUDE_TRANSCRIPT_DIR (test hook)."""
    injected = os.environ.get("WEIZIGO_CLAUDE_TRANSCRIPT_DIR")
    if injected:
        return injected
    return os.path.join(os.path.expanduser("~"), ".claude", "projects", _project_slug(cwd))


def _declared_deliverables(task_identity, repo_root):
    """Repo-relative deliverable paths declared by the bundle's
    `deliverables=` meta header, or [] (mirrors dispatch_verify.
    parse_deliverables — the runner keeps its own copy so it stays
    stdlib-only and independent of the verifier)."""
    if not repo_root or not task_identity:
        return []
    if not re.fullmatch(r"T\d+", task_identity):
        return []
    hits = glob.glob(os.path.join(repo_root, "untracked", task_identity + "-*.md"))
    if len(hits) != 1:
        return []
    try:
        with open(hits[0]) as f:
            for line in f:
                line = line.strip()
                if line.startswith("<!--managent "):
                    m = re.search(r"deliverables=(.*?)(?:\s|-->)", line)
                    if m:
                        return [p.strip() for p in m.group(1).rstrip(",").split(",") if p.strip()]
                    break
    except OSError:
        pass
    return []


def _claude_sensor_max_mtime(deliverables, transcript_dir, launch_epoch):
    """Max wall-clock mtime across the claude liveness sensor set.

    Sensor set: the declared deliverable paths (absolute) and the claude
    session transcript directory's entries (files + one level of session
    subdirs) whose mtime is >= launch_epoch.  Entries older than launch are
    skipped so a previous session's transcript can never be the "alive"
    reading for this run.  Missing files contribute nothing (a deliverable
    that does not exist yet is not evidence of a hang).
    """
    m = 0.0
    for d in deliverables:
        try:
            st = os.stat(d)
        except OSError:
            continue
        if st.st_mtime > m:
            m = st.st_mtime
    if transcript_dir and os.path.isdir(transcript_dir):
        try:
            names = os.listdir(transcript_dir)
        except OSError:
            names = []
        for name in names:
            p = os.path.join(transcript_dir, name)
            try:
                st = os.stat(p)
            except OSError:
                continue
            if st.st_mtime >= launch_epoch and st.st_mtime > m:
                m = st.st_mtime
            if os.path.isdir(p):
                # session subdir (claude writes per-session scratch under it)
                try:
                    for name2 in os.listdir(p):
                        p2 = os.path.join(p, name2)
                        try:
                            st2 = os.stat(p2)
                            if st2.st_mtime >= launch_epoch and st2.st_mtime > m:
                                m = st2.st_mtime
                        except OSError:
                            continue
                except OSError:
                    continue
    return m


# ── T659: the shared harness p95 table (single source of truth) ─────────────
#
# Operator ruling §7c.34 — the population rule:
#   Completed real work only.  Exclude killed attempts (a kill measures when
#   we stopped a lane, not how long its work takes).  Exclude bakeoff gate
#   sub-runs (harness scaffolding, not work).  One shared table, published,
#   with the rule stated on it; every fuse reads from it.  No fuse derives
#   its own denominator privately again.
#
# Both fuses (T634's claude liveness and T643's pi/ollama progress) read
# their thresholds from ONE committed table — docs/infra/harness-p95.md —
# regenerated by `tools/runner --recompute-harness-p95`.  REGENERATE-ON-A-
# SCHEDULE, not recompute-at-read: untracked/runs/ is host-local and does
# not survive a fresh clone, so a recompute-at-read fuse would have no
# population (and a different threshold) on every other host.  The runner
# parses the committed machine block at each fuse read — cheap, and the
# same threshold on every host.  See the doc's §Argument.

# Fallback thresholds mirroring the committed table — used ONLY when the
# table is unreadable (degraded / bare tree).  Keep in sync with
# docs/infra/harness-p95.md (regenerated by --recompute-harness-p95).
_HARNESS_P95_FALLBACK = {
    "pi": {"threshold_s": 7246},
    "claude": {"threshold_s": 4516},
    "ollama": {"threshold_s": 6766},
}

