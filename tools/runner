#!/usr/bin/env python3
# weizigo agent runner — guarded execution wrapper for zig/agent builds.
#
#   tools/runner [options] [--] <command> [args...]
#   tools/runner --sweep                   (standalone sweep, no command)
#
# Wraps a command in an RSS guard + wall/CPU ceiling + zig optimization
# discipline.  The minimum stand on the 2026-07-29 host panic (see
# docs/infra/host/incident-2026-07-29.md).  The pattern is Opus 5's from
# the EXP-9 close-out: ReleaseFast by default, SIGKILL the process group
# at any ceiling breach, clear reporting on stderr, exit 124.
#
# Three ceilings, all default-on:
#   --rss-cap-mb 4096   SIGKILL the process group when any member exceeds
#                       this RSS.  Protects against compiler blowups that
#                       Jetsam does not catch before the watchdog fires.
#   --max-wall 1800     SIGKILL the process group after this many seconds
#                       of wall-clock time.  Protects against compute loops
#                       that do not allocate, so RSS never fires.
#                       macOS does not have timeout(1), so this is the
#                       project's only reliable wall-time backstop.
#   --max-cpu 3600      SIGKILL the process group when the sum of
#                       cumulative CPU seconds across ALL descendants
#                       exceeds this.  Protects against multi-process
#                       spin loops where no single child shows alarming
#                       RSS or wall time.  Reported per-PID on exit.
#
# Why three ceilings?  The 2026-07-29 panic proved that a single guard
# (RSS) is not enough.  A `zig test` binary spinning at 0% RSS sat
# undetected for 5 hours because name-based greps missed the anonymous
# process.  The wall ceiling catches the long-duration case; the CPU
# ceiling catches the high-throughput case regardless of process name.
#
# macOS timeout(1) gap.  macOS ships no `timeout` utility (it is
# Linux-only / coreutils-only).  Agents reaching for `timeout` to bound
# a run silently get no bound.  This runner replaces that missing tool
# for the project — documented in docs/infra/host/macos-timeout-gap.md.
#
# --sweep mode.  Standalone: lists the top CPU consumers on the host,
# sorted by cumulative CPU time, to help find orphaned zig processes
# (which compile to anonymous .zig-cache names).  No command needed.
#
# WORKER-CHANNEL (2026-07-29): --task-id for identity, heartbeat emission
# to untracked/heartbeat.jsonl, directive checking via tasks.json.  On every
# invocation: prints pending directives on stderr, exits non-zero when a
# `pause` or `kill` directive is pending.  Heartbeat on every exit (success,
# failure, or guard kill) so liveness shows real runs even if ungraceful.
#
# All flags are pass-through except the guard itself.  Exit code 124
# (timeout convention) on guard kill, or the wrapped command's exit code.
#
# Standard library only.  No external dependencies.

import argparse
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from pathlib import Path


# ── helpers ──────────────────────────────────────────────────────────

def _parse_cputime(s):
    """Parse a ps-style CPU time string to total seconds (float).

    Accepts formats (all three from macOS / Linux `ps`):
      [[hh:]mm:]ss          (Linux, whole seconds)
      [[hh:]mm:]ss.cc       (macOS, centiseconds suffix)
      [dd-]hh:mm:ss[.cc]    (days-hours:minutes:seconds[.centiseconds])
      0                     (single digit, edge case)
    """
    s = s.strip()
    if not s:
        return 0.0
    # Days prefix: "dd-hh:mm:ss" or "dd-hh:mm:ss.cc"
    if '-' in s:
        days_part, rest = s.split('-', 1)
        try:
            days = int(days_part)
        except ValueError:
            return 0.0
        return days * 86400 + _parse_hms(rest)
    # [[hh:]mm:]ss or [[hh:]mm:]ss.cc
    return _parse_hms(s)


def _parse_hms(s):
    """Parse [[hh:]mm:]ss[.cc] to float seconds."""
    parts = s.split(':') if ':' in s else ['0', s]
    try:
        if len(parts) == 3:
            h, m, rest = parts
            secs = float(rest) if '.' in rest else int(rest)
            return int(h) * 3600 + int(m) * 60 + secs
        if len(parts) == 2:
            m, rest = parts
            secs = float(rest) if '.' in rest else int(rest)
            return int(m) * 60 + secs
        if len(parts) == 1:
            return float(parts[0]) if '.' in parts[0] else int(parts[0])
    except ValueError:
        return 0.0
    return 0.0


def _format_clock(secs):
    """Format seconds as [H:]M:SS for human-readable output."""
    secs = int(secs)
    h, r = divmod(secs, 3600)
    m, s = divmod(r, 60)
    if h:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m}:{s:02d}"


def _cpu_time_seconds(pid):
    """Return cumulative CPU time in seconds for `pid`, or None.

    Uses the `time` column (total CPU = user + system) from `ps`.
    On macOS the format is [[hh:]mm:]ss.cc; on Linux [[hh:]mm:]ss.
    """
    try:
        out = subprocess.run(
            ["ps", "-o", "time=", "-p", str(pid)],
            capture_output=True, text=True, timeout=0.5,
        )
        if out.returncode == 0 and out.stdout.strip():
            return _parse_cputime(out.stdout.strip())
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


# ── repo root (walk up for .git) ───────────────────────────────────────────

def _find_repo_root():
    """Walk up from cwd to find the repo root (contains .git)."""
    current = os.getcwd()
    while True:
        if os.path.isdir(os.path.join(current, ".git")):
            return current
        parent = os.path.dirname(current)
        if parent == current:
            return None
        current = parent


# ── directive checking (WORKER-CHANNEL) ────────────────────────────────────

def _check_directives(task_id, repo_root):
    """Check for pending directives addressed to `task_id`.

    Reads docs/infra/managent/directives.jsonl (one JSON object per line)
    and looks for unread entries targeting this task.  Prints any pending
    directives on stderr.  Returns True when a pause or kill directive is
    pending (caller should exit 124 before launching the command).
    """
    if not repo_root or not task_id:
        return False

    dir_path = os.path.join(repo_root, "docs", "infra", "managent", "directives.jsonl")
    if not os.path.isfile(dir_path):
        return False

    try:
        pending = []
        with open(dir_path) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if d.get("target") == task_id and d.get("read") is False:
                    pending.append(d)
    except OSError:
        return False

    if not pending:
        return False

    print("[runner] === pending directives ===", file=sys.stderr)
    for d in pending:
        directive = d.get("directive", "?")
        note = d.get("note", "")
        from_who = d.get("from", "?")
        print(f"[runner]   {directive.upper()}  from {from_who}", file=sys.stderr)
        if note:
            print(f"[runner]     {note}", file=sys.stderr)

    has_stop = any(d.get("directive") in ("pause", "kill") for d in pending)
    return has_stop


# ── heartbeat emission (WORKER-CHANNEL) ────────────────────────────────────

def _emit_heartbeat(task_id, command, wall, cpu, rss_mb, repo_root):
    """Append a heartbeat line to untracked/heartbeat.jsonl.

    The heartbeat records the runner invocation so `managent liveness`
    can report per-task liveness.
    """
    if not repo_root:
        return

    hb_dir = os.path.join(repo_root, "untracked")
    os.makedirs(hb_dir, exist_ok=True)
    hb_path = os.path.join(hb_dir, "heartbeat.jsonl")

    ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    record = {
        "identifier": task_id or "unknown/unknown",
        "task": task_id or "unknown",
        "ts": ts,
        "command": command or "",
        "wall": round(wall, 1) if wall >= 0 else None,
        "cpu": round(cpu, 1) if cpu >= 0 else None,
        "rss_mb": round(rss_mb, 1) if rss_mb >= 0 else None,
    }
    # Strip None values for brevity
    record = {k: v for k, v in record.items() if v is not None}

    try:
        with open(hb_path, "a") as f:
            f.write(json.dumps(record, sort_keys=True) + "\n")
    except OSError:
        pass


def prepend_releasefast(argv):
    """Auto-add an optimize flag for `zig` invocations if missing.

    The 2026-07-29 host panic was caused by `zig build-exe` running in Debug
    (LLVM path is the memory hog). The fix: ensure every zig invocation in
    the runner has an explicit -O / -Doptimize, defaulting to ReleaseFast.

      zig build / build install   -> -Doptimize=ReleaseFast (project option)
      zig build-exe / build-lib / build-obj / test / run / install
                                   -> -O ReleaseFast (command-level option)
    """
    if not argv:
        return argv
    if Path(argv[0]).name != "zig":
        return argv
    if "-O" in argv or "-Doptimize" in argv:
        return argv
    if len(argv) < 2:
        return argv
    sub = argv[1]
    if sub in ("build",):
        return [argv[0], sub, "-Doptimize=ReleaseFast", *argv[2:]]
    if sub in ("build-exe", "build-lib", "build-obj", "test", "run", "install"):
        return [argv[0], sub, "-O", "ReleaseFast", *argv[2:]]
    return argv


# ── sweep (standalone) ───────────────────────────────────────────────

def sweep():
    """List top CPU consumers on the host (finding orphan zig processes).

    Orphaned `zig test` / `zig build-exe` binaries compile to anonymous
    paths under .zig-cache/ and are invisible to name-based greps.  This
    mode lists every process by cumulative CPU time, so the human or a
    follow-up agent can identify spinners.
    """
    print("[runner] === SWEEP: top processes by CPU time ===", file=sys.stderr)
    try:
        out = subprocess.run(
            ["ps", "-axo", "pid=,etime=,cputime=,command="],
            capture_output=True, text=True, timeout=5.0,
        )
    except FileNotFoundError:
        print("[runner] SWEEP failed: `ps` not found", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print("[runner] SWEEP failed: `ps` timed out", file=sys.stderr)
        sys.exit(1)

    lines = out.stdout.splitlines()
    if not lines:
        print("[runner] SWEEP: no processes", file=sys.stderr)
        sys.exit(0)

    def sort_key(line):
        # cputime is the third whitespace-delimited column after pid, etime
        parts = line.split(None, 3)
        if len(parts) >= 3:
            return _parse_cputime(parts[2])
        return 0

    data = sorted(lines, key=sort_key, reverse=True)
    header = data[0] if data else ""
    body = data[1:] if len(data) > 1 else []
    n_show = min(20, len(body))

    print(f"  PID  ETIME      CPUTIME    COMMAND", file=sys.stderr)
    print(f"  ---  -----      -------    -------", file=sys.stderr)
    for line in body[:n_show]:
        parts = line.split(None, 3)
        if len(parts) >= 4:
            pid, etime, cputime, cmd = parts
            print(f"  {pid:<5s} {etime:<10s} {cputime:<10s} {cmd}", file=sys.stderr)
        else:
            print(f"  {line}", file=sys.stderr)
    print(f"[runner] === {len(body)} processes total, showing top {n_show} ===", file=sys.stderr)
    sys.exit(0)


# ── process tree walking ─────────────────────────────────────────────

def _descendant_pids_linux(root_pid):
    """Walk /proc and return root_pid + all descendants (Linux)."""
    pids = set()
    children = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        try:
            with open(f"/proc/{pid}/status") as f:
                ppid = None
                for line in f:
                    if line.startswith("PPid:"):
                        ppid = int(line.split()[1])
                        break
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
        if ppid is not None:
            children.setdefault(ppid, []).append(pid)
    # BFS from root_pid
    stack = [root_pid]
    while stack:
        pid = stack.pop()
        pids.add(pid)
        stack.extend(children.get(pid, []))
    return pids


def _descendant_pids_ps(root_pid):
    """Walk via `ps` and return root_pid + all descendants (macOS / BSD)."""
    out = subprocess.run(
        ["ps", "-axo", "pid=,ppid="], capture_output=True, text=True, timeout=2.0,
    )
    children = {}
    for line in out.stdout.splitlines():
        parts = line.split()
        if len(parts) != 2:
            continue
        try:
            pid, ppid = int(parts[0]), int(parts[1])
        except ValueError:
            continue
        children.setdefault(ppid, []).append(pid)
    pids = set()
    stack = [root_pid]
    while stack:
        pid = stack.pop()
        pids.add(pid)
        stack.extend(children.get(pid, []))
    return pids


# ── RSS reading ──────────────────────────────────────────────────────

def _rss_bytes(pid):
    """Return RSS in bytes for `pid`, or None on any read failure.

    Linux: read VmRSS from /proc/<pid>/status (kB -> bytes).
    macOS: `ps -o rss= -p <pid>` (kB -> bytes, on macOS this is 1024-byte
    pages reported as kB; rounding is fine for the cap check).

    The platform split is per *pid*, not per process invocation: a runner
    that itself runs on Linux must still tolerate a macOS-style ps when
    /proc is unavailable (containers, chroots, etc.). The Linux branch
    returns the bytes; if /proc is not present it returns the macOS-style
    sentinel `'NOPROC'` and the caller falls through to ps. The function
    does NOT return None for "platform unsupported" — None is for "I tried
    everything and the pid is gone or unreadable."
    """
    # Linux: /proc/<pid>/status has VmRSS in kB. If /proc itself does not
    # exist (macOS / BSD), signal the caller to try the ps path.
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("VmRSS:"):
                    return int(line.split()[1]) * 1024
    except FileNotFoundError as e:
        # /proc may not exist on this host (macOS, BSD, some containers).
        # Distinguish "no /proc" from "pid is gone": the former opens the
        # directory and raises ENOENT for the *directory*, the latter is
        # the file. We treat "no /proc" as the platform signal.
        if "/proc" in str(e):
            return "NOPROC"
        return None
    except (ProcessLookupError, PermissionError):
        return None

    # macOS / BSD: ps -o rss= -p <pid> gives RSS in kB.
    try:
        out = subprocess.run(
            ["ps", "-o", "rss=", "-p", str(pid)],
            capture_output=True, text=True, timeout=0.5,
        )
        if out.returncode == 0 and out.stdout.strip():
            return int(out.stdout.strip()) * 1024
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


# ── logging ──────────────────────────────────────────────────────────

def _log_peaks(peak_rss, peak_cpu=None, t0=None):
    elapsed = f" in {time.monotonic() - t0:.1f} s" if t0 else ""
    print(f"[runner] peak RSS by PID:{elapsed}", file=sys.stderr)
    for pid in sorted(peak_rss, key=lambda p: -peak_rss[p]):
        mb = peak_rss[pid] // (1024 * 1024)
        print(f"[runner]   pid {pid:>7d}  {mb:>6d} MB", file=sys.stderr)
    if peak_cpu:
        print(f"[runner] peak total CPU by PID:{elapsed}", file=sys.stderr)
        for pid in sorted(peak_cpu, key=lambda p: -peak_cpu[p]):
            secs = peak_cpu[pid]
            print(f"[runner]   pid {pid:>7d}  {_format_clock(secs):>10s} ({secs}s)", file=sys.stderr)


# ── main ─────────────────────────────────────────────────────────────

def main():
    ap = argparse.ArgumentParser(
        prog="tools/runner",
        description="Guarded runner for weizigo agent builds. "
                    "Default -O ReleaseFast; SIGKILL the group at the "
                    "RSS / wall / CPU ceiling.  Also: --sweep for "
                    "orphan-zig detection.",
    )
    ap.add_argument("--rss-cap-mb", type=int, default=4096,
                    help="kill the process group when any member exceeds "
                         "this RSS in MB (default 4096)")
    ap.add_argument("--max-wall", type=int, default=1800,
                    help="SIGKILL the process group after this many "
                         "seconds of wall time (default 1800 = 30 min; "
                         "0 to disable)")
    ap.add_argument("--max-cpu", type=int, default=3600,
                    help="SIGKILL the process group when cumulative CPU "
                         "seconds across all descendants exceeds this "
                         "(default 3600 = 1h; 0 to disable)")
    ap.add_argument("--poll-ms", type=int, default=250,
                    help="RSS / CPU / wall check interval in ms (default 250)")
    ap.add_argument("--no-prepend-zig", action="store_true",
                    help="do not auto-add -O ReleaseFast to zig commands")
    ap.add_argument("--log-rss", action="store_true",
                    help="log per-member RSS every poll (verbose)")
    ap.add_argument("--show-peak-on-exit", dest="show_peak", action="store_true", default=True,
                    help="log per-member peak RSS on exit (default true)")
    ap.add_argument("--no-show-peak-on-exit", dest="show_peak", action="store_false",
                    help="do not log per-member peak RSS on exit")
    ap.add_argument("--task-id", type=str, default=None,
                    help="worker/task identifier for heartbeat and directive "
                         "checking, e.g. DSPro/2B-5 or WORKER-CHANNEL")
    ap.add_argument("--sweep", action="store_true",
                    help="standalone: list top CPU consumers on the host "
                         "(no command needed)")
    ap.add_argument("rest", nargs=argparse.REMAINDER,
                    help="command and arguments after `--`")
    args = ap.parse_args()

    # Handle --sweep (standalone)
    if args.sweep:
        sweep()
        # sweep() calls sys.exit, but be safe:
        return

    # argparse.REMAINDER includes the leading `--` if present; strip it
    if not args.rest:
        ap.error("missing command; pass `-- <command> [args...]` or use `--sweep`")
    if args.rest[0] == "--":
        argv = args.rest[1:]
    else:
        argv = args.rest
    if not argv:
        ap.error("missing command after `--`")

    if not args.no_prepend_zig:
        argv = prepend_releasefast(argv)

    cap_bytes = args.rss_cap_mb * 1024 * 1024
    poll_s = args.poll_ms / 1000.0

    # New process group so SIGKILL reaches the whole tree, not just the
    # wrapper's child. (The child becomes its own session leader; the
    # group ID == its PID.)
    preexec_fn = lambda: os.setsid() if hasattr(os, "setsid") else None

    print(f"[runner] argv = {shlex.join(argv)}", file=sys.stderr)
    ceilings = []
    if args.rss_cap_mb:
        ceilings.append(f"rss {args.rss_cap_mb} MB")
    else:
        ceilings.append("rss off")
    if args.max_wall:
        ceilings.append(f"wall {args.max_wall}s ({_format_clock(args.max_wall)})")
    else:
        ceilings.append("wall off")
    if args.max_cpu:
        ceilings.append(f"cpu {args.max_cpu}s ({_format_clock(args.max_cpu)})")
    else:
        ceilings.append("cpu off")
    print(f"[runner] ceilings: {', '.join(ceilings)}, poll = {args.poll_ms} ms", file=sys.stderr)

    # ── WORKER-CHANNEL: directive check before launch ──────────────────────
    repo_root = _find_repo_root()
    task_identity = args.task_id or os.environ.get("MANAGENT_TASK_ID")
    if not task_identity:
        # Fallback: derive from the command (last-resort heuristic)
        task_identity = f"runner/{os.getpid()}"
    has_stop_directive = _check_directives(task_identity, repo_root)
    if has_stop_directive:
        _emit_heartbeat(task_identity, shlex.join(argv), -1, -1, -1, repo_root)
        print(f"[runner] exit 124 (directive: pause/kill pending)", file=sys.stderr)
        sys.exit(124)

    # ── WORKER-CHANNEL: auto-claim via managent ──────────────────────────
    if args.task_id:
        model = os.environ.get("PI_MODEL", "unknown")
        managent = os.path.join(repo_root, "bin", "managent") if repo_root else "bin/managent"
        result = subprocess.run([managent, "claim", args.task_id, "--agent", model], capture_output=True, text=True)
        if result.returncode != 0:
            stderr_text = result.stderr.strip()
            if not stderr_text:
                stderr_text = result.stdout.strip()
            print(f"[runner] manage claim FAILED (exit {result.returncode}): {stderr_text}", file=sys.stderr)
            sys.exit(1)

    t0 = time.monotonic()
    proc = subprocess.Popen(argv, preexec_fn=preexec_fn)
    sys.stderr.flush()

    peak_rss = {}   # pid -> max RSS bytes
    peak_cpu = {}   # pid -> cumulative CPU seconds (peak snapshot per PID)

    logs_done = False  # suppress finally-block logging if kill path already did it

    try:
        while True:
            ret = proc.poll()
            if ret is not None:
                break
            time.sleep(poll_s)

            elapsed = time.monotonic() - t0

            # Walk descendants
            try:
                pids = _descendant_pids_linux(proc.pid)
            except (FileNotFoundError, NotImplementedError, OSError) as e:
                if args.log_rss:
                    print(f"[runner] linux walker failed ({type(e).__name__}), falling back to ps", file=sys.stderr)
                pids = _descendant_pids_ps(proc.pid)

            total_cpu = 0.0
            over_rss = False
            over_cpu = False

            for pid in pids:
                # -- RSS check (existing) --
                try:
                    rss = _rss_bytes(pid)
                except (FileNotFoundError, ProcessLookupError):
                    continue
                if rss is None:
                    continue
                if rss == "NOPROC":
                    try:
                        out = subprocess.run(
                            ["ps", "-o", "rss=", "-p", str(pid)],
                            capture_output=True, text=True, timeout=0.5,
                        )
                        if out.returncode == 0 and out.stdout.strip():
                            rss = int(out.stdout.strip()) * 1024
                        else:
                            continue
                    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
                        continue
                peak_rss[pid] = max(peak_rss.get(pid, 0), rss)
                if args.rss_cap_mb and rss > cap_bytes:
                    over_rss = True
                    if not args.log_rss:
                        print(f"[runner] PID {pid} RSS {rss // (1024*1024)} MB > cap {args.rss_cap_mb} MB", file=sys.stderr)
                    break

                # -- CPU check (new) --
                if args.max_cpu:
                    cpu = _cpu_time_seconds(pid)
                    if cpu is not None:
                        total_cpu += cpu
                        peak_cpu[pid] = max(peak_cpu.get(pid, 0.0), cpu)

                if args.log_rss:
                    extra = ""
                    if not over_rss:
                        extra = f", RSS {rss // (1024*1024)} MB"
                    print(f"[runner] PID {pid}{extra}", file=sys.stderr)
            sys.stderr.flush()

            # Check ceilings
            kill_reason = None

            if over_rss:
                kill_reason = f"RSS cap {args.rss_cap_mb} MB exceeded"
            elif args.max_wall and elapsed >= args.max_wall:
                kill_reason = f"wall ceiling {args.max_wall}s ({_format_clock(args.max_wall)}) reached " \
                              f"at {elapsed:.1f}s elapsed"
            elif args.max_cpu and total_cpu >= args.max_cpu:
                kill_reason = f"CPU ceiling {args.max_cpu}s ({_format_clock(args.max_cpu)}) exceeded " \
                              f"({total_cpu:.1f}s total)"

            if kill_reason:
                print(f"[runner] KILL: {kill_reason}", file=sys.stderr)
                print(f"[runner] SIGKILL pgid {proc.pid}", file=sys.stderr)
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                try:
                    proc.wait(timeout=2.0)
                except subprocess.TimeoutExpired:
                    pass
                if args.show_peak:
                    _log_peaks(peak_rss, peak_cpu, t0=t0)
                logs_done = True
                elapsed = time.monotonic() - t0
                # Emit heartbeat with final measurements
                peak_rss_mb = max(peak_rss.values()) // (1024 * 1024) if peak_rss else 0
                total_cpu_sum = sum(peak_cpu.values()) if peak_cpu else 0.0
                _emit_heartbeat(task_identity, shlex.join(argv), elapsed, total_cpu_sum, peak_rss_mb, repo_root)
                print(f"[runner] exit 124 ({kill_reason}) in {elapsed:.1f} s", file=sys.stderr)
                sys.exit(124)

        ret = proc.wait()
    except Exception as exc:
        # Ensure heartbeat on unexpected exception
        elapsed = time.monotonic() - t0
        _emit_heartbeat(task_identity, shlex.join(argv), elapsed, -1, -1, repo_root)
        raise
    finally:
        if args.show_peak and not logs_done and (peak_rss or peak_cpu):
            _log_peaks(peak_rss, peak_cpu, t0=t0)

    elapsed = time.monotonic() - t0
    peak_rss_mb = max(peak_rss.values()) // (1024 * 1024) if peak_rss else 0
    total_cpu_sum = sum(peak_cpu.values()) if peak_cpu else 0.0
    _emit_heartbeat(task_identity, shlex.join(argv), elapsed, total_cpu_sum, peak_rss_mb, repo_root)
    print(f"[runner] exit {ret} in {elapsed:.1f} s", file=sys.stderr)

    # ── WORKER-CHANNEL: auto-done on success ─────────────────────────────
    if ret == 0 and args.task_id:
        managent = os.path.join(repo_root, "bin", "managent") if repo_root else "bin/managent"
        result = subprocess.run([managent, "done", args.task_id], capture_output=True, text=True)
        if result.returncode != 0:
            stderr_text = result.stderr.strip()
            if not stderr_text:
                stderr_text = result.stdout.strip()
            print(f"[runner] manage done FAILED (exit {result.returncode}): {stderr_text}", file=sys.stderr)
            print(f"[runner] exit 1 (manage done rejected)", file=sys.stderr)
            sys.exit(1)

    sys.exit(ret)


if __name__ == "__main__":
    main()
