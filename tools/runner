)


def _linear_percentile(sorted_vals, p):
    """p-th percentile by linear interpolation over an already-sorted
    list (T643/T659 method).  Returns None on empty input."""
    n = len(sorted_vals)
    if n == 0:
        return None
    if n == 1:
        return sorted_vals[0]
    rank = p * (n - 1)
    lo = int(math.floor(rank))
    hi = int(math.ceil(rank))
    if lo == hi:
        return sorted_vals[lo]
    frac = rank - lo
    return sorted_vals[lo] * (1.0 - frac) + sorted_vals[hi] * frac


def _run_family(command):
    """The harness family of a run record's command: the child binary
    basename for agent lanes (pi/claude/ollama), else 'other'."""
    if not command:
        return "other"
    argv0 = os.path.basename(command.split()[0])
    if argv0 in AGENT_LANE_BINARIES:
        return argv0
    return "other"


def _record_is_killed(rec):
    """A guard-killed attempt (T629 vocabulary): a killed reason, a
    signal, or a non-'none' killed_by enum."""
    return bool(rec.get("killed") or rec.get("signal") or
                (rec.get("killed_by") not in (None, "none", "")))


def _load_harness_p95(repo_root):
    """Parse the shared table's machine block (docs/infra/harness-p95.md).
    Returns the parsed dict, or None when the table is absent/unparseable."""
    if not repo_root:
        return None
    path = os.path.join(repo_root, "docs", "infra", "harness-p95.md")
    try:
        with open(path) as f:
            text = f.read()
    except OSError:
        return None
    m = re.search(
        r"<!-- BEGIN harness-p95 -->\s*```json\s*\n(.*?)\n```\s*\n<!-- END harness-p95 -->",
        text, re.DOTALL)
    if not m:
        return None
    try:
        return json.loads(m.group(1))
    except ValueError:
        return None


def _family_threshold(table, family):
    """The fuse threshold (seconds) for a family from the shared table,
    or the committed fallback when the table is unreadable."""
    if table:
        fam = (table.get("families") or {}).get(family) or {}
        t = fam.get("threshold_s")
        if isinstance(t, (int, float)):
            return int(t)
    fb = _HARNESS_P95_FALLBACK.get(family) or {}
    t = fb.get("threshold_s")
    return int(t) if t else None


def _git_head_commit(repo_root):
    """The full commit SHA of the working tree (the snapshot anchor for
    the table), or None outside a git repo / on an unborn HEAD."""
    try:
        out = subprocess.run(
            ["git", "-C", repo_root or ".", "rev-parse", "HEAD"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            timeout=2.0,
        )
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return None


def _harness_p95_json_block(families, commit):
    """The machine block's JSON (also the stdout data line of
    --recompute-harness-p95)."""
    obj = {
        "schema": "harness-p95",
        "computed_at_commit": commit,
        "population_rule": (
            "completed real work only (operator ruling §7c.34): exclude "
            "killed attempts; exclude bakeoff gate sub-runs"),
        "families": families,
    }
    return json.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False)


def recompute_harness_p95(runs_dir, out_path, repo_root):
    """Recompute docs/infra/harness-p95.md from run records (T659).

    Population: top-level untracked/runs/*.json, EXCLUDING (a) bakeoff gate
    sub-runs (bakeoff_* prefix), (b) guard-killed attempts (killed/signal/
    killed_by), (c) incomplete records (no exit/end — launch-only or live),
    and (d) non-agent 'other' fixtures.  Per-family wall percentiles by
    linear interpolation; fuse threshold = ceil(3 x p95).  Output is
    deterministic: recomputing with no new runs and the same HEAD is
    byte-identical.  Prints the machine JSON to stdout (data) and the
    census to stderr (diagnostics).  Returns 0 on success.
    """
    runs_dir = runs_dir or os.path.join(repo_root or ".", "untracked", "runs")
    out_path = out_path or os.path.join(
        repo_root or ".", "docs", "infra", "harness-p95.md")

    walls = {}          # family -> list of wall seconds (completed real work)
    census = {
        "killed_agent": [],          # (task, family, wall) killed agent lanes
        "killed_other": 0,           # killed non-agent fixtures
        "bakeoff": 0,
        "incomplete": [],            # (filename) no exit/end
        "other_fixture": 0,          # completed non-agent fixtures
        "unparseable": [],           # (filename, reason)
    }

    try:
        names = sorted(os.listdir(runs_dir))
    except OSError:
        names = []
    for fn in names:
        if not fn.endswith(".json"):
            continue
        path = os.path.join(runs_dir, fn)
        try:
            with open(path) as f:
                rec = json.load(f)
        except (OSError, ValueError) as exc:
            census["unparseable"].append((fn, str(exc)[:60]))
            continue
        if fn.startswith("bakeoff_"):
            census["bakeoff"] += 1
            continue
        fam = _run_family(rec.get("command", ""))
        if _record_is_killed(rec):
            if fam in AGENT_LANE_BINARIES:
                census["killed_agent"].append((rec.get("task", fn), fam, rec.get("wall")))
            else:
                census["killed_other"] += 1
            continue
        if "exit" not in rec:
            census["incomplete"].append(rec.get("task", fn))
            continue
        if fam == "other":
            census["other_fixture"] += 1
            continue
        w = rec.get("wall")
        if w is None:
            census["incomplete"].append(rec.get("task", fn))
            continue
        walls.setdefault(fam, []).append(w)

    families = {}
    for fam in ("pi", "claude", "ollama"):
        ws = sorted(walls.get(fam, []))
        n = len(ws)
        p50 = _linear_percentile(ws, 0.50)
        p95 = _linear_percentile(ws, 0.95)
        p99 = _linear_percentile(ws, 0.99)
        mx = max(ws) if ws else None
        threshold = math.ceil(3.0 * p95) if p95 is not None else None
        families[fam] = {
            "n": n,
            "p50": round(p50, 2) if p50 is not None else None,
            "p95": round(p95, 2) if p95 is not None else None,
            "p99": round(p99, 2) if p99 is not None else None,
            "max": round(mx, 2) if mx is not None else None,
            "threshold_s": threshold,
        }

    commit = _git_head_commit(repo_root)
    block = _harness_p95_json_block(families, commit)
    doc = _harness_p95_markdown(families, census, commit, block)

    out_dir = os.path.dirname(out_path)
    if out_dir:
        try:
            os.makedirs(out_dir, exist_ok=True)
        except OSError:
            pass
    with open(out_path, "w") as f:
        f.write(doc)

    # stdout = data (the machine block), stderr = diagnostics (the census).
    print(block)
    print(f"[runner] recompute-harness-p95: wrote {out_path}", file=sys.stderr)
    for fam in ("pi", "claude", "ollama"):
        s = families[fam]
        print(f"[runner]   {fam}: n={s['n']} p95={s['p95']} threshold={s['threshold_s']}s",
              file=sys.stderr)
    print(f"[runner]   exclusions: bakeoff={census['bakeoff']} "
          f"killed_agent={len(census['killed_agent'])} killed_other={census['killed_other']} "
          f"incomplete={len(census['incomplete'])} other_fixture={census['other_fixture']} "
          f"unparseable={len(census['unparseable'])}", file=sys.stderr)
    return 0


def _harness_p95_markdown(families, census, commit, block):
    """The committed markdown doc, a pure function of (families, census,
    commit) so `--recompute-harness-p95` is byte-identical given the same
    inputs.  The fixed prose (population rule, §Argument) is the template
    here, version-controlled in tools/runner."""
    fam_rows = []
    fam_meta = {
        "pi": ("pi (deepseek)", "agent progress (T643/T659)"),
        "claude": ("claude", "liveness (T634/T659)"),
        "ollama": ("ollama", "agent progress (T643/T659)"),
    }
    for fam in ("pi", "claude", "ollama"):
        s = families[fam]
        label, fuse = fam_meta[fam]
        fam_rows.append(
            f"| {label} | {s['n']} | {s['p50']:.2f} | {s['p95']:.2f} | "
            f"{s['p99']:.2f} | {s['max']:.2f} | {s['threshold_s']} | {fuse} |")

    killed_agent_lines = "\n".join(
        f"- {task} ({fam}) {w:.1f} s" for task, fam, w in
        sorted(census["killed_agent"], key=lambda t: (t[1], t[0])))
    log_only_lines = "\n".join(
        f"- {task} ({fam}) {w:.1f} s" for task, fam, w in _LOG_ONLY_KILLED_ATTEMPTS)
    incomplete_lines = "\n".join(
        f"- {t}" for t in sorted(census["incomplete"]))
    unparseable_lines = "\n".join(
        f"- {fn} ({reason})" for fn, reason in sorted(census["unparseable"]))

    return f"""# Shared harness p95 table — fuse thresholds

**Rule:** operator ruling **§7c.34** — the population rule every fuse reads,
verbatim:

> **Completed real work only.** Exclude killed attempts (a kill measures when
> we stopped a lane, not how long its work takes). Exclude bakeoff gate
> sub-runs (harness scaffolding, not work). One shared table, published, with
> the rule stated on it; every fuse reads from it. No fuse derives its own
> denominator privately again.

**Computed at commit:** `{commit or '(no commit)'}` (the full SHA of the working
tree this snapshot was derived from). **Regenerated, not recomputed at read** —
see §Argument. The run-record input is the host-local `untracked/runs/` store,
which is NOT in git; the per-family `n` and the exclusion counts below are its
fingerprint, so a reader can tell whether the store has drifted since.

## Per-family table

| family | n | p50 (s) | p95 (s) | p99 (s) | max (s) | fuse threshold (3 × p95, ceil) | fuse |
|---|---|---|---|---|---|---|---|
{chr(10).join(fam_rows)}

`other` (non-agent harness fixtures — regression stubs, `zig build`-shaped
runs) is not a worker-lane population and carries no fuse.  Records under
subdirectories (e.g. `archive-2026-08-20/`, 30 pre-T515 pid-named degraded
records) are out of scope: the recompute reads only top-level `*.json`, and
those 30 are all non-agent `other` fixtures anyway.

## Exclusions applied (what was thrown away, and why)

| exclusion | count |
|---|---|
| killed attempts (agent lanes) | {len(census['killed_agent'])} |
| killed attempts (non-agent fixtures) | {census['killed_other']} |
| killed attempts, no surviving record | {len(_LOG_ONLY_KILLED_ATTEMPTS)} |
| bakeoff gate sub-runs | {census['bakeoff']} |
| incomplete (launch-only / in-progress) | {len(census['incomplete'])} |
| non-agent fixtures (family `other`) | {census['other_fixture']} |
| unparseable records | {len(census['unparseable'])} |

**Killed agent lanes** (walls censored, not samples — each is excluded):

{killed_agent_lines or '- (none)'}

**Killed attempts with no surviving record** (overwritten pre-T650 a4eac54;
kills proven by `untracked/log/`, absent from the store):

{log_only_lines}

**Incomplete records** (launch-only or in-progress, no `exit`/`end`):

{incomplete_lines or '- (none)'}

**Unparseable records** (skipped, never guessed):

{unparseable_lines or '- (none)'}

**Seeded control:** all five known watchdog/liveness kills are absent from the
p95 population — T526 (pi, 1129.6 s), T635 (pi, 1732.6 s), T638 (pi, 1901.3 s),
T616 (claude, 600.8 s), T643 (pi, 1706.8 s).

## Argument: regenerated on a schedule, not recomputed at each fuse read

The table is **recomputed-and-committed** by `tools/runner --recompute-harness-p95`
and the runner **reads the committed table** at each fuse read.  Not recomputed
at read, because:

1. **Reproducibility across hosts.** `untracked/runs/` is host-local and
   gitignored — it does not survive a fresh clone.  A recompute-at-read fuse
   would have no population on a fresh clone and a different threshold on
   every host; a fuse threshold must be identical wherever the runner runs, or
   a pass/fail is not reproducible.  Only the committed table gives that.
2. **The cost buys nothing.** Reading hundreds of JSON records and sorting on
   every dispatch is pure overhead; one new run moves a family p95 by seconds,
   far below the fuse's minutes-long threshold.
3. **Staleness is detectable, not silent.** The recompute is a single
   deterministic command (wired as a byte-identical regression), and a
   staleness check — "records landed since the table's commit" — is a cheap
   gate on the regeneration cadence.
4. **The published table must be the real one.** A recompute-at-read design
   would leave the committed markdown describing thresholds that no longer
   exist; the ruling demands the published table BE the source.

<!-- BEGIN harness-p95 -->
```json
{block}
```
<!-- END harness-p95 -->
"""


def _capture_tokens(argv, claude_json_lane, stdout_text, stderr_text,
                    task_identity, repo_root, start_ts, rc, kill_reason=None):
    """The capture path for one run.  Returns a dict
    {tokens_in, tokens_out, tokens_fresh, tokens_cache_read, source,
    missing_reason, session_id, session_reason} (None values when no
    reading / no handle). T566: always returns the dict — the envelope PARSE
    (text + usage) runs even in degraded mode so a claude lane never loses
    its text; only the RECORDING (tee + ledger) is gated on identity
    (repo_root is record_root here, None when degraded).

    T558: tokens_in stays input+cache_read (readers keep working); the
    split rides beside it as tokens_fresh (= input) and tokens_cache_read
    (= cache_read), so the cost ladder can price cache reads differently
    from fresh input.  All three are stamped ALWAYS (nulls included).

    Side effects, all under <repo_root>/untracked/tokens/:
      - tee the complete raw stdout+stderr per task (any usage lines
        survive — the deepseek/pi and ollama/qwen capture, D043 item 2);
      - append one ledger record per run: a reading when one exists, else
        an explicit missing record with a reason — never estimated, never
        a blank cell (D043 item 3).

    T552: the same record carries the resumable session handle (session_id
    + session_reason) wherever the token counts land — run record, lane
    trailer, ledger line.  A family with a handle in its envelope (claude)
    records it; a family without one (pi/ollama never emit it) records null
    WITH a reason — the same rule token capture already follows, never a
    blank, never an invented id.
    """
    tc = _load_token_capture()
    model = _argv_model(argv)
    provider = _argv_provider(argv)
    out = {"tokens_in": None, "tokens_out": None, "tokens_fresh": None,
           "tokens_cache_read": None, "source": None,
           "missing_reason": None, "text": None,
           "session_id": None, "session_reason": None,
           "session_path": None, "session_path_reason": None,
           "rate_band": None, "rate_band_reason": None}
    usage = None
    is_api_error = False
    if tc is not None:
        # T566: recording (tees + ledger) is gated on identity — repo_root
        # here is record_root, which is None in degraded mode. The envelope
        # parse below runs regardless, so a degraded claude lane still
        # forwards its text (never a silent 0-byte).
        if repo_root:
            try:
                tc.write_tees(repo_root, task_identity, start_ts, provider,
                              stdout_text, stderr_text)
            except Exception:
                pass
        if claude_json_lane:
            try:
                text, usage, meta = tc.parse_claude_envelope(stdout_text)
                out["text"] = text
                # T552: the envelope also carries the resumable session
                # handle — record it beside the token reading, or null
                # with a reason when the field is absent.  The handle is
                # independent of the usage reading (an is_error envelope
                # may still carry one).
                if meta.get("session_id_present"):
                    out["session_id"] = meta.get("session_id")
                else:
                    out["session_reason"] = (
                        "claude envelope carries no session_id field")
                if usage is not None and not meta.get("is_error"):
                    # T558: tokens_in keeps its meaning (the sum, so old
                    # readers are untouched); the split is recorded fresh
                    # (= input) vs cache_read so the two can be priced
                    # differently.
                    out["tokens_in"] = usage["input"] + usage["cache_read"]
                    out["tokens_fresh"] = usage["input"]
                    out["tokens_cache_read"] = usage["cache_read"]
                    out["tokens_out"] = usage["output"]
                    out["source"] = "claude-json-envelope"
                elif meta.get("is_error"):
                    is_api_error = True
                    out["missing_reason"] = (
                        "claude api error (is_error=true, zero usage)")
                else:
                    out["missing_reason"] = "no claude usage envelope in output"
            except Exception:
                out["missing_reason"] = "claude envelope parse failed"
                out["session_reason"] = "claude envelope parse failed"
        else:
            # T662: the retroactive meter for pi/ollama lanes is the pi
            # session JSONL.  When the dispatch passed `--session <path>`
            # (bin/subagent now does; bakeoff has since T558), the runner
            # reads the file after the child closes and records the usage
            # split — pi's usage object carries input and cacheRead
            # separately, so a readable session yields a REAL split, never
            # UNKNOWN.  Without a known path the session file cannot be
            # attributed to this lane (concurrent lanes share the default
            # dir ~/.pi/agent/sessions/<cwd-slug>/) — the reading is
            # UNKNOWN, never 0, never the total (a silent zero is a free
            # lane in the cost ladder).
            session_path = _argv_session_path(argv)
            if session_path is not None:
                resolved = (session_path if os.path.isabs(session_path)
                            else os.path.join(os.getcwd(), session_path))
                out["session_path"] = resolved
                if tc is not None:
                    read_pi = getattr(tc, "read_pi_session", None)
                    if read_pi is None:
                        # An OLDER token-capture.py (or a tree where the
                        # pair is half-updated — the 2026-08-22 acd7451
                        # worktree incident) has no per-lane reader: the
                        # reading is UNKNOWN with the reason, never a crash.
                        reason = ("tools/token-capture.py lacks "
                                  "read_pi_session (older copy)")
                        out["missing_reason"] = reason
                        out["session_reason"] = reason
                    else:
                        parsed = read_pi(resolved)
                        if parsed.get("ok"):
                            out["tokens_in"] = (parsed["input"]
                                                 + parsed["cache_read"])
                            out["tokens_fresh"] = parsed["input"]
                            out["tokens_cache_read"] = parsed["cache_read"]
                            out["tokens_out"] = parsed["output"]
                            out["source"] = "pi-session-jsonl"
                            out["session_id"] = parsed["session_id"]
                        else:
                            reason = ("pi session JSONL unreadable: %s"
                                      % parsed.get("reason"))
                            out["missing_reason"] = reason
                            out["session_reason"] = reason
                else:
                    reason = "tools/token-capture.py absent — no pi session parse"
                    out["missing_reason"] = reason
                    out["session_reason"] = reason
            else:
                out["missing_reason"] = (
                    "no structured usage in process output (pi/ollama lane) "
                    "and no --session path at dispatch; pi wrote to "
                    "~/.pi/agent/sessions/<cwd-slug>/ — the file cannot be "
                    "attributed to this lane (UNKNOWN, never 0, never the "
                    "total)")
                out["session_reason"] = (
                    "pi/ollama lane without --session: the session id is not "
                    "emitted at dispatch; pi saves sessions to "
                    "~/.pi/agent/sessions/<cwd-slug>/<uuid>.jsonl and "
                    "resumes via `pi --session <uuid>`, but the per-lane "
                    "file is unattributable (UNKNOWN, never 0, never the "
                    "total)")
    else:
        if claude_json_lane:
            out["missing_reason"] = (
                "tools/token-capture.py absent — no envelope parse, no ledger")
            out["session_reason"] = (
                "tools/token-capture.py absent — no envelope parse, no handle")
        else:
            out["missing_reason"] = (
                "tools/token-capture.py absent — no tee, no ledger")
            out["session_reason"] = (
                "tools/token-capture.py absent — no tee, no handle")
    if tc is not None and repo_root:
        # D044 (2026-08-22, operator; measurement-methodology.md §1b): every
        # token record carries its timestamp (start_ts is the ledger's ts and
        # the run record's start/start_epoch) and, for the deepseek family,
        # the resolved peak/off-peak band computed at write time — a later
        # reader never re-derives a calendar rule from a bare count.  The
        # other families have no time-priced rate; the reason names which.
        band = None
        band_reason = None
        if provider == "deepseek":
            if getattr(tc, "deepseek_rate_band", None) is not None:
                band = tc.deepseek_rate_band(start_ts)
            else:
                band_reason = ("tools/token-capture.py lacks deepseek_rate_band "
                               "(older copy)")
        else:
            base = os.path.basename(argv[0]) if argv else None
            fam = (provider or base or "").lower()
            if fam == "claude":
                band_reason = ("claude: anthropic team subscription — occupancy "
                               "of the five-hour rolling window, no per-token "
                               "time price")
            elif fam == "ollama":
                band_reason = "ollama: credits, no peak concept"
            else:
                band_reason = "family has no time-priced rate"
        out["rate_band"] = band
        out["rate_band_reason"] = band_reason
        try:
            label = tc.canon_tag(model) if model else None
            entry = {
                "task": task_identity,
                "model": label,
                "provider": provider,
                "ts": start_ts,
                "tokens_in": out["tokens_in"],
                "tokens_out": out["tokens_out"],
                "tokens_fresh": out["tokens_fresh"],
                "tokens_cache_read": out["tokens_cache_read"],
                "source": out["source"],
                "missing_reason": out["missing_reason"],
                "session_id": out["session_id"],
                "session_reason": out["session_reason"],
                "session_path": out["session_path"],
                "session_path_reason": out["session_path_reason"],
                "rate_band": out["rate_band"],
                "rate_band_reason": out["rate_band_reason"],
                "rc": rc,
            }
            if usage is not None:
                entry.update({"input": usage.get("input"),
                              "output": usage.get("output"),
                              "cache_read": usage.get("cache_read"),
                              "cache_write": usage.get("cache_write"),
                              "reasoning": usage.get("reasoning")})
            if kill_reason:
                entry["note"] = f"killed: {kill_reason}"
            if is_api_error:
                entry["note"] = "claude envelope reported is_error"
            tc.append_ledger(repo_root, entry)
        except Exception:
            pass
    return out


def _print_tokens_trailer(tok):
    """The trailer lines the bakeoff G1 gate reads (tokens_in/tokens_out)
    and the lane record's session handle (T552: session_id=..., or a
    no-handle line with the reason — never a blank).  T558: the token line
    additionally carries the split behind tokens_in — tokens_fresh (= input)
    and tokens_cache_read (= cache_read) — on the SAME line, so the bakeoff
    trailer regex keeps matching tokens_in/tokens_out unchanged."""
    if tok is None:
        return
    if tok.get("tokens_in") is not None:
        print(f"[runner] tokens_in={tok['tokens_in']} "
              f"tokens_out={tok['tokens_out']} "
              f"tokens_fresh={tok.get('tokens_fresh')} "
              f"tokens_cache_read={tok.get('tokens_cache_read')}",
              file=sys.stderr)
    else:
        reason = tok.get("missing_reason") or "no source"
        print(f"[runner] tokens: no reading — {reason}", file=sys.stderr)
    if tok.get("session_id") is not None:
        print(f"[runner] session_id={tok['session_id']}", file=sys.stderr)
    else:
        reason = tok.get("session_reason") or "no session source"
        print(f"[runner] session: no handle — {reason}", file=sys.stderr)


def _forward_claude_text(stdout_text):
    """Forward the unwrapped claude result text to the lane's stdout.

    The envelope is NEVER streamed raw: the lane's stdout stays the model's
    answer (out.md / subagent capture / verification all see the text), and
    the raw envelope survives in the tee.
    """
    if stdout_text:
        sys.stdout.write(stdout_text)
        if not stdout_text.endswith("\n"):
            sys.stdout.write("\n")
        sys.stdout.flush()


