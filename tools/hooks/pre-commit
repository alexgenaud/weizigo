#!/bin/sh

# ── WEIZIGO_GITENV_ISOLATION (T771, 2026-08-24) ──────────────────────────
# git sets GIT_DIR (and friends) for hooks. This hook runs regression
# scripts, and 58 of them create scratch repos with `git init` while none
# unset GIT_DIR — so a scratch init could reinitialize THIS repository and
# leave core.worktree pointed at /tmp. That happened twice on 2026-08-24:
# every console's git then resolved against the wrong tree, commits
# truncated 2,556 files to 4, and the task store was overwritten with a
# stale snapshot. Unset the inherited git environment before running
# anything, so a child's `git init` cannot reach back into this repo.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_NAMESPACE
# ── end isolation ────────────────────────────────────────────────────────

# pre-commit hook for weizigo — two gates:
#   1. claimlint regressions against the recorded honest-debt floor, not
#      "green" (green is unreachable today) — T272, installed by T280.
#   2. staged-path subset backstop (T282): staged paths must be a subset of
#      the committing task's declared deliverables ∪ its findings files ∪ the
#      four shared surfaces (CURRENT.md, HANDOVER.md, CLAIMS.md,
#      rejections.json) — scope resolved by tools/git-commit-mine-lib.sh, the
#      SAME implementation the wrapper uses, so the two can never drift apart. Catches the T268
#      incident class (three absorptions on 2026-08-02) for anyone who
#      bypasses the wrapper.
#
#      Rulings (T282):
#        identity known (MANAGENT_TASK_ID set, set by bin/subagent) +
#          out-of-scope staged path  → REFUSE, naming the path
#        identity absent (human, court seat) → warn-and-allow, paths listed
#        identity set but unresolvable (kanban read failed / task absent)
#          → warn-and-allow, paths listed (identity unknown = unlabelled;
#          refusing would wedge a worker whose kanban is momentarily unreadable)
#        wrapper --explicit commit (GIT_MINE_EXPLICIT=1) → warn-and-allow,
#          paths listed (the wrapper took responsibility on the way in; see
#          the rationale in the branch below for why we do NOT also gate it
#          on holder-collision)
#        unlabelled commit (no MANAGENT_TASK_ID) + staged path currently
#          held by an in_progress row → REFUSE, naming the holding row +
#          its agent (T455; closes the gap the Orchestrator's `git add -A`
#          swept through on 2026-08-18, d7e4bdb). Unlabelled commits
#          touching nothing held stay allowed — that is the operator's
#          normal case and must not become ceremony.
#      MANAGENT_STORE is honored (scratch-kanban substrate isolation, e.g.
#      regression tests); default is <repo>/docs/infra/managent/tasks.json.
#
# Installed by: git config core.hooksPath tools/hooks
#
# Task: T272 · Role: worker · Model: deepseek-v4-pro · Date: 2026-08-02
# T282 backstop: 2026-08-03
# T455 holder-collision guard: 2026-08-19 — unlabelled commits that touch a
#   path held by an in_progress row are refused, with the holder named.
#   See findings/T455-unlabelled-commit-scope.json.

set -e

# CLAIMS_PATH: env var override for the claims register — set to run claimlint
# against a different register (e.g. a seeded copy in a regression test).
# Unset → claimlint reads its default CLAIMS.md.
CLAIMS_PATH="${CLAIMS_PATH:-}"
# FLOOR_FILE: env var override for the floor file.
FLOOR_FILE="${FLOOR_FILE:-tools/hooks/claimlint-floor.json}"
CLAIMLINT_BIN="bin/weizigo-claimlint"

# ── guard: can we run at all? ──────────────────────────────────────────
if ! command -v "$CLAIMLINT_BIN" >/dev/null 2>&1; then
    echo "pre-commit: $CLAIMLINT_BIN not found — blocking commit"
    echo "  build it: zig build && cp zig-out/bin/weizigo-claimlint bin/"
    exit 1
fi

if ! test -f "$FLOOR_FILE"; then
    echo "pre-commit: $FLOOR_FILE not found — blocking commit"
    exit 1
fi

# ── gate 2: staged-path subset backstop (T282) ─────────────────────────
# Runs before claimlint: it is cheaper and the refusal is the relevant one
# when a foreign path is staged. Scope resolution shares the wrapper's
# implementation (tools/git-commit-mine-lib.sh) — one copy of the parsing.
STAGED_PATHS=$(git diff --cached --name-only 2>/dev/null || true)
if [ -n "$STAGED_PATHS" ]; then
    list_staged() {
        echo "$STAGED_PATHS" | while IFS= read -r sp; do
            [ -n "$sp" ] && echo "pre-commit:     $sp"
        done
    }
    if [ -n "${MANAGENT_TASK_ID:-}" ] && [ "${GIT_MINE_EXPLICIT:-0}" != "1" ]; then
        ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
        LIB="$ROOT/tools/git-commit-mine-lib.sh"
        if [ ! -f "$LIB" ]; then
            echo "pre-commit: WARNING — $LIB missing; cannot verify staged paths against task scope. Staged paths:"
            list_staged
        else
            SCOPE_FILE=$(mktemp "${TMPDIR:-/tmp}/precommit-scope-XXXXXX" 2>/dev/null) || SCOPE_FILE=""
            if [ -z "$SCOPE_FILE" ]; then
                echo "pre-commit: WARNING — cannot create scope file; allowing. Staged paths:"
                list_staged
            else
                trap 'rm -f "$SCOPE_FILE"' EXIT
                if ! bash "$LIB" scope "$ROOT" "$MANAGENT_TASK_ID" "${MANAGENT_STORE:-}" > "$SCOPE_FILE" 2>/dev/null; then
                    echo "pre-commit: WARNING — MANAGENT_TASK_ID=$MANAGENT_TASK_ID set but its scope cannot be resolved; allowing with staged paths listed (identity unknown = unlabelled):"
                    list_staged
                else
                    VIOLATIONS=""
                    while IFS= read -r sp; do
                        [ -n "$sp" ] || continue
                        if ! grep -Fxq "$sp" "$SCOPE_FILE"; then
                            VIOLATIONS="${VIOLATIONS}${sp}
"
                        fi
                    done <<EOF
$STAGED_PATHS
EOF
                    if [ -n "$VIOLATIONS" ]; then
                        echo "pre-commit: REFUSED — staged paths outside the scope of task $MANAGENT_TASK_ID:"
                        echo "$VIOLATIONS" | while IFS= read -r vp; do
                            [ -n "$vp" ] && echo "pre-commit:   $vp"
                        done
                        echo "pre-commit:   Scope = the bundle's deliverables= plus findings/<id>-*.json plus"
                        echo "pre-commit:   docs/status/CURRENT.md, docs/status/HANDOVER.md,"
                        echo "pre-commit:   docs/epistemic/CLAIMS.md, findings/rejections.json (mirrors tools/git-commit-mine)."
                        echo "pre-commit:   This is the T268 incident class — do NOT unstage another console's work."
                        echo "pre-commit:   Commit through tools/git-commit-mine, or --no-verify only after reviewing"
                        echo "pre-commit:   the listed paths yourself."
                        exit 1
                    fi
                    echo "pre-commit: staged paths ⊆ scope of $MANAGENT_TASK_ID — allowed"
                fi
            fi
        fi
    else
        if [ "${GIT_MINE_EXPLICIT:-0}" = "1" ]; then
            # The wrapper's explicit-mode is by design the "I took
            # responsibility" channel (tools/git-commit-mine:267-272): when
            # the wrapper is used it has already refused/limited the commit
            # on the way in (T278 verified 2026-08-02). Adding a holder-
            # collision refusal here would re-refuse what the wrapper
            # already limited, and would not add coverage the unlabelled
            # branch doesn't already provide — so we keep warn-and-allow.
            # T455 finding, 2026-08-19.
            echo "pre-commit: WARNING — wrapper --explicit commit (GIT_MINE_EXPLICIT=1); scope not enforced (T455). Staged paths:"
        else
            # T455: unlabelled commit. Refuse if any staged path is held
            # by an in_progress row; the kanban already knows who holds
            # what. Touching nothing held stays allowed — the operator's
            # normal case must not become ceremony. If the store cannot
            # be read, fall back to today's warn-and-allow and say so.
            ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
            LIB="$ROOT/tools/git-commit-mine-lib.sh"
            HOLDERS_FILE=$(mktemp "${TMPDIR:-/tmp}/precommit-holders-XXXXXX" 2>/dev/null) || HOLDERS_FILE=""
            if [ -z "$LIB" ] || [ ! -f "$LIB" ] || [ -z "$HOLDERS_FILE" ]; then
                echo "pre-commit: WARNING — no task identity (MANAGENT_TASK_ID unset) and the holder table cannot be read; unlabelled commit allowed. Staged paths:"
                list_staged
            else
                # T540 item 3: capture the exit status of active-holders so the
                # hook can tell "store unreadable" (non-zero) from "store read,
                # zero holders" (0 + empty). `|| HOLDERS_RC=$?` keeps `set -e`
                # from aborting the hook on the non-zero case.
                HOLDERS_RC=0
                bash "$LIB" active-holders "$ROOT" "${MANAGENT_STORE:-}" > "$HOLDERS_FILE" 2>/dev/null || HOLDERS_RC=$?
                if [ "$HOLDERS_RC" -ne 0 ]; then
                    # T540 item 3: store unreadable — say so, don't conflate it
                    # with "no holders declared" (the two need different reads).
                    echo "pre-commit: WARNING — no task identity (MANAGENT_TASK_ID unset) and the holder table cannot be read (kanban unreadable); unlabelled commit allowed. Staged paths:"
                    list_staged
                elif [ ! -s "$HOLDERS_FILE" ]; then
                    # T540 item 3: store read, zero live holders declared — the
                    # ordinary no-holders case, distinct from an unreadable store.
                    echo "pre-commit: unlabelled commit, store read, no live holders declared — allowed. Staged paths:"
                    list_staged
                else
                    COLLISIONS=""
                    COLLIDING_TASKS=""
                    while IFS= read -r sp; do
                        [ -n "$sp" ] || continue
                        # HOLDERS_FILE: tab-separated <task-id>\t<agent>\t<path>
                        HIT=$(awk -F'\t' -v p="$sp" '$3 == p { print $1 "\t" $2; exit }' "$HOLDERS_FILE")
                        if [ -n "$HIT" ]; then
                            TID=${HIT%%	*}
                            AGENT=${HIT#*	}
                            COLLISIONS="${COLLISIONS}${sp}
"
                            COLLIDING_TASKS="${COLLIDING_TASKS}${sp}  (held by ${TID}, agent=${AGENT})
"
                        fi
                    done <<EOF
$STAGED_PATHS
EOF
                    if [ -n "$COLLISIONS" ]; then
                        echo "pre-commit: REFUSED — unlabelled commit (MANAGENT_TASK_ID unset) touches paths held by live task(s):"
                        echo "$COLLIDING_TASKS" | while IFS= read -r line; do
                            [ -n "$line" ] && echo "pre-commit:   $line"
                        done
                        echo "pre-commit:   This is the T455 / T268 incident class — name your work."
                        echo "pre-commit:   Export MANAGENT_TASK_ID=<your-id> (the dispatched-worker path),"
                        echo "pre-commit:   run via tools/git-commit-mine (the wrapper path-limited mode),"
                        echo "pre-commit:   or --no-verify only after reviewing the listed paths yourself."
                        exit 1
                    fi
                    # unlabelled + nothing held → allow silently. The
                    # operator's normal case must not become ceremony.
                    echo "pre-commit: unlabelled commit, no staged path held by any live row — allowed"
                fi
            fi
        fi
    fi
fi

# ── run claimlint ──────────────────────────────────────────────────────
# The exit code is captured WITHOUT `|| true` (which would swallow it and make
# the exit-3 parse-error check below dead code — a gate that cannot fire is
# worse than none). set -e is suspended for the capture only.
set +e
if [ -n "$CLAIMS_PATH" ]; then
    OUTPUT=$("$CLAIMLINT_BIN" "$CLAIMS_PATH" 2>&1)
else
    OUTPUT=$("$CLAIMLINT_BIN" 2>&1)
fi
CLAIMLINT_EXIT=$?
set -e

# ── claimlint cannot parse the register → block ────────────────────────
if [ "$CLAIMLINT_EXIT" -eq 3 ]; then
    echo "pre-commit: claimlint exited 3 (parse error) — blocking commit"
    echo "$OUTPUT"
    exit 1
fi

# ── calibration must pass ──────────────────────────────────────────────
CAL_LINE=$(echo "$OUTPUT" | grep '^  calibration:' || true)
if ! echo "$CAL_LINE" | grep -q 'PASS'; then
    echo "pre-commit: claimlint calibration FAILED — blocking commit"
    echo "$OUTPUT"
    exit 1
fi

# ── extract current counts from the summary ────────────────────────────
# Summary lines have variable-length labels, so we count from the end.
# C1a: "  C1a orphans / C1b alarms      10 / 0   (FAILS)" → $6=10, $8=0
# C2:  "  C2 dangling evidence paths    14   (FAILS)"      → $5=14
# C3:  "  C3 PROVEN w/o committed evid. 48   (debt...)"     → $6=48 — gated by
#      the C3 ratchet floor (T373): report-only at the claimlint level, the
#      floor lives here in the hook, exactly like C1a/C2/C6/C9.
# C6:  "  C6 cite-tag mismatches         0   (FAILS)"      → $4=0
# C7nc: the non-conforming count is computed SEPARATELY below, scoped to
#       the staged findings files (T710) — the repo-wide summary line no
#       longer feeds the floor (a sibling lane's working-tree file must
#       not trip this commit's gate; KD-12).
SUMMARY_LINE=$(echo "$OUTPUT" | grep '^  C1a orphans / C1b alarms' | grep 'FAILS')
CURRENT_C1a=$(echo "$SUMMARY_LINE" | awk '{print $6}')
CURRENT_C1b=$(echo "$SUMMARY_LINE" | awk '{print $8}')
CURRENT_C2=$(echo "$OUTPUT" | grep '^  C2 dangling evidence paths' | grep 'FAILS' | awk '{print $5}')
CURRENT_C3=$(echo "$OUTPUT" | grep '^  C3 PROVEN w/o committed evid.' | awk '{print $6}')
CURRENT_C6=$(echo "$OUTPUT" | grep '^  C6 cite-tag mismatches' | grep 'FAILS' | awk '{print $4}')
CURRENT_C9=$(echo "$OUTPUT" | grep '^  C9 tree-mapping violations' | grep 'FAILS' | awk '{print $4}')

# ── read floor ─────────────────────────────────────────────────────────
# Uses python3 for reliable JSON parsing (available on all dev hosts)
read_floor_field() {
    python3 -c "import json; d=json.load(open('$FLOOR_FILE')); print(d['floor']['$1'])" 2>/dev/null || echo "PARSE_ERROR"
}

FLOOR_C1a=$(read_floor_field "C1a")
FLOOR_C1b=$(read_floor_field "C1b")
FLOOR_C2=$(read_floor_field "C2")
FLOOR_C3=$(read_floor_field "C3")
FLOOR_C6=$(read_floor_field "C6")
FLOOR_C9=$(read_floor_field "C9")
FLOOR_C7NONCONF=$(read_floor_field "C7-nonconforming")

# ── guard: floor file parseable ────────────────────────────────────────
for val in "$FLOOR_C1a" "$FLOOR_C1b" "$FLOOR_C2" "$FLOOR_C3" "$FLOOR_C6" "$FLOOR_C9" "$FLOOR_C7NONCONF"; do
    if [ "$val" = "PARSE_ERROR" ]; then
        echo "pre-commit: cannot parse $FLOOR_FILE — blocking commit"
        exit 1
    fi
done

# ── C7 scope: committing-path findings only (T710) ─────────────────────
# The C7-nonconforming floor gates only the findings files THIS commit
# stages, not the whole findings/ tree. KD-12: a sibling lane's malformed
# findings file tripped the shared floor and blocked the whole fleet during
# a race. Build a scope file from the staged findings paths and ask
# claimlint's `c7` verb for the scoped count.
C7_SCOPE_FILE=$(mktemp "${TMPDIR:-/tmp}/precommit-c7scope-XXXXXX" 2>/dev/null) || C7_SCOPE_FILE=""
STAGED_FINDINGS=0
if [ -n "$C7_SCOPE_FILE" ] && [ -n "$STAGED_PATHS" ]; then
    echo "$STAGED_PATHS" | while IFS= read -r sp; do
        case "$sp" in
            findings/*.json)
                [ "$sp" = "findings/rejections.json" ] && continue
                echo "$sp"
                ;;
        esac
    done > "$C7_SCOPE_FILE"
    STAGED_FINDINGS=$(wc -l < "$C7_SCOPE_FILE" 2>/dev/null | tr -d ' ')
    [ -n "$STAGED_FINDINGS" ] || STAGED_FINDINGS=0
fi

if [ "$STAGED_FINDINGS" -gt 0 ]; then
    set +e
    if [ -n "$CLAIMS_PATH" ]; then
        SCOPED_C7_OUTPUT=$("$CLAIMLINT_BIN" c7 "$CLAIMS_PATH" --findings-scope-file "$C7_SCOPE_FILE" 2>&1)
    else
        SCOPED_C7_OUTPUT=$("$CLAIMLINT_BIN" c7 --findings-scope-file "$C7_SCOPE_FILE" 2>&1)
    fi
    set -e
    CURRENT_C7NONCONF=$(echo "$SCOPED_C7_OUTPUT" | grep '^  non-conforming:' | sed 's/.*non-conforming: *//' | awk '{print $1}')
else
    CURRENT_C7NONCONF=0
fi
[ -n "$C7_SCOPE_FILE" ] && rm -f "$C7_SCOPE_FILE"

# ── compare — block on regression ──────────────────────────────────────
regression() {
    metric="$1"
    current="$2"
    floor="$3"
    if [ -z "$current" ]; then
        echo "pre-commit: could not parse current $metric from claimlint output — blocking commit"
        echo "$OUTPUT"
        exit 1
    fi
    if [ "$current" -gt "$floor" ]; then
        echo "pre-commit: $metric regressed: $current > floor $floor — blocking commit"
        echo "$OUTPUT"
        exit 1
    fi
}

regression "C1a" "$CURRENT_C1a" "$FLOOR_C1a"
regression "C1b" "$CURRENT_C1b" "$FLOOR_C1b"
regression "C2"  "$CURRENT_C2"  "$FLOOR_C2"
regression "C3"  "$CURRENT_C3"  "$FLOOR_C3"
regression "C6"  "$CURRENT_C6"  "$FLOOR_C6"
regression "C9"  "$CURRENT_C9"  "$FLOOR_C9"
regression "C7-nonconforming" "$CURRENT_C7NONCONF" "$FLOOR_C7NONCONF"

# ── gate 3: fast test tier (T789, 2026-08-23) ─────────────────────────
# The operator's tier ruling: pre-commit carries fast, deterministic,
# host-insensitive checks only. Budget and measurements live HERE so the
# file that implements the gate states them:
#
#   budget:   FAST_BUDGET_WALL_SECS=45 — a gate that takes minutes gets
#             bypassed. The hook measures its own elapsed wall and WARNS
#             loudly when it exceeds the budget (tests that passed must not
#             block a commit just because the host is busy); the budget is
#             the design-time cap on what may be added to the pool, and the
#             warning is the runtime census of drift.
#   per-script: PER_SCRIPT_WALL_SECS=60, enforced by tools/runner (the
#             project's only reliable time backstop on macOS — no timeout(1)).
#   measured 2026-08-23 under load (T789; upper bounds): smoke.sh 1s
#             (T788) · claimlint-output 2s · c7-json 1s · c7-scope 1s ·
#             promotion 1s · volatile 2s · orient 1s ·
#             directive-id-uniqueness 1s · directive-integrity 1s ·
#             managent-models 1s · managent-landmark 14s · suite-surfaces
#             6s · canonicalizer-parity 1s → ~33s at load 6-8, ~15-25s
#             on a quiet host.
#   selection: a test with no declared coverage always runs (unknown
#             coverage is not empty coverage); a test that declares
#             coverage in the T790 module contract
#             (docs/epics/E1-markovian/L1-dashboard/S09-module-test-contract/spec.md)
#             runs when the staged diff touches a covered module. Selection
#             is additive to the periodic full run, never a replacement —
#             the nightly is what catches a selector bug.
#   state-dependent checks are NOT here (T788): regression-argus-doctor
#             (T442), regression-managent-integrity and
#             regression-git-commit-mine (deploy-hygiene) live in the
#             full-suite tier where their state is measured.
#   bypass:   TEST_GATE_BYPASS=<reason> — loud, appended to
#             untracked/log/precommit-test-gate-bypass.log; an EMPTY reason
#             is refused. (git commit --no-verify cannot be intercepted from
#             a pre-commit hook; the reasoned channel exists so the
#             responsible path is available.)
#   surface:  the nightly/scheduled suite verdict is printed on every
#             commit (a red is visible without being asked), read from the
#             result file suite-truth.sh --scheduled writes. Non-blocking:
#             a red suite blocks a consolidation pass, not unrelated work.
#
# Task: T789 · Role: worker · Model: deepseek-v4-flash · Date: 2026-08-23

TG_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")"
FAST_BUDGET_WALL_SECS="${TEST_GATE_BUDGET_SECS:-45}"
PER_SCRIPT_WALL_SECS="${TEST_GATE_SCRIPT_WALL_SECS:-60}"
INTERVAL_HOURS="${TEST_GATE_INTERVAL_HOURS:-26}"
CONTRACT_PATH="${TEST_GATE_CONTRACT:-docs/epics/E1-markovian/L1-dashboard/S09-module-test-contract/spec.md}"
RESULT_PATH="$TG_ROOT/untracked/test-gate/last-result.json"
BYPASS_LOG="$TG_ROOT/untracked/log/precommit-test-gate-bypass.log"
FAST_POOL="tools/smoke.sh
tools/regression-claimlint-output.sh
tools/regression-claimlint-c7-json.sh
tools/regression-claimlint-c7-scope.sh
tools/regression-claimlint-promotion.sh
tools/regression-claimlint-volatile.sh
tools/regression-orient.sh
tools/regression-directive-id-uniqueness.sh
tools/regression-directive-integrity.sh
tools/regression-managent-models.sh
tools/regression-managent-landmark.sh
tools/regression-suite-surfaces.sh
tools/regression-canonicalizer-parity.sh"

TEST_GATE_PASS=1
TEST_GATE_NOTE=""

if [ "${TEST_GATE_BYPASS+x}" = "x" ]; then
    if [ -z "$TEST_GATE_BYPASS" ]; then
        echo "pre-commit: REFUSED — TEST_GATE_BYPASS is set but EMPTY; a bypass demands a reason."
        echo "pre-commit:   Set TEST_GATE_BYPASS=<why you are skipping the fast tier> and commit again (the reason is recorded)."
        exit 1
    fi
    mkdir -p "$(dirname "$BYPASS_LOG")" 2>/dev/null || true
    BYPASS_HEAD=$(git rev-parse --short HEAD 2>/dev/null || echo "?")
    printf '%s\n' "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] task=${MANAGENT_TASK_ID:-unlabelled} head=$BYPASS_HEAD reason=$TEST_GATE_BYPASS" >> "$BYPASS_LOG" 2>/dev/null || true
    echo "pre-commit: TEST GATE BYPASSED — reason: $TEST_GATE_BYPASS (recorded in $BYPASS_LOG)"
    TEST_GATE_PASS=1
    TEST_GATE_NOTE="bypassed with recorded reason"
else
    # ── surface the nightly/scheduled suite verdict (non-blocking) ──
    if [ -f "$TG_ROOT/tools/suite-truth.sh" ]; then
        set +e
        SURFACE_OUT=$(sh "$TG_ROOT/tools/suite-truth.sh" --read-result --result "$RESULT_PATH" --interval-hours "$INTERVAL_HOURS" 2>&1)
        SURFACE_RC=$?
        set -e
        echo "pre-commit: $SURFACE_OUT"
        if [ "$SURFACE_RC" -eq 1 ]; then
            echo "pre-commit:   (full-suite gate RED — not blocking this commit; a red suite blocks a consolidation pass, not unrelated work, and the red is on record)"
        fi
    fi

    # ── test-surface presence ──
    if [ ! -f "$TG_ROOT/build.zig" ]; then
        echo "pre-commit: test gate skipped — no build.zig (fixture/scratch environment; the claimlint + scope gates above still ran)"
        TEST_GATE_PASS=1
        TEST_GATE_NOTE="skipped (fixture env)"
    elif [ ! -x "$TG_ROOT/tools/smoke.sh" ]; then
        echo "pre-commit: REFUSED — tools/smoke.sh missing in a weizigo tree; the fast tier cannot run."
        echo "pre-commit:   Restore it, or bypass deliberately with a recorded reason: TEST_GATE_BYPASS=<reason> git commit"
        exit 1
    elif ! command -v zig >/dev/null 2>&1; then
        echo "pre-commit: REFUSED — zig not on PATH; the fast tier cannot run (same rule as the claimlint gate: a gate that cannot run is a gate that is not there)."
        echo "pre-commit:   Bypass deliberately with a recorded reason: TEST_GATE_BYPASS=<reason> git commit"
        exit 1
    else
        # ── change-based selection ──
        case "$CONTRACT_PATH" in
          /*) CONTRACT="$CONTRACT_PATH" ;;
          *) CONTRACT="$TG_ROOT/$CONTRACT_PATH" ;;
        esac
        if [ -f "$CONTRACT" ]; then
            echo "pre-commit: module contract present ($CONTRACT_PATH) — change-based selection active"
        else
            CONTRACT=""
            echo "pre-commit: no module contract yet (T790 in progress) — no declared coverage, so the whole fast pool runs (unknown coverage is not empty coverage)"
        fi
        SELECTED=""
        SKIPPED_BY_COVERAGE=""
        while IFS= read -r script; do
            [ -n "$script" ] || continue
            run_it=1
            if [ -n "$CONTRACT" ]; then
                COVERAGE=$(grep -E "^test ${script} covers " "$CONTRACT" 2>/dev/null | sed -E "s|^test ${script} covers ||" | tr ' ' '\n' | grep -v '^$' || true)
                if [ -n "$COVERAGE" ]; then
                    run_it=0
                    for mod in $COVERAGE; do
                        if printf '%s\n' "$STAGED_PATHS" | grep -Fxq "$mod"; then run_it=1; break; fi
                    done
                    if [ "$run_it" -eq 0 ]; then
                        SKIPPED_BY_COVERAGE="${SKIPPED_BY_COVERAGE}${script} "
                        continue
                    fi
                fi
            fi
            SELECTED="${SELECTED}${script}
"
        done <<EOF
$FAST_POOL
EOF
        if [ -n "$SKIPPED_BY_COVERAGE" ]; then
            echo "pre-commit: skipped by declared coverage (no staged change touches a covered module): $SKIPPED_BY_COVERAGE"
        fi
        [ -n "$SELECTED" ] || SELECTED="$FAST_POOL"

        # ── run the selection, guarded per-script ──
        TG_START=$(date +%s)
        while IFS= read -r script; do
            [ -n "$script" ] || continue
            set +e
            SCRIPT_OUT=$("$TG_ROOT/tools/runner" --max-wall "$PER_SCRIPT_WALL_SECS" -- sh "$TG_ROOT/$script" 2>&1)
            SCRIPT_RC=$?
            set -e
            if [ "$SCRIPT_RC" -eq 0 ]; then
                echo "pre-commit:   PASS $script"
            else
                echo "pre-commit:   FAIL $script (exit $SCRIPT_RC):"
                printf '%s\n' "$SCRIPT_OUT" | tail -15 | sed 's/^/pre-commit:       /'
                TEST_GATE_PASS=0
            fi
        done <<EOF
$SELECTED
EOF
        TG_ELAPSED=$(( $(date +%s) - TG_START ))
        echo "pre-commit: fast tier elapsed ${TG_ELAPSED}s (budget ${FAST_BUDGET_WALL_SECS}s)"
        if [ "$TG_ELAPSED" -gt "$FAST_BUDGET_WALL_SECS" ]; then
            echo "pre-commit: WARNING — the fast tier took ${TG_ELAPSED}s, over the ${FAST_BUDGET_WALL_SECS}s budget (busy host? a pool script got slow?). Tests PASSED — the commit proceeds — but the overrun is on record; investigate before adding anything to the pool."
        fi
        if [ "$TEST_GATE_PASS" -eq 1 ]; then
            TEST_GATE_NOTE="PASS (${TG_ELAPSED}s, budget ${FAST_BUDGET_WALL_SECS}s)"
        else
            echo "pre-commit: REFUSED — the fast test tier failed (above). Fix the failing check(s), or bypass deliberately with a recorded reason:"
            echo "pre-commit:   TEST_GATE_BYPASS=<reason> git commit"
            exit 1
        fi
    fi
fi

# ── all clear ──────────────────────────────────────────────────────────
if [ "$TEST_GATE_PASS" -eq 1 ]; then
    echo "pre-commit: claimlint C1a=$CURRENT_C1a C1b=$CURRENT_C1b C2=$CURRENT_C2 C3=$CURRENT_C3 C6=$CURRENT_C6 C9=$CURRENT_C9 C7-nonconforming=$CURRENT_C7NONCONF — ≤ floor, allowed · test gate: $TEST_GATE_NOTE"
else
    echo "pre-commit: claimlint C1a=$CURRENT_C1a C1b=$CURRENT_C1b C2=$CURRENT_C2 C3=$CURRENT_C3 C6=$CURRENT_C6 C9=$CURRENT_C9 C7-nonconforming=$CURRENT_C7NONCONF — ≤ floor, allowed · test gate: FAILED"
fi
exit 0
