#!/bin/sh
# pre-commit hook for weizigo — two gates:
#   1. claimlint regressions against the recorded honest-debt floor, not
#      "green" (green is unreachable today) — T272, installed by T280.
#   2. staged-path subset backstop (T282): staged paths must be a subset of
#      the committing task's declared deliverables ∪ its findings files ∪ the
#      two fleet-coordination surfaces (CURRENT.md, HANDOVER.md) — scope
#      resolved by tools/git-commit-mine-lib.sh, the SAME implementation the
#      wrapper uses, so the two can never drift apart. Catches the T268
#      incident class (three absorptions on 2026-08-02) for anyone who
#      bypasses the wrapper.
#
#      Rulings (T282):
#        identity known (MANAGENT_TASK_ID set, set by bin/subagent) +
#          out-of-scope staged path  → REFUSE, naming the path
#        identity absent (human, court seat) → warn-and-allow, paths listed
#        identity set but unresolvable (kanban read failed / task absent)
#          → warn-and-allow, paths listed (identity unknown = unlabelled;
#          refusing would wedge a worker whose kanban is momentarily unreadable)
#        wrapper --explicit commit (GIT_MINE_EXPLICIT=1) → warn-and-allow,
#          paths listed (the wrapper took responsibility on the way in; see
#          the rationale in the branch below for why we do NOT also gate it
#          on holder-collision)
#        unlabelled commit (no MANAGENT_TASK_ID) + staged path currently
#          held by an in_progress row → REFUSE, naming the holding row +
#          its agent (T455; closes the gap the Orchestrator's `git add -A`
#          swept through on 2026-08-18, d7e4bdb). Unlabelled commits
#          touching nothing held stay allowed — that is the operator's
#          normal case and must not become ceremony.
#      MANAGENT_STORE is honored (scratch-kanban substrate isolation, e.g.
#      regression tests); default is <repo>/docs/infra/managent/tasks.json.
#
# Installed by: git config core.hooksPath tools/hooks
#
# Task: T272 · Role: worker · Model: deepseek-v4-pro · Date: 2026-08-02
# T282 backstop: 2026-08-03
# T455 holder-collision guard: 2026-08-19 — unlabelled commits that touch a
#   path held by an in_progress row are refused, with the holder named.
#   See findings/T455-unlabelled-commit-scope.json.

set -e

# CLAIMS_PATH: env var override for the claims register — set to run claimlint
# against a different register (e.g. a seeded copy in a regression test).
# Unset → claimlint reads its default CLAIMS.md.
CLAIMS_PATH="${CLAIMS_PATH:-}"
# FLOOR_FILE: env var override for the floor file.
FLOOR_FILE="${FLOOR_FILE:-tools/hooks/claimlint-floor.json}"
CLAIMLINT_BIN="bin/weizigo-claimlint"

# ── guard: can we run at all? ──────────────────────────────────────────
if ! command -v "$CLAIMLINT_BIN" >/dev/null 2>&1; then
    echo "pre-commit: $CLAIMLINT_BIN not found — blocking commit"
    echo "  build it: zig build && cp zig-out/bin/weizigo-claimlint bin/"
    exit 1
fi

if ! test -f "$FLOOR_FILE"; then
    echo "pre-commit: $FLOOR_FILE not found — blocking commit"
    exit 1
fi

# ── gate 2: staged-path subset backstop (T282) ─────────────────────────
# Runs before claimlint: it is cheaper and the refusal is the relevant one
# when a foreign path is staged. Scope resolution shares the wrapper's
# implementation (tools/git-commit-mine-lib.sh) — one copy of the parsing.
STAGED_PATHS=$(git diff --cached --name-only 2>/dev/null || true)
if [ -n "$STAGED_PATHS" ]; then
    list_staged() {
        echo "$STAGED_PATHS" | while IFS= read -r sp; do
            [ -n "$sp" ] && echo "pre-commit:     $sp"
        done
    }
    if [ -n "${MANAGENT_TASK_ID:-}" ] && [ "${GIT_MINE_EXPLICIT:-0}" != "1" ]; then
        ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
        LIB="$ROOT/tools/git-commit-mine-lib.sh"
        if [ ! -f "$LIB" ]; then
            echo "pre-commit: WARNING — $LIB missing; cannot verify staged paths against task scope. Staged paths:"
            list_staged
        else
            SCOPE_FILE=$(mktemp "${TMPDIR:-/tmp}/precommit-scope-XXXXXX" 2>/dev/null) || SCOPE_FILE=""
            if [ -z "$SCOPE_FILE" ]; then
                echo "pre-commit: WARNING — cannot create scope file; allowing. Staged paths:"
                list_staged
            else
                trap 'rm -f "$SCOPE_FILE"' EXIT
                if ! bash "$LIB" scope "$ROOT" "$MANAGENT_TASK_ID" "${MANAGENT_STORE:-}" > "$SCOPE_FILE" 2>/dev/null; then
                    echo "pre-commit: WARNING — MANAGENT_TASK_ID=$MANAGENT_TASK_ID set but its scope cannot be resolved; allowing with staged paths listed (identity unknown = unlabelled):"
                    list_staged
                else
                    VIOLATIONS=""
                    while IFS= read -r sp; do
                        [ -n "$sp" ] || continue
                        if ! grep -Fxq "$sp" "$SCOPE_FILE"; then
                            VIOLATIONS="${VIOLATIONS}${sp}
"
                        fi
                    done <<EOF
$STAGED_PATHS
EOF
                    if [ -n "$VIOLATIONS" ]; then
                        echo "pre-commit: REFUSED — staged paths outside the scope of task $MANAGENT_TASK_ID:"
                        echo "$VIOLATIONS" | while IFS= read -r vp; do
                            [ -n "$vp" ] && echo "pre-commit:   $vp"
                        done
                        echo "pre-commit:   Scope = the bundle's deliverables= plus findings/<id>-*.json plus"
                        echo "pre-commit:   docs/status/CURRENT.md, docs/status/HANDOVER.md (mirrors tools/git-commit-mine)."
                        echo "pre-commit:   This is the T268 incident class — do NOT unstage another console's work."
                        echo "pre-commit:   Commit through tools/git-commit-mine, or --no-verify only after reviewing"
                        echo "pre-commit:   the listed paths yourself."
                        exit 1
                    fi
                    echo "pre-commit: staged paths ⊆ scope of $MANAGENT_TASK_ID — allowed"
                fi
            fi
        fi
    else
        if [ "${GIT_MINE_EXPLICIT:-0}" = "1" ]; then
            # The wrapper's explicit-mode is by design the "I took
            # responsibility" channel (tools/git-commit-mine:267-272): when
            # the wrapper is used it has already refused/limited the commit
            # on the way in (T278 verified 2026-08-02). Adding a holder-
            # collision refusal here would re-refuse what the wrapper
            # already limited, and would not add coverage the unlabelled
            # branch doesn't already provide — so we keep warn-and-allow.
            # T455 finding, 2026-08-19.
            echo "pre-commit: WARNING — wrapper --explicit commit (GIT_MINE_EXPLICIT=1); scope not enforced (T455). Staged paths:"
        else
            # T455: unlabelled commit. Refuse if any staged path is held
            # by an in_progress row; the kanban already knows who holds
            # what. Touching nothing held stays allowed — the operator's
            # normal case must not become ceremony. If the store cannot
            # be read, fall back to today's warn-and-allow and say so.
            ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
            LIB="$ROOT/tools/git-commit-mine-lib.sh"
            HOLDERS_FILE=$(mktemp "${TMPDIR:-/tmp}/precommit-holders-XXXXXX" 2>/dev/null) || HOLDERS_FILE=""
            if [ -z "$LIB" ] || [ ! -f "$LIB" ] || [ -z "$HOLDERS_FILE" ]; then
                echo "pre-commit: WARNING — no task identity (MANAGENT_TASK_ID unset) and the holder table cannot be read; unlabelled commit allowed. Staged paths:"
                list_staged
            else
                bash "$LIB" active-holders "$ROOT" "${MANAGENT_STORE:-}" > "$HOLDERS_FILE" 2>/dev/null || true
                if [ ! -s "$HOLDERS_FILE" ]; then
                    echo "pre-commit: WARNING — no task identity (MANAGENT_TASK_ID unset) and no live holders known (kanban unreadable or empty); unlabelled commit allowed. Staged paths:"
                    list_staged
                else
                    COLLISIONS=""
                    COLLIDING_TASKS=""
                    while IFS= read -r sp; do
                        [ -n "$sp" ] || continue
                        # HOLDERS_FILE: tab-separated <task-id>\t<agent>\t<path>
                        HIT=$(awk -F'\t' -v p="$sp" '$3 == p { print $1 "\t" $2; exit }' "$HOLDERS_FILE")
                        if [ -n "$HIT" ]; then
                            TID=${HIT%%	*}
                            AGENT=${HIT#*	}
                            COLLISIONS="${COLLISIONS}${sp}
"
                            COLLIDING_TASKS="${COLLIDING_TASKS}${sp}  (held by ${TID}, agent=${AGENT})
"
                        fi
                    done <<EOF
$STAGED_PATHS
EOF
                    if [ -n "$COLLISIONS" ]; then
                        echo "pre-commit: REFUSED — unlabelled commit (MANAGENT_TASK_ID unset) touches paths held by live task(s):"
                        echo "$COLLIDING_TASKS" | while IFS= read -r line; do
                            [ -n "$line" ] && echo "pre-commit:   $line"
                        done
                        echo "pre-commit:   This is the T455 / T268 incident class — name your work."
                        echo "pre-commit:   Export MANAGENT_TASK_ID=<your-id> (the dispatched-worker path),"
                        echo "pre-commit:   run via tools/git-commit-mine (the wrapper path-limited mode),"
                        echo "pre-commit:   or --no-verify only after reviewing the listed paths yourself."
                        exit 1
                    fi
                    # unlabelled + nothing held → allow silently. The
                    # operator's normal case must not become ceremony.
                    echo "pre-commit: unlabelled commit, no staged path held by any live row — allowed"
                fi
            fi
        fi
    fi
fi

# ── run claimlint ──────────────────────────────────────────────────────
# The exit code is captured WITHOUT `|| true` (which would swallow it and make
# the exit-3 parse-error check below dead code — a gate that cannot fire is
# worse than none). set -e is suspended for the capture only.
set +e
if [ -n "$CLAIMS_PATH" ]; then
    OUTPUT=$("$CLAIMLINT_BIN" "$CLAIMS_PATH" 2>&1)
else
    OUTPUT=$("$CLAIMLINT_BIN" 2>&1)
fi
CLAIMLINT_EXIT=$?
set -e

# ── claimlint cannot parse the register → block ────────────────────────
if [ "$CLAIMLINT_EXIT" -eq 3 ]; then
    echo "pre-commit: claimlint exited 3 (parse error) — blocking commit"
    echo "$OUTPUT"
    exit 1
fi

# ── calibration must pass ──────────────────────────────────────────────
CAL_LINE=$(echo "$OUTPUT" | grep '^  calibration:' || true)
if ! echo "$CAL_LINE" | grep -q 'PASS'; then
    echo "pre-commit: claimlint calibration FAILED — blocking commit"
    echo "$OUTPUT"
    exit 1
fi

# ── extract current counts from the summary ────────────────────────────
# Summary lines have variable-length labels, so we count from the end.
# C1a: "  C1a orphans / C1b alarms      10 / 0   (FAILS)" → $6=10, $8=0
# C2:  "  C2 dangling evidence paths    14   (FAILS)"      → $5=14
# C3:  "  C3 PROVEN w/o committed evid. 48   (debt...)"     → $6=48 — gated by
#      the C3 ratchet floor (T373): report-only at the claimlint level, the
#      floor lives here in the hook, exactly like C1a/C2/C6/C9.
# C6:  "  C6 cite-tag mismatches         0   (FAILS)"      → $4=0
SUMMARY_LINE=$(echo "$OUTPUT" | grep '^  C1a orphans / C1b alarms' | grep 'FAILS')
CURRENT_C1a=$(echo "$SUMMARY_LINE" | awk '{print $6}')
CURRENT_C1b=$(echo "$SUMMARY_LINE" | awk '{print $8}')
CURRENT_C2=$(echo "$OUTPUT" | grep '^  C2 dangling evidence paths' | grep 'FAILS' | awk '{print $5}')
CURRENT_C3=$(echo "$OUTPUT" | grep '^  C3 PROVEN w/o committed evid.' | awk '{print $6}')
CURRENT_C6=$(echo "$OUTPUT" | grep '^  C6 cite-tag mismatches' | grep 'FAILS' | awk '{print $4}')
CURRENT_C9=$(echo "$OUTPUT" | grep '^  C9 tree-mapping violations' | grep 'FAILS' | awk '{print $4}')

# ── read floor ─────────────────────────────────────────────────────────
# Uses python3 for reliable JSON parsing (available on all dev hosts)
read_floor_field() {
    python3 -c "import json; d=json.load(open('$FLOOR_FILE')); print(d['floor']['$1'])" 2>/dev/null || echo "PARSE_ERROR"
}

FLOOR_C1a=$(read_floor_field "C1a")
FLOOR_C1b=$(read_floor_field "C1b")
FLOOR_C2=$(read_floor_field "C2")
FLOOR_C3=$(read_floor_field "C3")
FLOOR_C6=$(read_floor_field "C6")
FLOOR_C9=$(read_floor_field "C9")

# ── guard: floor file parseable ────────────────────────────────────────
for val in "$FLOOR_C1a" "$FLOOR_C1b" "$FLOOR_C2" "$FLOOR_C3" "$FLOOR_C6" "$FLOOR_C9"; do
    if [ "$val" = "PARSE_ERROR" ]; then
        echo "pre-commit: cannot parse $FLOOR_FILE — blocking commit"
        exit 1
    fi
done

# ── compare — block on regression ──────────────────────────────────────
regression() {
    metric="$1"
    current="$2"
    floor="$3"
    if [ -z "$current" ]; then
        echo "pre-commit: could not parse current $metric from claimlint output — blocking commit"
        echo "$OUTPUT"
        exit 1
    fi
    if [ "$current" -gt "$floor" ]; then
        echo "pre-commit: $metric regressed: $current > floor $floor — blocking commit"
        echo "$OUTPUT"
        exit 1
    fi
}

regression "C1a" "$CURRENT_C1a" "$FLOOR_C1a"
regression "C1b" "$CURRENT_C1b" "$FLOOR_C1b"
regression "C2"  "$CURRENT_C2"  "$FLOOR_C2"
regression "C3"  "$CURRENT_C3"  "$FLOOR_C3"
regression "C6"  "$CURRENT_C6"  "$FLOOR_C6"
regression "C9"  "$CURRENT_C9"  "$FLOOR_C9"

# ── all clear ──────────────────────────────────────────────────────────
echo "pre-commit: claimlint C1a=$CURRENT_C1a C1b=$CURRENT_C1b C2=$CURRENT_C2 C3=$CURRENT_C3 C6=$CURRENT_C6 C9=$CURRENT_C9 — ≤ floor, allowed"
exit 0
