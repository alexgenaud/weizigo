#!/usr/bin/env bash

# ── WEIZIGO_WORKTREE_GUARD (T771, 2026-08-24) ────────────────────────────
# A worker repointed the whole repository twice in thirty minutes by leaving
# core.worktree set to its scratch directory; every console's git then
# resolved paths against the wrong tree, commits truncated 2,556 files to 4,
# and the task store was silently overwritten with a stale snapshot. That is
# the mechanism behind the recurring "tasks vanished" incidents.
# Two cheap invariants, checked before anything is staged:
#   1. the repo must point at itself;
#   2. a commit must not shrink the tree by more than the paths it names.
_wz_guard() {
    local wt; wt=$(git config --get core.worktree 2>/dev/null || true)
    if [ -n "$wt" ]; then
        echo "git-commit-mine: REFUSED — core.worktree is set to '$wt'." >&2
        echo "  The repository is pointed at another directory; committing now would" >&2
        echo "  write against the wrong tree. Run: git config --unset core.worktree" >&2
        echo "  then verify 'git rev-parse --show-toplevel' before retrying." >&2
        return 1
    fi
    local before; before=$(git ls-tree -r --name-only HEAD 2>/dev/null | wc -l | tr -d " ")
    if [ "${before:-0}" -lt 2000 ]; then
        echo "git-commit-mine: REFUSED — HEAD holds only ${before} files." >&2
        echo "  A healthy tree here is >2000. HEAD is truncated; do not commit onto it." >&2
        echo "  Find the newest intact commit and reset the branch to it first." >&2
        return 1
    fi
    return 0
}
_wz_guard || exit 1
# ── end guard ────────────────────────────────────────────────────────────

# git-commit-mine — path-limited commit wrapper for the shared-index fleet (T278)
#
# Every console shares one .git/index. `git add -A` / `git commit` stage and
# commit whatever another console has staged, and it lands in your commit under
# your message. That happened three times on 2026-08-02 (T268 absorbed T272's
# staged claimlint work; the Orchestrator's `git add -A docs/` swept T266's
# evidence into 91f7cf3). This wrapper is the mechanism that makes the hazard
# structurally impossible at the commit site:
#
#   1. refuses a pathless invocation (the "add -A then commit" habit);
#   2. stages ONLY the named paths, verifies the staged set contains nothing
#      outside (your declared scope ∪ the named paths), and refuses otherwise,
#      naming the foreign paths — T268's exact incident is the seeded fixture;
#   3. commits with plain `git commit` only after the index has been verified;
#   4. verifies the resulting commit contains exactly the named paths — and
#      distinguishes the three cases (T282 defect 1): path committed by THIS
#      invocation; path already committed and unchanged (a healthy no-op,
#      reported as such, NOT a failure); path genuinely missing (a real
#      failure). A wrapper that cries failure on a healthy commit trains
#      people to ignore it.
#
# Identity (who is committing, and therefore what scope) resolves from, in
# order: `--task <id>`, `--bundle <file>`, $MANAGENT_TASK_ID. Without identity
# the scope check cannot run — the wrapper then requires `--explicit` (or warns
# and treats the named paths themselves as the scope; the Orchestrator's
# cross-cutting integration commits are the designed user of this mode).
#
# Scope for a task = its bundle's `deliverables=` meta header, plus its own
# findings files (findings/<id>-*.json), plus the two fleet-coordination
# surfaces any worker may legitimately touch (docs/status/CURRENT.md,
# docs/status/HANDOVER.md), plus the two absorption surfaces the closer edits
# inside its own commit (docs/epistemic/CLAIMS.md, findings/rejections.json) —
# T484. Scope resolution lives in tools/git-commit-mine-lib.sh, shared with
# the pre-commit backstop (T282) — one implementation, two callers.
#
# Explicit-mode commits export GIT_MINE_EXPLICIT=1 so the pre-commit backstop
# treats them as the wrapper-took-responsibility case (warn-and-allow), not a
# scope violation — the wrapper already refused/limited the commit on the way in.
#
# Usage:
#   tools/git-commit-mine <paths...> -m <message> [--task <id> | --bundle <f> | --explicit]
#
# Task: T278 · Role: worker · Model: deepseek-v4-flash · Date: 2026-08-02 (T282 follow-up 2026-08-03)
# T454: when TASK_ID comes from $MANAGENT_TASK_ID (env fallback) and the local
# kanban at $REPO/docs/infra/managent/tasks.json doesn't carry it, treat the
# call as unlabelled and warn — don't refuse. The fleet's normal path is
# MANAGENT_TASK_ID == <worker's current task> in the LIVE repo; a regression
# harness invoking the wrapper from a SCRATCH repo with the parent's env
# otherwise resolves a bogus id, refuses every arm, and the suite goes red
# for a property the harness itself caused (T369's run-2 measurement was
# exactly this shape — 6 reds without MANAGENT_TASK_ID, 7 reds with). The
# wrapper's structural backstop: env-derived ids are advisory, kanban-known
# ids are authoritative. Explicit --task / --bundle keep the strict refusal
# (the caller named it on purpose).

set -u

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "git-commit-mine: not inside a git repo" >&2
    exit 2
}

# Scope resolution is shared with the pre-commit backstop (T282) — the lib
# ships next to this script; the target repo may be a scratch repo, so never
# resolve it relative to REPO.
LIB_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB="$LIB_DIR/git-commit-mine-lib.sh"
if [ -f "$LIB" ]; then
    # shellcheck disable=SC1090
    source "$LIB"
else
    echo "git-commit-mine: REFUSED — $LIB missing (the wrapper and its scope lib ship together in tools/)" >&2
    exit 2
fi

# ── parse args ────────────────────────────────────────────────────────────
PATHS=()
MSG=""
TASK_ID=""
BUNDLE=""
EXPLICIT=0
LONG_SUBJECT_REASON=""
prev=""
for arg in "$@"; do
    if [ "$prev" = "-m" ]; then MSG="$arg"; prev=""; continue; fi
    if [ "$prev" = "--task" ]; then TASK_ID="$arg"; prev=""; continue; fi
    if [ "$prev" = "--bundle" ]; then BUNDLE="$arg"; prev=""; continue; fi
    if [ "$prev" = "--long-subject" ]; then LONG_SUBJECT_REASON="$arg"; prev=""; continue; fi
    case "$arg" in
        -m|--task|--bundle|--long-subject) prev="$arg" ;;
        --explicit) EXPLICIT=1 ;;
        *) PATHS+=("$arg") ;;
    esac
done
# --long-subject was the last arg → no reason given. The escape must be
# loud AND stated; a bare flag is a silent escape attempt (T505).
if [ "$prev" = "--long-subject" ]; then
    echo "git-commit-mine: REFUSED — --long-subject needs a stated reason." >&2
    echo "  The escape is loud, not silent: a subject over 72 chars is exceptional" >&2
    echo "  and must say WHY (fleet-git-isolation.md §4.1a). Record the reason in" >&2
    echo "  the commit body or a findings note, and pass it to the flag." >&2
    exit 1
fi

if [ "${#PATHS[@]}" -eq 0 ]; then
    echo "git-commit-mine: REFUSED — no paths. A pathless commit is exactly the"
    echo "  fleet hazard (T268 absorbed T272's staged files; the Orchestrator's"
    echo "  'git add -A docs/' swept T266's evidence). Name every path you commit."
    exit 1
fi
if [ -z "$MSG" ]; then
    echo "git-commit-mine: REFUSED — no commit message (-m <msg>)." >&2
    exit 2
fi

# ── subject-length gate (T505) ───────────────────────────────────────────
# The subject is the text up to the first newline of -m
# (fleet-git-isolation.md §4.1a: one line, under 72 chars). A subject over
# 72 chars is refused unless --long-subject <reason> declares a loud,
# recorded escape — the point is that an over-long subject is *exceptional
# and visible*, not impossible.
SUBJECT="${MSG%%$'\n'*}"
SUBJECT_LEN=${#SUBJECT}
if [ "$SUBJECT_LEN" -gt 72 ]; then
    if [ -n "$LONG_SUBJECT_REASON" ]; then
        echo "git-commit-mine: NOTE — --long-subject escape invoked: subject is" >&2
        echo "  ${SUBJECT_LEN} chars (over the 72-char limit). Reason: $LONG_SUBJECT_REASON" >&2
        echo "  Record this escape in the commit body or the task's findings file." >&2
    else
        echo "git-commit-mine: REFUSED — subject is ${SUBJECT_LEN} chars, over the" >&2
        echo "  72-char limit (fleet-git-isolation.md §4.1a). The subject is the text" >&2
        echo "  up to the first newline of -m; the body carries the detail. Split the" >&2
        echo "  commit, or pass --long-subject <reason> to declare a loud, recorded" >&2
        echo "  escape (the reason goes in the commit body or a findings note)." >&2
        exit 1
    fi
fi
if [ -z "$TASK_ID" ] && [ -z "$BUNDLE" ] && [ -n "${MANAGENT_TASK_ID:-}" ]; then
    TASK_ID="$MANAGENT_TASK_ID"
    TASK_ID_FROM_ENV=1
fi

# ── scope resolution ──────────────────────────────────────────────────────
SCOPE_FILE=$(mktemp "${TMPDIR:-/tmp}/git-commit-mine-scope-XXXXXX")
# T547: fd 9 is the commit mutex (an exclusive flock held across
# stage→verify→commit). The EXIT trap releases it on every exit path;
# flock(2) is also kernel-released when the process dies for ANY reason
# (crash, SIGKILL, exit 1), so this trap is belt-and-braces, not the only
# release. exec 9>&- on a never-opened fd is a harmless no-op, so the trap
# is safe on the early-exit paths that never acquired the lock.
trap 'rm -f "$SCOPE_FILE"; exec 9>&- 2>/dev/null || true' EXIT

declare_scope() {  # add a path to the scope
    [ -n "$1" ] && printf '%s\n' "$1" >> "$SCOPE_FILE"
}

SCOPE_SOURCE=""
if [ -n "$TASK_ID" ]; then
    # T454: env-derived ids are advisory (see header); kanban-unknown env ids
    # fall through to unlabelled with a warning rather than a refusal, so
    # scratch-repo harness invocations stop cascading. Explicit --task /
    # --bundle stay strict — the caller named the id on purpose.
    if ! BUNDLE_PATH=$(gcm_task_bundle "$REPO" "$TASK_ID" "${MANAGENT_STORE:-}"); then
        if [ "${TASK_ID_FROM_ENV:-0}" = "1" ]; then
            echo "git-commit-mine: NOTE — \$MANAGENT_TASK_ID=$TASK_ID is not in $REPO/docs/infra/managent/tasks.json; treating the call as unlabelled." >&2
            echo "  (a regression harness invoking the wrapper from a scratch repo with the parent's env inherits" >&2
            echo "   MANAGENT_TASK_ID=$TASK_ID, which the scratch kanban cannot resolve — T369 / T454.)" >&2
            TASK_ID=""
            TASK_ID_FROM_ENV=0
        else
            echo "git-commit-mine: REFUSED — cannot resolve task $TASK_ID in the kanban" >&2
            exit 2
        fi
    else
        SCOPE_SOURCE="task $TASK_ID (bundle: $BUNDLE_PATH)"
        if [ -n "$BUNDLE_PATH" ]; then
            BUNDLE="$REPO/$BUNDLE_PATH"
        fi
    fi
elif [ -n "$BUNDLE" ]; then
    SCOPE_SOURCE="bundle $BUNDLE"
fi

# deliverables= from the bundle meta header — parsing lives in the shared lib
# (tools/git-commit-mine-lib.sh, T282), so the pre-commit backstop and the
# wrapper can never drift apart on what counts as in-scope.
if [ -n "$BUNDLE" ] && [ -f "$BUNDLE" ]; then
    while IFS= read -r p; do
        declare_scope "$p"
    done < <(gcm_bundle_deliverables "$BUNDLE")
fi

if [ -n "$TASK_ID" ]; then
    # the task's own findings files are always in scope
    for f in "$REPO"/findings/"$TASK_ID"-*.json; do
        [ -e "$f" ] && declare_scope "${f#$REPO/}"
    done
    # fleet-coordination surfaces any worker may legitimately commit
    declare_scope "docs/status/CURRENT.md"
    declare_scope "docs/status/HANDOVER.md"
    # T484: absorption surfaces — the closer (worker or Orchestrator) edits
    # the register and the rejection registry inside its own commit, so both
    # are in every task's scope, exactly like the two surfaces above.
    declare_scope "docs/epistemic/CLAIMS.md"
    declare_scope "findings/rejections.json"
fi

# ── claim-status check (T424) ────────────────────────────────────────────
# Worked-without-claiming: T392/T395/T400/T404/T419 were worked and committed
# while the row still read `dispatchable`. An unclaimed row is invisible to
# holdsConflict, so holds= and the parallel sets protect nothing — the hazard
# the claim exists for. Claim is the precondition of accepted work: a commit
# whose task is not in_progress is refused here, BEFORE anything is staged
# (the refusal leaves the index untouched), naming the recovery path.
# `--explicit` is the deliberate escape, same semantics as the scope escape:
# the caller takes responsibility and the silent path dies.
if [ -n "$TASK_ID" ] && [ "$EXPLICIT" -eq 0 ]; then
    TASK_STATUS=$(gcm_task_status "$REPO" "$TASK_ID" "${MANAGENT_STORE:-}") || {
        echo "git-commit-mine: REFUSED — cannot read task $TASK_ID's status in the kanban" >&2
        exit 2
    }
    case "$TASK_STATUS" in
        ""|in_progress)
            : ;;  # no status key (synthetic fixture) or claimed — allow
        done|failed)
            echo "git-commit-mine: REFUSED — task $TASK_ID is $TASK_STATUS, not in_progress."
            echo "  The row is closed; committing under it puts post-close work outside the"
            echo "  row and the kanban stops agreeing with reality."
            echo "  Record the follow-up against the row instead:"
            echo "    managent amend $TASK_ID --post-close \"<what landed and where>\""
            echo "  or mint a new row for the follow-up work. To commit anyway, pass"
            echo "  --explicit (you take responsibility; the escape is loud, not silent)."
            exit 1
            ;;
        blocked)
            echo "git-commit-mine: REFUSED — task $TASK_ID is blocked (needs unmet), not in_progress."
            echo "  The row's dependencies are not done; the work ran under an unmet gate."
            echo "  Resolve the needs, claim the row (managent claim $TASK_ID), then retry."
            echo "  To commit anyway, pass --explicit (you take responsibility; the escape"
            echo "  is loud, not silent)."
            exit 1
            ;;
        *)
            echo "git-commit-mine: REFUSED — task $TASK_ID is $TASK_STATUS, not in_progress."
            echo "  Claim the row FIRST (managent claim $TASK_ID), then retry this commit:"
            echo "  the work ran with no claim held, so holds= and the parallel sets were"
            echo "  blind to the row (T392/T395/T400/T404/T419 worked without claiming this"
            echo "  week, 2026-08-08). If the claim is refused (set locked / needs unmet),"
            echo "  the work was unauthorized — stop and talk to the Orchestrator."
            echo "  To commit anyway, pass --explicit (you take responsibility; the escape"
            echo "  is loud, not silent)."
            exit 1
            ;;
    esac
fi

# ── holds check (T547) ───────────────────────────────────────────────────
# The one-writer invariant protects FILE CONTENTS, not the git index: a
# path's working-tree content may already carry another row's in-flight edit,
# and `git add <path>` stages that path's ENTIRE current content (T521:
# 784235a absorbed T531/T545's build.zig hunks + T512's regression-dispatch.sh
# arms under the T521 message). Before staging, refuse any named path held by
# a DIFFERENT in_progress row — the holds map is populated (T539), so the
# check is finally possible. --explicit is the loud escape (caller takes
# responsibility). An unreadable store degrades to warn-and-allow, same as the
# pre-commit backstop (T540 item 3), so a momentarily-unreadable kanban never
# wedges a worker. This runs BEFORE the mutex/staging so a refusal leaves the
# index byte-for-byte untouched.
HOLDERS_FILE=$(mktemp "${TMPDIR:-/tmp}/gcm-holders-XXXXXX") || HOLDERS_FILE=""
if [ -n "$HOLDERS_FILE" ]; then
    HOLDERS_RC=0
    gcm_active_holders "$REPO" "${MANAGENT_STORE:-}" > "$HOLDERS_FILE" 2>/dev/null || HOLDERS_RC=$?
    FOREIGN_HELD=""
    if [ "$HOLDERS_RC" -eq 0 ]; then
        for p in "${PATHS[@]}"; do
            rel="$p"
            rel="${rel#./}"
            case "$rel" in
                /*) rel="${rel#"$REPO"/}" ;;
            esac
            HIT=$(awk -F'\t' -v p="$rel" -v me="${TASK_ID:-}" '$3 == p && $1 != me { print; exit }' "$HOLDERS_FILE")
            if [ -n "$HIT" ]; then
                HTID=$(printf '%s\n' "$HIT" | cut -f1)
                HAGENT=$(printf '%s\n' "$HIT" | cut -f2)
                FOREIGN_HELD="${FOREIGN_HELD}${rel}  (held by ${HTID}${HAGENT:+, agent=${HAGENT}})"$'\n'
            fi
        done
    fi
    if [ -n "$FOREIGN_HELD" ]; then
        if [ "$EXPLICIT" -eq 0 ]; then
            echo "git-commit-mine: REFUSED — path(s) held by a different in_progress row:" >&2
            printf '%b' "$FOREIGN_HELD" | while IFS= read -r l; do [ -n "$l" ] && echo "git-commit-mine:   $l" >&2; done
            echo "git-commit-mine:   This is the T521 incident class — do NOT stage another row's" >&2
            echo "git-commit-mine:   in-flight edit. Wait for the holder to commit, or pass" >&2
            echo "git-commit-mine:   --explicit to take responsibility (loud, recorded)." >&2
            rm -f "$HOLDERS_FILE"
            exit 1
        fi
        echo "git-commit-mine: WARNING — --explicit: committing path(s) held by a different in_progress row:" >&2
        printf '%b' "$FOREIGN_HELD" | while IFS= read -r l; do [ -n "$l" ] && echo "git-commit-mine:   $l" >&2; done
        echo "git-commit-mine:   you take responsibility for this content (loud, recorded)." >&2
    elif [ "$HOLDERS_RC" -ne 0 ]; then
        echo "git-commit-mine: NOTE — holder table unreadable (kanban unreadable); holds check skipped." >&2
    fi
    rm -f "$HOLDERS_FILE"
fi

# ── commit mutex (T547) ─────────────────────────────────────────────────
# One shared .git/index means two workers' stage→commit sequences can
# interleave and absorb each other's staged content (T521: 784235a). Take an
# exclusive flock for the whole stage→verify→commit span; the lock file lives
# alongside the store's lockfile (docs/infra/managent/), NOT inside .git/.
# flock(2) is kernel-released on ANY process exit — the fd closes and the
# lock drops, so there is no stale-lock wedge. Default blocks until the
# holder finishes (the holder WILL finish — see above); GCM_LOCK_TIMEOUT_SECS
# bounds the wait for tests/diagnostics and turns a timeout into a loud
# refusal instead of an unbounded block.
LOCK_FILE="$REPO/docs/infra/managent/git-commit-mine.lock"
mkdir -p "$(dirname "$LOCK_FILE")" || { echo "git-commit-mine: REFUSED — cannot create lock dir $(dirname "$LOCK_FILE")" >&2; exit 2; }
exec 9<>"$LOCK_FILE" || { echo "git-commit-mine: REFUSED — cannot open commit mutex $LOCK_FILE" >&2; exit 2; }
python3 - "$LOCK_FILE" 9 <<'PYEOF'
import fcntl, sys, time, os
lock_path = sys.argv[1]
fd = int(sys.argv[2])
timeout = os.environ.get("GCM_LOCK_TIMEOUT_SECS", "")
if timeout:
    deadline = time.time() + float(timeout)
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except (BlockingIOError, OSError):
            if time.time() >= deadline:
                sys.stderr.write("git-commit-mine: REFUSED — commit mutex held for >%ss by another worker (mid-commit); retry.\n" % timeout)
                sys.exit(1)
            time.sleep(0.1)
else:
    fcntl.flock(fd, fcntl.LOCK_EX)
PYEOF
[ $? -ne 0 ] && exit 1

# ── stage only the named paths ───────────────────────────────────────────
cd "$REPO" || exit 2
NAMES_ABS=()
NAMES_REL=()
for p in "${PATHS[@]}"; do
    if [ -e "$p" ]; then
        NAMES_ABS+=("$(cd "$(dirname "$p")" && pwd)/$(basename "$p")")
    else
        NAMES_ABS+=("$REPO/$p")
    fi
    NAMES_REL+=("$p")
done
# -f (T739): Apple Git 2.50.1 exits 1 from `git add <path>` whenever the
# pathspec lies under an ignored directory — even for a TRACKED file it stages
# correctly — so the plain add refused every commit naming e.g.
# untracked/watch-fleet.sh (tracked, under the ignored untracked/ dir; T738
# committed the same file before the git update). -f is safe here: the wrapper
# only ever adds paths the caller explicitly named, the scope/holds checks
# still apply, and a genuinely MISSING path still fails the add (pathspec did
# not match any files, rc 128), so the typo guard is intact. The one behavior
# change: an explicitly named, genuinely-ignored NEW file is staged instead of
# refused — the four wrapper guarantees (named paths only, staged-set
# verification, path-limited commit, commit-content verification) are all
# ignore-rule-independent.
git add -f -- "${NAMES_ABS[@]}" 2>/dev/null || {
    echo "git-commit-mine: REFUSED — git add failed; a named path is missing or ignored." >&2
    exit 2
}

# ── verify the staged set ─────────────────────────────────────────────────
STAGED=$(git diff --cached --name-only)
if [ -z "$STAGED" ]; then
    # Nothing staged after adding the named paths. Two sub-cases (T282 defect 1):
    # (a) every named path is already committed and unchanged — a healthy no-op;
    #     report it as such and exit 0. Nothing is wrong; there was nothing to commit.
    # (b) anything else — a genuine refusal.
    ALL_CLEAN=1
    for p in "${NAMES_REL[@]}"; do
        if ! (git cat-file -e "HEAD:$p" 2>/dev/null && git diff --quiet HEAD -- "$p"); then
            ALL_CLEAN=0
            break
        fi
    done
    if [ "$ALL_CLEAN" -eq 1 ]; then
        echo "git-commit-mine: OK — nothing to commit: already committed and unchanged:"
        for p in "${NAMES_REL[@]}"; do
            echo "  $p"
        done
        exit 0
    fi
    echo "git-commit-mine: REFUSED — nothing staged after adding the named paths." >&2
    exit 2
fi

foreign() {  # is path $1 outside scope ∪ named paths?
    local p="$1" i
    for i in "${NAMES_REL[@]}"; do
        [ "$p" = "$i" ] && return 1
    done
    if [ -s "$SCOPE_FILE" ]; then
        if grep -Fxq "$p" "$SCOPE_FILE"; then return 1; fi
    fi
    return 0
}

FOREIGN_LIST=""
while IFS= read -r p; do
    if foreign "$p"; then
        FOREIGN_LIST="$FOREIGN_LIST$p"$'\n'
    fi
done <<< "$STAGED"

if [ -n "$FOREIGN_LIST" ]; then
    if [ "$EXPLICIT" -eq 0 ] && [ -n "$SCOPE_SOURCE" ]; then
        echo "git-commit-mine: REFUSED — index contains staged paths outside your scope ($SCOPE_SOURCE):"
        while IFS= read -r fp; do [ -n "$fp" ] && echo "  $fp"; done <<< "$FOREIGN_LIST"
        echo "  This is the T268 incident class. Do NOT unstage another console's"
        echo "  work. If the file is yours, unstage it (git restore --staged <path>);"
        echo "  otherwise wait for its owner to commit, then retry."
        exit 1
    fi
    echo "git-commit-mine: WARNING — index contains staged paths outside the named set" >&2
    while IFS= read -r fp; do [ -n "$fp" ] && echo "git-commit-mine:   $fp" >&2; done <<< "$FOREIGN_LIST"
    echo "git-commit-mine:   committing the named paths only (path-limited commit)." >&2
    COMMIT_MODE="paths"
else
    COMMIT_MODE="index"
fi

# ── identity mode: named paths must be in scope ──────────────────────────
if [ -n "$SCOPE_SOURCE" ] && [ "$EXPLICIT" -eq 0 ]; then
    for p in "${NAMES_REL[@]}"; do
        if [ -s "$SCOPE_FILE" ] && grep -Fxq "$p" "$SCOPE_FILE"; then
            :
        else
            echo "git-commit-mine: REFUSED — path not in your declared scope ($SCOPE_SOURCE): $p"
            echo "  Scope = the bundle's deliverables= plus findings/<id>-*.json plus"
            echo "  docs/status/CURRENT.md, docs/status/HANDOVER.md,"
            echo "  docs/epistemic/CLAIMS.md, findings/rejections.json. Commit only declared"
            echo "  files, or pass --explicit to take responsibility for the paths yourself."
            exit 1
        fi
    done
fi

# ── commit ───────────────────────────────────────────────────────────────
# Explicit-mode commits take responsibility for out-of-scope paths; the
# pre-commit backstop (T282) must not refuse them — it treats
# GIT_MINE_EXPLICIT=1 as the wrapper-took-responsibility case (warn-and-allow),
# same as an unlabelled commit.
if [ "$EXPLICIT" -eq 1 ]; then
    export GIT_MINE_EXPLICIT=1
fi
# Index mode: the staged set was verified == named paths, so a plain `git
# commit` is safe. Paths mode (foreign staged content present, explicit
# mode): a path-limited `git commit -- <paths>` — the foreign content cannot
# enter the commit and stays staged for its owner (T278: verified 2026-08-02,
# T7's first cut used plain commit and absorbed the foreign files — the
# seeded fixture caught it).
if [ "$COMMIT_MODE" = "paths" ]; then
    git commit -m "$MSG" -- "${NAMES_REL[@]}"
else
    git commit -m "$MSG"
fi
RC=$?
[ "$RC" -ne 0 ] && exit "$RC"

# T547: release the commit mutex as soon as the commit lands — the
# post-commit verification below is read-only and must not extend the held
# window (the bundle's "shortest window that still makes stage-and-commit
# atomic").
exec 9>&- 2>/dev/null || true

# ── verify the commit contains exactly the named paths — three cases ─────
# (T282 defect 1):
#   1. path IS in the new commit            → committed by this invocation
#   2. path not in commit but in HEAD and
#      unchanged vs HEAD                    → already committed, nothing to
#                                             commit — a healthy no-op, report
#                                             as such, NOT a failure
#   3. anything else                        → genuinely missing — a real failure
IN_COMMIT=$(git show --format= --name-only HEAD | grep -v '^$')
MISSING=()
ALREADY_COMMITTED=()
for p in "${NAMES_REL[@]}"; do
    if printf '%s\n' "$IN_COMMIT" | grep -Fxq "$p"; then
        :  # case 1
    elif git cat-file -e "HEAD:$p" 2>/dev/null && git diff --quiet HEAD -- "$p"; then
        ALREADY_COMMITTED+=("$p")  # case 2
    else
        MISSING+=("$p")  # case 3
    fi
done
if [ "${#MISSING[@]}" -gt 0 ]; then
    echo "git-commit-mine: FAIL — commit $(git rev-parse --short HEAD) does not contain:" >&2
    for m in "${MISSING[@]}"; do echo "  $m" >&2; done
    exit 1
fi
if [ "${#ALREADY_COMMITTED[@]}" -gt 0 ]; then
    echo "git-commit-mine: note — already committed and unchanged (nothing to commit for these): ${ALREADY_COMMITTED[*]}" >&2
    echo "git-commit-mine: OK — commit $(git rev-parse --short HEAD) contains the changed paths: ${NAMES_REL[*]}"
else
    echo "git-commit-mine: OK — commit $(git rev-parse --short HEAD) contains exactly: ${NAMES_REL[*]}"
fi
exit 0
