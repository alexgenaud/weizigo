[runner] argv = zig run -O ReleaseFast src/exp6_hchain_audit.zig
[runner] ceilings: rss 8192 MB, wall 14400s (4:00:00), cpu 28800s (8:00:00), poll = 250 ms
# ============================================================================
# EXP-6 — 4×4 under the new rule: +2, and a root that can say so
# Task: EXP-6 · Role: worker · Model: DSPro · Date: 2026-07-29
# Rule: basic ko (formalization (i)) + TIE = 0 for long cycles
# Value rule: V = median(L, TIE, H) = max(L, min(TIE, H))
# ============================================================================

