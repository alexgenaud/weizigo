#!/usr/bin/env python3
"""Backward-compat wrapper: bin/subagent --provider ollama.

T440: resolve the target from THIS file's location (see bin/subagent-ds).
"""
import os, subprocess, sys
HERE = os.path.dirname(os.path.abspath(__file__))
sys.stderr.write("ollama-subagent: use bin/subagent --provider ollama\n")
sys.exit(subprocess.call(
    [sys.executable, os.path.join(HERE, "subagent"), "--provider", "ollama"] + sys.argv[1:]))
