#!/usr/bin/env python3
"""Dispatch an Ollama worker.  bin/ollama-subagent <T-ID|path.md> --model <tag> [--wall=N] [--dry-run]

  --model <tag>   Ollama model tag, e.g. glm-5.2:cloud (also --model=<tag>)
  --wall=N        wall-clock guard, default 1800s (also --wall N)
  --dry-run       print the command, spawn nothing

bin/ollama-subagent applies the bin/subagent depth-cap contract to the Ollama
path (T321, 2026-08-03). It stamps WEIZIGO_AGENT_DEPTH on the child and refuses
at the worker depth, so an Ollama leaf cannot recurse further through this
tool. It is a safety mechanism, NOT a security boundary — `ollama launch pi`
remains directly callable and unguarded (see docs/infra/agents/subdelegation.md
§Reach matrix and §Depth-enforcement ruling), and DEEPSEEK_API_KEY is NOT
stripped, so an Ollama leaf can still dispatch DeepSeek via bin/subagent when
depth < 2 (path 2, demonstrated by a real dispatch — see the reach matrix).
Closing that path is option (c), held for the human.

Children run at depth 2 and cannot dispatch further via bin/ollama-subagent or
bin/subagent. Managers are launched by the human. The depth cap stops
accidental recursion; it is not a security boundary — see subdelegation.md.

The credential (if any) travels by environment, never by argv: tools/runner
echoes argv and the heartbeat writer records it, so an --api-key flag would
leak the key into logs and evidence on every dispatch.
"""
import glob, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEPTH_VAR = "WEIZIGO_AGENT_DEPTH"
WORKER_DEPTH = 2


def _parse_deliverables(bundle_abs, slug, target):
    """Parse deliverables= from a bundle's <!--managent ...--> meta header.

    Returns a list of deliverable paths.  Falls back to the pre-T317
    filename-derived path when the header declares nothing.
    """
    try:
        with open(bundle_abs) as f:
            for line in f:
                line = line.strip()
                if line.startswith("<!--managent "):
                    m = re.search(r"deliverables=([^\s>]+)", line)
                    if m:
                        val = m.group(1).rstrip(",")
                        return [p.strip() for p in val.split(",") if p.strip()]
                    break
    except Exception:
        pass
    # Fall back: the pre-T317 filename-derived path.
    return [f"findings/{target}-{slug}.json"]


def parse(argv):
    """Split argv into (positional args, flags). --model/--wall accept both
    --model=X and --model X (space) forms; --dry-run is a bare flag."""
    args, flags, i = [], [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("--model", "--wall") and i + 1 < len(argv) and not argv[i + 1].startswith("--"):
            flags.append(f"{a}={argv[i + 1]}")
            i += 2
            continue
        if a.startswith("--"):
            flags.append(a)
            i += 1
            continue
        args.append(a)
        i += 1
    return args, flags


def main(argv):
    args, flags = parse(argv)
    unknown = [f for f in flags
               if f not in ("--dry-run",)
               and not f.startswith("--model=")
               and not f.startswith("--wall=")]
    if len(args) != 1 or unknown:
        sys.exit((f"ollama-subagent: unknown flag(s) {' '.join(unknown)}\n" if unknown else "")
                 + __doc__)

    try:  # fail closed: an unreadable depth is treated as a worker
        depth = int(os.environ.get(DEPTH_VAR, "1"))
    except ValueError:
        depth = WORKER_DEPTH
    if depth >= WORKER_DEPTH:
        sys.exit(f"ollama-subagent: REFUSED — you are a worker (depth {depth}). Workers do "
                 f"not dispatch.\nWrite your output to a file or return it to your "
                 f"manager, then stop.\nIf the task genuinely needs delegating, say "
                 f"so and let your manager decide.")

    raw_model = next((f.split("=", 1)[1] for f in flags if f.startswith("--model=")), None)
    if not raw_model:
        sys.exit("ollama-subagent: name exactly one model — --model <ollama-tag>")

    # ── T317 item 2: map raw Ollama tags to canonical model labels.
    #    Ollama tags carry :cloud suffixes and code-variant names (e.g.
    #    kimi-k2.7-code:cloud); managent rejects non-canonical labels at
    #    write time, so we must emit the canonical form in --agent flags.
    #    The canonical set is the single source of truth in
    #    src/managent/main.zig; this mapping must stay in sync.
    OLLAMA_TAG_TO_CANONICAL = {
        "glm-5.2": "glm-5.2",
        "glm-5.2:cloud": "glm-5.2",
        "minimax-m3": "minimax-m3",
        "minimax-m3:cloud": "minimax-m3",
        "kimi-k2.7": "kimi-k2.7",
        "kimi-k2.7-code": "kimi-k2.7",
        "kimi-k2.7:cloud": "kimi-k2.7",
        "kimi-k2.7-code:cloud": "kimi-k2.7",
    }
    model = OLLAMA_TAG_TO_CANONICAL.get(raw_model)
    if model is None:
        # Strip :cloud suffix and try again — a new Ollama model arriving
        # before this mapping is updated.
        model = re.sub(r":cloud$", "", raw_model)

    target, wall = args[0], next(
        (f.split("=", 1)[1] for f in flags if f.startswith("--wall=")), "1800")

    task_id = None
    if re.fullmatch(r"T\d+", target):
        hits = glob.glob(os.path.join(ROOT, "untracked", f"{target}-*.md"))
        if len(hits) != 1:
            sys.exit(f"ollama-subagent: expected one bundle for {target}, found {len(hits)}")
        bundle = os.path.relpath(hits[0], ROOT)
        task_id = target

        # ── T317 item 5: read the bundle's declared deliverables from its
        #    meta header, so the closing prompt names what the gate enforces.
        #    The pre-T317 code derived the filename from the brief slug
        #    regardless of the deliverables= line; three consecutive rows
        #    closed wrong on this (T329, T332, T333).
        slug = re.sub(rf"^{target}-|\.md$", "", os.path.basename(bundle))
        deliverables = _parse_deliverables(hits[0], slug, target)
        dl_lines = "\n".join(f"  - {d}" for d in deliverables)

        prompt = (f"Follow {bundle}\n\n"
                  f"FIRST: bin/managent claim {target} --agent {model}\n"
                  f"You are a worker. The brief carries everything.\n\n"
                  f"WHEN DONE, before any other output:\n"
                  f"  Deliverables declared by the bundle (managent done checks every one):\n"
                  f"{dl_lines}\n"
                  f"  1. Write these files per findings/README.md\n"
                  f"  2. bin/managent done {target} --agent {model} --status <pass|pass-with-findings|"
                  f"fail-found|blocked|abandoned> --note <one line>\n\n"
                  f"INBOX LOOP (T352):\n"
                  f"  The human used to relay messages between consoles by hand. That relay\n"
                  f"  is now a `managent tell` directive you can poll for.  At each natural\n"
                  f"  checkpoint — after a commit, before starting a new sub-step, and\n"
                  f"  before reporting done — run:\n"
                  f"      bin/managent inbox {target} --ack\n"
                  f"  A directive of `pause`, `amend` or `question` is actionable: act on\n"
                  f"  it and record the directive ID (D0NN) in your findings file's\n"
                  f"  `notes` field, so the Orchestrator can see you read it.  A directive\n"
                  f"  of `kill` writes your context dump and exits.  An empty inbox is a\n"
                  f"  no-op (do not be alarmed).  The brief carries everything else.\n")
    elif os.path.isfile(target):
        prompt = f"Follow {os.path.relpath(os.path.abspath(target), ROOT)}\n"
    else:
        sys.exit(f"ollama-subagent: no such task or file: {target}")

    # Credential by environment, never argv (see docstring).
    env = dict(os.environ, **{DEPTH_VAR: str(WORKER_DEPTH)})
    if task_id:
        env["MANAGENT_TASK_ID"] = task_id

    # `ollama launch pi --model <tag> -y -- <pi args>`: the integration name
    # implies pi, so the args after `--` go straight to pi (T320 evidence).
    #
    # **Launch with `raw_model`, never the canonical label.** The canonical label
    # (`model`) belongs in the claim/done lines only — it is a ledger label, not an
    # Ollama tag. T317 item 2 passed `model` here, which silently broke every Ollama
    # dispatch: `ollama show glm-5.2` and `kimi-k2.7` are NOT FOUND, while
    # `glm-5.2:cloud` and `kimi-k2.7-code:cloud` resolve — the roster is cloud models
    # and the `:cloud` suffix is load-bearing. Caught 2026-08-04 at the T336 pass
    # boundary by dry-running a dispatch and probing both tags.
    cmd = ["tools/runner", "--max-wall", wall, "--",
           "ollama", "launch", "pi", "--model", raw_model, "-y", "--", "-p", prompt]
    if "--dry-run" in flags:
        print(f"{DEPTH_VAR}={WORKER_DEPTH}")
        if task_id:
            # T370: identity is propagated by env so nested runner calls inherit it.
            print(f"MANAGENT_TASK_ID={task_id}")
        print(" ".join(repr(c) if "\n" in c else c for c in cmd))
        return 0
    return subprocess.call(cmd, cwd=ROOT, env=env)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))