#!/usr/bin/env python3
"""Dispatch a DeepSeek worker.  bin/subagent <T-ID|path.md> --dspro|--dsflash [--wall=N] [--dry-run]

  --dspro     DeepSeek-v4-Pro          --wall=N    wall-clock guard, default 1800s
  --dsflash   DeepSeek-v4-Flash        --dry-run   print the command, spawn nothing

DeepSeek dispatches DeepSeek only. Claude seats use the Claude Code harness.
Children are workers: depth 2, no API keys, cannot dispatch. Managers are
launched by the human.
"""
import glob, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEPTH_VAR = "WEIZIGO_AGENT_DEPTH"
WORKER_DEPTH = 2
MODELS = {"--dspro": "deepseek-v4-pro", "--dsflash": "deepseek-v4-flash"}


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    flags = [a for a in argv if a.startswith("--")]
    if len(args) != 1:
        sys.exit(__doc__)

    depth = int(os.environ.get(DEPTH_VAR, "1"))
    if depth >= WORKER_DEPTH:
        sys.exit(f"subagent: REFUSED — you are a worker (depth {depth}). Workers do "
                 f"not dispatch.\nWrite your output to a file or return it to your "
                 f"manager, then stop.\nIf the task genuinely needs delegating, say "
                 f"so and let your manager decide.")

    chosen = [f for f in flags if f in MODELS]
    if len(chosen) != 1:
        sys.exit("subagent: name exactly one model — --dspro or --dsflash")
    model = MODELS[chosen[0]]

    target, wall = args[0], next(
        (f.split("=")[1] for f in flags if f.startswith("--wall=")), "1800")

    if re.fullmatch(r"T\d+", target):
        hits = glob.glob(os.path.join(ROOT, "untracked", f"{target}-*.md"))
        if len(hits) != 1:
            sys.exit(f"subagent: expected one bundle for {target}, found {len(hits)}")
        bundle = os.path.relpath(hits[0], ROOT)
        slug = re.sub(rf"^{target}-|\.md$", "", os.path.basename(bundle))
        prompt = (f"Follow {bundle}\n\n"
                  f"FIRST: bin/managent claim {target}\n"
                  f"You are a worker. The brief carries everything.\n\n"
                  f"WHEN DONE, before any other output:\n"
                  f"  1. Write findings/{target}-{slug}.json per findings/README.md\n"
                  f"  2. bin/managent done {target} --status <pass|pass-with-findings|"
                  f"fail-found|blocked|abandoned> --note <one line>\n")
    elif os.path.isfile(target):
        prompt = f"Follow {os.path.relpath(os.path.abspath(target), ROOT)}\n"
    else:
        sys.exit(f"subagent: no such task or file: {target}")

    # The way, removed. pi needs the credential, the worker must not have it, so
    # it travels by argv (which pi consumes) and never by env (which the worker's
    # shell inherits). Residual: argv is readable via ps by an agent that goes
    # looking. That is a deliberate act, not an eager one.
    key = os.environ.get("DEEPSEEK_API_KEY", "")
    if not key:
        sys.exit("subagent: DEEPSEEK_API_KEY is not set")
    env = {k: v for k, v in os.environ.items() if not k.endswith("_API_KEY")}
    env[DEPTH_VAR] = str(WORKER_DEPTH)

    cmd = ["tools/runner", "--max-wall", wall, "--",
           "pi", "--provider", "deepseek", "--model", model,
           "--api-key", key, "-p", prompt]
    if "--dry-run" in flags:
        stripped = sorted(k for k in os.environ if k.endswith("_API_KEY"))
        print(f"{DEPTH_VAR}={WORKER_DEPTH}  env keys stripped: {stripped or 'none'}")
        print(" ".join(repr(c) if "\n" in c else c
                       for c in (["<KEY>" if c == key else c for c in cmd])))
        return 0
    return subprocess.call(cmd, cwd=ROOT, env=env)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
