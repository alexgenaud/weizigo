    "claude-sonnet-5",
    "claude-fable-5",
    "claude-haiku-4-5-20251001",
}

# Tools the headless claude session may use (the T481/t490 precedent set).
CLAUDE_ALLOWED_TOOLS = "Read,Write,Edit,Bash,Grep,Glob"

# Ollama tag → canonical model label mapping (must stay in sync with
# src/managent/main.zig canonical_models[] — T317 item 2).
OLLAMA_TAG_TO_CANONICAL = {
    "glm-5.2": "glm-5.2",
    "glm-5.2:cloud": "glm-5.2",
    "minimax-m3": "minimax-m3",
    "minimax-m3:cloud": "minimax-m3",
    "kimi-k2.7": "kimi-k2.7",
    "kimi-k2.7-code": "kimi-k2.7",
    # T890: "kimi-k2.7:cloud" DELETED — it is a dead tag the host does not
    # serve (model-registry.md: `Error: model 'kimi-k2.7' not found`).  It
    # canonicalizes to kimi-k2.7 via the generic :cloud strip below, then
    # arm A refuses it because the derived LIVE tag is kimi-k2.7-code:cloud.
    # A dead alias map entry is documentation of a bug, not a remedy.
    "kimi-k2.7-code:cloud": "kimi-k2.7",
    "qwen3.8:27b-mlx": "qwen3.8:27b-mlx",
    "qwen3.8:27b-mlx:cloud": "qwen3.8:27b-mlx",
}

# pi (openrouter) serving tag → canonical label mapping (T732).  The serving
# tag stealth/ox-alpha never reaches the ledger; the stored label is always
# ox-alpha (src/managent/main.zig canonical_models[]).
PI_TAG_TO_CANONICAL = {
    "stealth/ox-alpha": "ox-alpha",
}

# T890: canonical label → the ONE live serving tag the host dispatches with.
# This is the single source of truth for the LAUNCH tag — derived from the
# canonical label, never the hand-typed one.  OLLAMA_TAG_TO_CANONICAL /
# PI_TAG_TO_CANONICAL above are its input-convenience reverse (a serving tag
# a human typed → the canonical label); the two are asserted consistent at
# import (every live tag canonicalizes back to its canonical) and by
# tools/regression-serving-tag-single-path.sh against bin/dispatch's MODELS
# table and src/managent/main.zig canonical_models[].  bin/dispatch is
# immune to the dead-tag defect because it canonicalizes then re-derives
# the live tag from its MODELS table; this gives bin/subagent the same
# immunity by deriving the live tag here instead of passing raw_model
# through.  One truth, verified not duplicated.
CANONICAL_TO_OLLAMA_TAG = {
    "glm-5.2": "glm-5.2:cloud",
    "minimax-m3": "minimax-m3:cloud",
    "kimi-k2.7": "kimi-k2.7-code:cloud",
    "qwen3.8:27b-mlx": "qwen3.8:27b-mlx",
}
CANONICAL_TO_PI_TAG = {
    "ox-alpha": "stealth/ox-alpha",
}

# Load-time consistency: every live tag must canonicalize back to the
# canonical it is keyed under (the two maps are inverses on their overlap).
# A drift here is a second source of truth — exactly what T890 forbids.
for _c, _live in {**CANONICAL_TO_OLLAMA_TAG, **CANONICAL_TO_PI_TAG}.items():
    _back = (OLLAMA_TAG_TO_CANONICAL if _c in CANONICAL_TO_OLLAMA_TAG
             else PI_TAG_TO_CANONICAL).get(_live)
    assert _back == _c, (
        "bin/subagent: T890 live-tag map drift — %r -> %r but the "
        "canonicalization map sends %r to %r" % (_c, _live, _live, _back))


def _ollama_offered_tags():
    """The set of ollama tags the host actually serves, or None if
    unknowable.  WEIZIGO_OLLAMA_OFFERED (comma-separated; the empty string
    means the host offers nothing) is the test injection hook — the same
    inject-don't-exhaust family as tools/runner's
    WEIZIGO_HOST_MEM_AVAIL_MB.  Unset → run `ollama list` and parse the NAME
    column, returning None if ollama is unreachable so a caller that cannot
    validate (no ollama daemon, a dry-run on a host without it) may proceed:
    a real launch surfaces the failure itself, a dry-run previews the
    command.  T890 arm B."""
    inj = os.environ.get("WEIZIGO_OLLAMA_OFFERED")
    if inj is not None:
        return {t.strip() for t in inj.split(",") if t.strip()}
    try:
        out = subprocess.run(["ollama", "list"], capture_output=True,
                             text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    tags = set()
    for line in out.stdout.splitlines()[1:]:  # skip the NAME/ID/SIZE header
        parts = line.split()
        if parts:
            tags.add(parts[0])
    return tags or None

# ── declared-need admission (T821) ─────────────────────────────────────
# T821 (docs/infra/host/ram-policy.md) replaces the T713 gate — which only
# ever looked at LOCAL ollama lanes — with admission for EVERY lane: every
# dispatch declares a peak RSS need (ORC-GD-1) and tools/runner's arbiter
# (the ONE component that owns this decision, ORC-G5) admits or refuses
# BEFORE the child is spawned, against what it has already admitted.  This
# file's job is only to compute the declaration and pass it through on the
# SAME tools/runner invocation that already wraps every lane (T677/D040) —
# it does not re-implement the arithmetic.
#
# Defaults (ram-policy.md §2a/§3.3): a resident local model (provider
# ollama, no `:cloud` suffix) declares the REGISTRY figure
# (docs/infra/model-registry.md: "local, 18 GB MLX") — never a `ps` sample,
# which is exactly what let the 2026-08-23 15:19:09 incident's tenant go
# unseen (D1).  Every other lane (cloud-API, or an ollama `:cloud` tag)
# declares its measured per-provider default.  `--ram-mb=N` overrides
# either default with a stated value (ram-policy.md §3.3's override rule).
RESIDENT_MODEL_RAM_MB = 18432             # docs/infra/model-registry.md:62
PROVIDER_RAM_MB_DEFAULT = {               # ram-policy.md §2a's measured table
    "claude": 1024,
    "deepseek": 2816,
    "pi": 1024,
}
OLLAMA_CLOUD_RAM_MB_DEFAULT = 3328        # remote ollama-served models


def _declared_ram_mb(provider, raw_model, flags):
    """The RAM (MB) this lane declares at admission (ORC-GD-1).  An
    explicit --ram-mb=N always wins; otherwise a resident local model
    (provider ollama, no :cloud tag) declares the registry figure, and
    every other lane declares its per-provider default."""
    override = flags.get("ram-mb")
    if override not in (None, True):
        try:
            return int(override)
        except ValueError:
            pass  # fall through to the computed default
    if provider == "ollama":
        if raw_model and ":cloud" in raw_model:
            return OLLAMA_CLOUD_RAM_MB_DEFAULT
        return RESIDENT_MODEL_RAM_MB
    return PROVIDER_RAM_MB_DEFAULT.get(provider, 3072)


# ── sampling diagnostics (T711/T713), demoted by T821 ──────────────────
# T821 deletes the T713 gate these fed (_lane_is_memory_heavy,
# _memory_gate_verdict, MEMORY_GATE_MARGIN_MB, LOCAL_LANE_COST_DEFAULT_MB —
# docs/infra/host/ram-policy.md §6 items 8-9).  The functions below are
# RETAINED as labeled `sample` diagnostics only (§6 item 6) — no decision
# may use a live ps/vm_stat reading; the resident charge above is a
# registry declaration, never this sample.
#
# Test hooks (the same inject-don't-exhaust family as tools/runner's
# WEIZIGO_HOST_MEM_AVAIL_MB / WEIZIGO_HOST_TENANT_RESERVATION_MB):
#   WEIZIGO_HOST_MEM_AVAIL_MB   inject the available-memory reading (MB)
#   WEIZIGO_HOST_TENANT_RESERVATION_MB  declare the resident tenant (MB);
#                               when set, no auto-detection runs (the test
#                               owns the whole scenario — same rule as the
#                               runner); 0 = explicitly no tenant
#   WEIZIGO_HOST_TOTAL_MB       inject total physical memory (MB)
#   WEIZIGO_HOST_MEM_UNAVAIL=1  force the reading to None (inert path)


def _host_total_mb():
    """Total physical memory in MB, or None.  WEIZIGO_HOST_TOTAL_MB injects
    the reading (mirror of tools/runner's WEIZIGO_HOST_MEM_AVAIL_MB hook).
    macOS: `sysctl -n hw.memsize`; Linux: /proc/meminfo MemTotal kB."""
    injected = os.environ.get("WEIZIGO_HOST_TOTAL_MB")
    if injected is not None:
        try:
            return int(injected)
        except ValueError:
            pass  # fall through to the real reading
    if sys.platform == 'linux' and os.path.isdir('/proc'):
        try:
            with open("/proc/meminfo") as f:
                for line in f:
                    if line.startswith("MemTotal:"):
                        return int(line.split()[1]) // 1024
        except (OSError, ValueError, IndexError):
            return None
        return None
    try:
        out = subprocess.run(
            ["sysctl", "-n", "hw.memsize"],
            capture_output=True, text=True, timeout=2.0,
        )
        if out.returncode == 0 and out.stdout.strip():
            return int(out.stdout.strip()) // (1024 * 1024)
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


def _host_avail_mb():
    """System-wide available memory in MB, or None.  WEIZIGO_HOST_MEM_AVAIL_MB
    injects the reading (MB, verbatim — the same hook tools/runner uses, so
    the T714 fixture vocabulary applies); WEIZIGO_HOST_MEM_UNAVAIL=1 forces
    None (the gate's inert path).  macOS: vm_stat reclaimable page classes
    (free + inactive + purgeable + speculative) × page size; Linux:
    /proc/meminfo MemAvailable kB."""
    if os.environ.get("WEIZIGO_HOST_MEM_UNAVAIL") == "1":
        return None
    injected = os.environ.get("WEIZIGO_HOST_MEM_AVAIL_MB")
    if injected is not None:
        try:
            return int(injected)
        except ValueError:
            pass  # fall through to the real reading
    if sys.platform == 'linux' and os.path.isdir('/proc'):
        try:
            with open("/proc/meminfo") as f:
                for line in f:
                    if line.startswith("MemAvailable:"):
                        return int(line.split()[1]) // 1024
        except (OSError, ValueError, IndexError):
            return None
        return None
    try:
        out = subprocess.run(
            ["vm_stat"], capture_output=True, text=True, timeout=2.0,
        )
        if out.returncode != 0:
            return None
        page = 4096
        classes = {"Pages free:": 0, "Pages inactive:": 0,
                  "Pages purgeable:": 0, "Pages speculative:": 0}
        for line in out.stdout.splitlines():
            ls = line.strip()
            if "page size of" in ls:
                m = re.search(r'page size of (\d+)', ls)
                if m:
                    page = int(m.group(1))
                continue
            for key in classes:
                if ls.startswith(key):
                    # "Pages free:  832602." -> strip the trailing dot
                    tail = ls[len(key):].strip().rstrip('.')
                    try:
                        classes[key] = int(tail)
                    except ValueError:
                        pass
        return (sum(classes.values()) * page) // (1024 * 1024)
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


def _resident_tenant_mb():
    """The resident model server footprint in MB (0 = none).  Mirror of
    tools/runner._declared_tenant_reservation_bytes, in MB:
      1. WEIZIGO_HOST_TENANT_RESERVATION_MB — declared reservation, verbatim
         (including 0 = explicitly no tenant);
      2. when the available reading is INJECTED, no auto-detection runs —
         the test owns the whole scenario, a tenant must be declared;
      3. otherwise: the summed RSS of every process whose command carries
         `ollama runner --mlx-engine` (the resident MLX engine — the
         multi-GB holder).  No match ⇒ 0."""
    injected = os.environ.get("WEIZIGO_HOST_TENANT_RESERVATION_MB")
    if injected is not None:
        try:
            return int(injected)
        except ValueError:
            return 0
    if os.environ.get("WEIZIGO_HOST_MEM_AVAIL_MB") is not None:
        return 0
    try:
        out = subprocess.run(
            ["ps", "-axo", "pid=,rss=,command="],
            capture_output=True, text=True, timeout=2.0,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return 0
    if out.returncode != 0:
        return 0
    total = 0
    for line in out.stdout.splitlines():
        if "ollama runner --mlx-engine" not in line:
            continue
        parts = line.split(None, 2)
        if len(parts) < 2:
            continue
        try:
            total += int(parts[1]) // 1024   # ps RSS is in kB
        except ValueError:
            continue
    return total


_session_path_counter = itertools.count()


def _pi_session_path(task_id):
    """Per-lane pi session file for the token meter (T662).

    `pi --session <path>` writes its session JSONL to exactly this file;
    the runner reads it after the lane closes and records the usage split
    (fresh vs cache_read) in the run record, trailer and ledger.  The path
    is unique per dispatch attempt — T792: the original `int(time.time())`
    (whole-second) formula let two attempts of the same task launched
    within one wall-clock second collide on the same filename, exactly the
    overwrite T650/T662 exist to prevent.  `time.time_ns()` alone is not
    sufficient EITHER — on this host two calls a few instructions apart can
    still land on the same clock tick — so the path also carries the pid
    (disambiguates concurrent processes at the same tick) and a per-process
    monotonic counter (disambiguates repeated calls within one process).
    Nothing parses this timestamp, so widening the format is safe.  Lives
    under untracked/tokens/ (the capture home); the runner mkdirs the
    parent at launch."""
    ident = task_id if task_id else "lane"
    return (f"untracked/tokens/sessions/{ident}.{time.time_ns()}."
            f"{os.getpid()}.{next(_session_path_counter)}.jsonl")


def run_worker(cmd, cwd, env):
    """Run the worker, streaming its stdout to the parent while capturing it."""
    proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE,
                            text=True, bufsize=1)
    chunks = []
    for line in proc.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        chunks.append(line)
    rc = proc.wait()
    return rc, "".join(chunks)


def parse_argv(argv):
    """Split argv into (positional args, flags dictionary)."""
    args, flags, i = [], {}, 0
    while i < len(argv):
        a = argv[i]
        if a in ("--model", "--wall", "--provider", "--thinking") and i + 1 < len(argv) and not argv[i + 1].startswith("--"):
            flags[a.lstrip("-")] = argv[i + 1]
            i += 2
            continue
        if "=" in a and a.startswith("--"):
            k, v = a.split("=", 1)
            flags[k.lstrip("-")] = v
            i += 1
            continue
        if a.startswith("--"):
            flags[a.lstrip("-")] = True
            i += 1
            continue
        args.append(a)
        i += 1
    return args, flags


def _resolve_model(provider, raw_model, flags):
    """→ (canonical, live_tag, error).  Turn a provider + raw dispatch tag
    into the canonical label bin/managent's canonical_models[] expects (the
    same fact surface as docs/infra/model-registry.md and
    src/managent/main.zig's canonicalizeModelTag), AND the ONE live serving
    tag the host dispatches with (T890: derived from the canonical, never
    the hand-typed one).  `error` is None on success and a ready-to-print
    message (for `sys.exit`) otherwise; on error both canonical and
    live_tag are None.

    A bare `--model` with no value parses as flags['model'] is True
    (parse_argv), not a string; treating that the same as "missing" (T792
    fix) avoids a TypeError crash that `re.sub(..., True)` used to raise
    for the ollama branch below when a caller passed the flag with no tag.

    T890 closes the T792 gap the old docstring named: an unrecognized tag
    (e.g. the retired kimi-k2-thinking:cloud) is now REFUSED — it
    canonicalizes to a label that is not in the live-tag map, so the
    boundary says so, instead of silently producing a non-canonical label
    a human would never see until the lane died in 0.9 s."""
    if raw_model is True:
        raw_model = None
    if provider == "deepseek":
        # DeepSeek: model is chosen from --dspro/--dsflash flags
        chosen_ds = [f"--{k}" for k in ("dspro", "dsflash") if flags.get(k) is True]
        if len(chosen_ds) != 1:
            return None, None, "subagent: for --provider deepseek, name exactly one model — --dspro or --dsflash"
        canon = DS_MODELS[chosen_ds[0]]
        return canon, canon, None  # no serving tag — the label IS the model
    if provider == "claude":
        # Claude: --model <canonical claude label> is required; the label is
        # passed straight to `claude -p --model`, so it must be canonical.
        if not raw_model:
            return None, None, ("subagent: for --provider claude, --model <canonical claude label> "
                          "is required\n  canonical: " + ", ".join(sorted(CLAUDE_MODELS)) + "\n")
        if raw_model not in CLAUDE_MODELS:
            return None, None, (f"subagent: '{raw_model}' is not a canonical claude label.\n"
                          f"  canonical: {', '.join(sorted(CLAUDE_MODELS))}\n")
        return raw_model, raw_model, None  # label IS the model
    if provider == "pi":
        # T732/T890: --model is the serving tag (stealth/ox-alpha) OR the
        # canonical label (ox-alpha); the canonical label is what the
        # ledger stores, the live serving tag is what pi launches.  A
        # hand-typed serving tag is accepted only as input convenience.
        if not raw_model:
            return None, None, "subagent: for --provider pi, --model <canonical label or serving tag> is required\n"
        canon = PI_TAG_TO_CANONICAL.get(raw_model)
        if canon is None and raw_model in CANONICAL_TO_PI_TAG:
            canon = raw_model  # the caller named the canonical label itself
        if canon is None:
            return None, None, (f"subagent: '{raw_model}' is not a known pi canonical label or serving tag.\n"
                          f"  canonical: {', '.join(sorted(CANONICAL_TO_PI_TAG))}\n")
        return canon, CANONICAL_TO_PI_TAG[canon], None
    # ollama
    if not raw_model:
        return None, None, "subagent: for --provider ollama, --model <canonical label or serving tag> is required\n"
    canon = OLLAMA_TAG_TO_CANONICAL.get(raw_model)
    if canon is None:
        canon = re.sub(r":cloud$", "", raw_model)
    if canon not in CANONICAL_TO_OLLAMA_TAG:
        return None, None, (f"subagent: REFUSED — '{raw_model}' canonicalizes to '{canon}', "
                      f"not a known ollama canonical model (T890).\n"
                      f"  canonical: {', '.join(sorted(CANONICAL_TO_OLLAMA_TAG))}\n")
    return canon, CANONICAL_TO_OLLAMA_TAG[canon], None


def _build_lane_argv(provider, model, live_tag, prompt, task_id,
                         wall, arbiter_flags, rss_mb, thinking_level):
    """Construct the lane argv + telemetry record from LANE_SPECS (T891).

    Replaces the four per-provider builders that had drifted: deepseek got
    --mode json + --session, ollama got --session only, pi got NEITHER (the
    defect — the least observable lane we dispatch), claude got
    --output-format json and no meter.  One table drives one builder, so the
    argv and the telemetry annotation cannot drift apart again.

    thinking_level is None (today's default — preserve, no re-baseline) or a
    pi --thinking level; it is threaded to every pi-routed child and NEVER to
    claude (claude uses --effort, not pi --thinking).

    Returns (cmd, telemetry): cmd is the full tools/runner argv; telemetry is
    a dict for the dry-run TELEMETRY line + the stderr reason note.
    """
    spec = LANE_SPECS[provider]
    base = ["tools/runner", "--max-wall", wall, *arbiter_flags]
    if rss_mb:
        base.extend(["--rss-cap-mb", rss_mb])

    session_path = None
    meter_reason = spec["meter_reason"]
    thinking = thinking_level
    mode_json = spec["mode_json"]

    if provider == "claude":
        # The headless Claude Code harness.  Token meter = the
        # --output-format json envelope (captured by the runner at
        # completion); no pi --session exists for claude, and the in-flight
        # rate is Unknown(buffered) — a NAMED reason, never a silent blank
        # (S11 trivalence).  --thinking is NOT threaded (claude uses --effort).
        if thinking_level is not None:
            sys.stderr.write(
                "[subagent] T891 NOTE: --thinking ignored for claude "
                "(claude uses --effort, not pi --thinking)\n")
            thinking = None
        cmd = [*base, "--",
               "claude", "-p", prompt, "--model", model,
               "--allowedTools", CLAUDE_ALLOWED_TOOLS,
               "--output-format", "json"]
    elif provider == "ollama":
        # ollama launch pi — the inner pi gets the --session meter and
        # (when set) --thinking.  ollama streams stdout itself, so --mode
        # json is NOT added (spec mode_json=False); the runner's pi-session
        # mtime sensor (T773) is the liveness signal for these lanes.
        session_path = _pi_session_path(task_id)
        inner = ["--session", session_path]
        if thinking is not None:
            inner.extend(["--thinking", thinking])
        inner.extend(["-p", prompt])
        cmd = [*base, "--",
               "ollama", "launch", "pi", "--model", live_tag, "-y", "--",
               *inner]
    else:  # deepseek or pi (openrouter) — both run the `pi` binary
        session_path = _pi_session_path(task_id)
        pi_provider = "deepseek" if provider == "deepseek" else "openrouter"
        pi_model = model if provider == "deepseek" else live_tag
        cmd = [*base, "--",
               "pi", "--provider", pi_provider, "--model", pi_model]
        if mode_json:
            cmd.extend(["--mode", "json"])
        cmd.extend(["--session", session_path])
        if thinking is not None:
            cmd.extend(["--thinking", thinking])
        cmd.extend(["-p", prompt])

    telemetry = {
        "provider": provider,
        "mode_json": "yes" if mode_json else "no",
        "session": session_path if session_path else "-",
        "thinking": thinking if thinking else "-",
        "meter_reason": meter_reason,
        "liveness": spec["liveness"],
    }
    return cmd, telemetry


def main(argv):
    args, flags = parse_argv(argv)
    provider = flags.get("provider")

    # C2.1: --provider is REQUIRED
    if not provider:
        sys.exit("subagent: missing --provider (deepseek|ollama|claude|pi)\n" + __doc__)
    if provider not in PROVIDERS:
        sys.exit(f"subagent: unknown provider '{provider}' — must be one of "
                 f"{', '.join(sorted(PROVIDERS))}\n")

    # Depth cap (shared, before provider branch — NF2 resolved)
    try:
        depth = int(os.environ.get(DEPTH_VAR, "1"))
    except ValueError:
        depth = MAX_DEPTH
    if depth >= MAX_DEPTH:
        sys.exit(f"subagent: REFUSED — you are at the delegation cap (depth {depth} "
                 f"of {MAX_DEPTH}). The chain has to end somewhere and it ends with "
                 f"you.\nWrite your output to a file or return it to your manager, "
                 f"then stop.\nIf the task genuinely needs delegating, say so and let "
                 f"your manager decide.")

    target = args[0] if args else None
    if not target or len(args) != 1:
        sys.exit(__doc__)

    wall = flags.get("wall", "1800")
    rss_mb = flags.get("rss-cap-mb")  # deepseek only
    raw_model = flags.get("model")    # ollama only
    test_root = flags.get("test-root")
    test_worker = flags.get("test-worker")
    dry_run = "dry-run" in flags
    root = os.path.abspath(test_root) if test_root else ROOT

    # T891 (amendment 2): --thinking <level>, threaded to every pi-routed
    # provider (deepseek/ollama/pi); claude is NOT pi-routed (it uses --effort).
    # Default = None (do not pass --thinking), which preserves today's behaviour
    # exactly — no re-baselining of existing metrics rows, which were measured
    # under pi's unexposed internal default.
    thinking_level = flags.get("thinking")
    if thinking_level is True or thinking_level in ("", None):
        thinking_level = None
    elif thinking_level not in PI_THINKING_LEVELS:
        sys.exit(f"subagent: REFUSED — --thinking {thinking_level!r} is not a "
                 f"pi thinking level.  canonical: {', '.join(PI_THINKING_LEVELS)}\n")

    # ── Resolve model ──────────────────────────────────────────────────
    model, live_tag, resolve_err = _resolve_model(provider, raw_model, flags)
    if resolve_err:
        sys.exit(resolve_err)

    # T890 arm A — a hand-typed serving tag must match the derived LIVE tag.
    # The serving tag used for launch is ALWAYS re-derived from the canonical
    # label; a hand-typed serving tag is accepted only as input convenience.
    # If it does not match the derived live tag, it is the dead-tag class
    # (kimi-k2.7:cloud canonicalizes to kimi-k2.7 but the host serves
    # kimi-k2.7-code:cloud) — REFUSED by name, before any host check, so the
    # operator never launches kimi into a 0.9-second death reported as a
    # nonce failure.  bin/dispatch is immune (it re-derives from its MODELS
    # table); this gives bin/subagent the same immunity at the launch door.
    if provider in ("ollama", "pi") and raw_model and raw_model is not True \
       and raw_model != model and raw_model != live_tag:
        offered_line = ""
        if provider == "ollama":
            _off = _ollama_offered_tags()
            if _off is not None:
                offered_line = "\n  host offers: " + ", ".join(sorted(_off))
        sys.exit(
            f"subagent: REFUSED — serving tag {raw_model!r} does not match the "
            f"live serving tag {live_tag!r} for canonical model {model!r} (T890).\n"
            f"  The serving tag is derived from the canonical label, never the "
            f"hand-typed one. Name the canonical label {model!r}; the live "
            f"serving tag {live_tag!r} is what the host dispatches.{offered_line}\n")

    # ── declared-need admission (T821, ORC-GD-1/ORC-G5) ──────────────────
    # Every lane declares a peak RSS need and is checked against what
    # tools/runner's ONE arbiter has already admitted — never just local
    # ollama lanes (the T713 gate this replaces).  This is the launch
    # chokepoint (T677/D040), so bin/dispatch's own gate stays advisory.
    # A --dry-run previews the SAME verdict the arbiter would reach
    # WITHOUT reserving memory for work that will never run (the arbiter
    # is a subprocess call, not a re-implementation — ORC-G5 "one
    # arbiter").  The real launch below passes --ram-mb/--arbiter-id
    # through on the SAME tools/runner invocation that wraps the worker,
    # so a real refusal there means nothing was ever spawned.
    # T890: pass live_tag (the derived serving tag), not raw_model, so a
    # canonical-label input (e.g. kimi-k2.7) declares the CLOUD figure — its
    # live tag kimi-k2.7-code:cloud carries :cloud — not the resident 18 GB
    # figure the bare canonical would imply.
    ram_mb = _declared_ram_mb(provider, live_tag, flags)
    arbiter_id = target  # stable per dispatch: the T-id or the file path
    override_admission = flags.get("override-admission")
    if override_admission is True:   # bare flag, no value
        sys.exit("subagent: --override-admission requires a reason: "
                 "--override-admission=<reason> (T821).\n"
                 "  The flag exists for 'I have checked the host myself; "
                 "proceed', not for convenience.")
    override_admission = (override_admission or "").strip()
    # ROOT, not `root`: tools/runner is project infrastructure, always the
    # real repo's copy (mirrors how bin/dispatch resolves bin/subagent
    # itself from ROOT — "the managent binary always comes from the real
    # repo; --test-root only affects bundle/log resolution").  A relative
    # "tools/runner" resolved against a --test-root scratch cwd has no
    # tools/ directory at all and crashes with FileNotFoundError — caught
    # live by tools/regression-fleet-keeper.sh, which dispatches through a
    # scratch --test-root on every arm.
    preview = subprocess.run(
        [os.path.join(ROOT, "tools", "runner"), "--arbiter-preview",
         "--arbiter-id", arbiter_id, "--ram-mb", str(ram_mb)],
        cwd=root, capture_output=True, text=True)
    if preview.stderr:
        sys.stderr.write(preview.stderr)
    if preview.returncode != 0:
        if override_admission:
            print(f"subagent: WARNING — admission OVERRIDDEN for this launch "
                  f"by operator reason {override_admission!r} (T821); the "
                  f"host is tight and the lane may compete for memory",
                  file=sys.stderr)
        else:
            sys.exit(
                "subagent: REFUSED — declared need does not fit "
                "(docs/infra/host/ram-policy.md).\n"
                "  If you have checked the host yourself, launch with a "
                "recorded reason: --override-admission=<reason> (T821).\n")

    # ── provider-window gate (T628 + T677): the real launch chokepoint ──
    # bin/dispatch gates too, but subagent is where every lane actually
    # launches — a gate only in dispatch is advisory (D040/T612: tonight's
    # probe lane went around it via subagent).  A family in window cooldown
    # refuses HERE with the same recorded override escape hatch.  The
    # cooldown arms only from a terminal run record of a lane of that
    # family (T677) — worker stdout is not evidence — so enforcement is
    # safe: the false-arm class that locked claude out tonight is gone.
    fam = window_policy.family_of(model)
    if fam != "other":
        now = time.time()
        c = window_policy.family_cooldown(root, now).get(fam)
        if c is not None:
            override_reason = (flags.get("override-window-cooldown") or "").strip()
            if override_reason:
                if not dry_run:
                    window_policy.record_override(
                        root, task_id if task_id else (target or "?"),
                        fam, c, override_reason, now)
                print(f"subagent: WARNING — window cooldown for family {fam} "
                      f"OVERRIDDEN for this launch by operator reason "
                      f"{override_reason!r} (T677)", file=sys.stderr)
            else:
                fallback_note = ""
                if c.get("fallback"):
                    fallback_note = (
                        "\n"
                        f"  The reset could not be parsed, so this is a SHORT fallback "
                        f"cooldown (probe scheduled for the reset time above); the "
                        f"watcher re-checks the provider with ONE lane then.  If you "
                        f"have checked the provider yourself, override with "
                        f"--override-window-cooldown=<reason> (T677).")
                sys.exit(
                    f"subagent: REFUSED — family {fam} is in window cooldown until "
                    f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(c['until']))} "
                    f"(reset {c.get('reset_text') or '?'!r} from {c.get('source') or '?'}) "
                    f"(T628).\n"
                    f"  The provider's 5-hour window limit is still in force; a lane now "
                    f"would die of the same limit (2026-08-22 12:47Z: five claude lanes "
                    f"re-fired into the dead window).  This gate is ENFORCED at "
                    f"subagent — every lane launch, dispatch or hand (T677/D040)."
                    + fallback_note)

    # ── Nonce ──────────────────────────────────────────────────────────
    nonce = dispatch_verify.generate_nonce()

    # ── Task resolution ────────────────────────────────────────────────
    task_id = None
    deliverables = []
    if re.fullmatch(r"T\d+", target):
        hits = glob.glob(os.path.join(root, "untracked", f"{target}-*.md"))
        if len(hits) != 1:
            sys.exit(f"subagent: expected one bundle for {target}, found {len(hits)}")
        bundle = os.path.relpath(hits[0], root)
        task_id = target
        slug = re.sub(rf"^{target}-|\.md$", "", os.path.basename(bundle))
        deliverables = dispatch_verify.parse_deliverables(
            hits[0], f"findings/{target}-{slug}.json")
        dl_lines = "\n".join(f"  - {d}" for d in deliverables)
        delegate_note = (
            "You are a manager: you may dispatch your own sub-rows with "
            "bin/subagent or bin/ollama-subagent, and you never ask the human "
            "to relay a dispatch. The brief carries everything.\n\n"
            if depth + 1 < MAX_DEPTH else
            "You are a leaf: you are at the delegation cap and do not dispatch. "
            "The brief carries everything.\n\n"
        )
        prompt = (f"Follow {bundle}\n\n"
                  f"BEFORE READING THE BUNDLE: run `bin/managent orient` — it prints the\n"
                  f"≤150-line worker preamble (principles, live gates, the kanban, fresh\n"
                  f"activity) composed at read time, replacing the AGENTS.md/DELEGATEE.md/\n"
                  f"sprint.md/DIRECTION.md/WAYPOINTS.md/STATE.md reading list. The bundle and\n"
                  f"the sprint's ratified spec/plan are still required; orient is the\n"
                  f"preamble, not a replacement for them.\n\n"
                  f"FIRST: bin/managent claim {target} --agent {model}\n"
                  + delegate_note
                  + f"{dispatch_verify.nonce_prompt_lines(nonce)}"
                  f"WHEN DONE, before any other output:\n"
                  f"  Deliverables declared by the bundle (managent done checks every one):\n"
                  f"{dl_lines}\n"
                  f"  1. Write these files per findings/README.md\n"
                  f"  2. bin/managent done {target} --agent {model} --status <pass|pass-with-findings|"
                  f"fail-found|blocked|abandoned> --note <one line> --impression <one line> (or\n"
                  f"     --impression-waiver <reason> when no impression is owed)\n\n"
                  f"INBOX LOOP (T352):\n"
                  f"  The human used to relay messages between consoles by hand. That relay\n"
                  f"  is now a `managent tell` directive you can poll for.  At each natural\n"
                  f"  checkpoint — after a commit, before starting a new sub-step, and\n"
                  f"  before reporting done — run:\n"
                  f"      bin/managent inbox {target} --ack\n"
                  f"  A directive of `pause`, `amend` or `question` is actionable: act on\n"
                  f"  it and record the directive ID (D0NN) in your findings file's\n"
                  f"  `notes` field, so the Orchestrator can see you read it.  A directive\n"
                  f"  of `kill` writes your context dump and exits.  An empty inbox is a\n"
                  f"  no-op (do not be alarmed).  The brief carries everything else.\n")
    elif os.path.isfile(target):
        prompt = f"Follow {os.path.relpath(os.path.abspath(target), root)}\n"
        prompt += "\n" + dispatch_verify.nonce_prompt_lines(nonce)
        deliverables = dispatch_verify.parse_deliverables(os.path.abspath(target))
    else:
        sys.exit(f"subagent: no such task or file: {target}")

    # ── Environment ────────────────────────────────────────────────────
    if provider == "deepseek" and not test_worker:
        if not os.environ.get("DEEPSEEK_API_KEY"):
            sys.exit("subagent: DEEPSEEK_API_KEY is not set")
    env = dict(os.environ, **{DEPTH_VAR: str(depth + 1)})
    if task_id:
        env["MANAGENT_TASK_ID"] = task_id

    # T821: the same admission tools/runner already decided (or previewed)
    # above, carried through on the real launch — --arbiter-id is
    # independent of --task-id (which also triggers managent claim/done).
    arbiter_flags = ["--ram-mb", str(ram_mb), "--arbiter-id", arbiter_id]
    if override_admission:
        arbiter_flags.extend(["--override-admission", override_admission])

    # ── T890 arm B — validate the derived live tag against the host ────
    # For an ollama lane, the derived live tag is checked against what the
    # host actually serves BEFORE any child is spawned, and refused by
    # name if absent — never launch into a 0.9-second death.  The host
    # offering comes from `ollama list` (WEIZIGO_OLLAMA_OFFERED injects it
    # for tests, mirroring WEIZIGO_HOST_MEM_AVAIL_MB).  If the offering is
    # unknowable (ollama unreachable, env unset), the check is SKIPPED: a
    # real launch surfaces the failure itself, a dry-run previews the
    # command.  This is the arm that stops the bug class returning — a
    # model whose tag stopped being served is refused here, not reported
    # as a nonce failure after a 0.9-second death.
    if provider == "ollama":
        _offered = _ollama_offered_tags()
        if _offered is not None and live_tag not in _offered:
            sys.exit(
                f"subagent: REFUSED — model {model!r} resolves to serving tag "
                f"{live_tag!r}, which the host does not serve (T890).\n"
                f"  tag tried: {live_tag}\n"
                f"  host offers: {', '.join(sorted(_offered))}\n"
                f"  Never launch into a 0.9-second death; name the canonical "
                f"label {model!r} and let the dispatcher derive a tag the host "
                f"serves.\n")

    # ── Build command ──────────────────────────────────────────────────
    if test_worker:
        cmd = [test_worker, prompt]
        telemetry = {"provider": provider, "mode_json": "no",
                     "session": "-", "thinking": "-",
                     "meter_reason": "test-worker stub: no provider argv (test mode)",
                     "liveness": "test-worker"}
    else:
        cmd, telemetry = _build_lane_argv(
            provider, model, live_tag, prompt, task_id, wall,
            arbiter_flags, rss_mb, thinking_level)

    if dry_run:
        print(f"{DEPTH_VAR}={depth + 1}")
        if task_id:
            print(f"MANAGENT_TASK_ID={task_id}")
        print(" ".join(repr(c) if "\n" in c else c for c in cmd))
        # T891: the telemetry annotation records, per provider, what telemetry
        # the lane supplies and a NAMED reason where it cannot — so a silent
        # UNKNOWN (the defect) can never stand in for "nobody asked".  The
        # regression asserts every provider's line; meter_reason is last
        # because it may carry spaces.
        print(f"TELEMETRY: provider={telemetry['provider']} "
              f"mode_json={telemetry['mode_json']} "
              f"session={telemetry['session']} "
              f"thinking={telemetry['thinking']} "
              f"meter_reason={telemetry['meter_reason']}")
        return 0

    # A lane that cannot supply an in-flight session meter says so loudly at
    # launch (claude).  The on-screen display is a watch-fleet follow-up;
    # this note is the dispatch-time record that the reason is not a blank.
    if telemetry["meter_reason"]:
        print(f"[subagent] T891 TELEMETRY: provider={telemetry['provider']} "
              f"session={telemetry['session']} "
              f"meter_reason={telemetry['meter_reason']}", file=sys.stderr)

    t_run0 = time.monotonic()
    rc, stdout = run_worker(cmd, root, env)
    wall_seconds = time.monotonic() - t_run0

    # ── T411: verify the WORK, never the reply ────────────────────────
    t0 = time.monotonic()
    exit_code, summary, details, perf = dispatch_verify.verify_dispatch(
        root=root, task_id=task_id, model=model, nonce=nonce, stdout=stdout,
        rc=rc, store_env=os.environ.get("MANAGENT_STORE"),
        deliverables=deliverables)
    verify_ms = (time.monotonic() - t0) * 1000.0
    print(f"[verify] {summary}", file=sys.stderr)
    for line in details:
        print(f"[verify]   {line}", file=sys.stderr)
    print(f"[verify] verification phase took {verify_ms:.0f} ms", file=sys.stderr)
    dispatch_verify.record_perf(root, perf)

    # ── T477: heal the one wound the dispatcher can heal ───────────────
    # If verification failed AND the worker died (rc != 0) leaving the row
    # in_progress, reopen it so it returns to dispatchable — the process
    # that watched the worker die is still running and already knows. Heal
    # ONLY this case; every other failure is left for the Orchestrator.
    if exit_code != 0:
        try:
            healed, heal_line = dispatch_verify.heal_dispatch(
                root=root, real_root=ROOT, task_id=task_id, model=model,
                rc=rc, wall_seconds=wall_seconds,
                store_env=os.environ.get("MANAGENT_STORE"))
            if heal_line:
                print(f"[verify] {heal_line}", file=sys.stderr)
        except Exception as e:
            # T631 invariant: a crashed heal must never leave a row SILENTLY
            # in_progress.  The heal is the one automatic reopen; if it dies
            # (a committed bug, a disk fault — anything the pin cannot cover),
            # the row is left for a human but flagged loudly and recorded in
            # the heals census, so the T616 zombie cannot recur unseen.
            if task_id is not None:
                _flag_manual_heal(task_id, model, rc, wall_seconds, e)
    return exit_code


def _flag_manual_heal(task_id, model, rc, wall_seconds, exc):
    """T631: record a heal that crashed as needing a MANUAL heal.

    Self-contained (stdlib only, no dispatch_verify calls) so a broken
    contract cannot break the marker that flags its own breakage.  Appends a
    `needs_manual_heal` record to the same heals log heal_dispatch writes
    (WEIZIGO_DISPATCH_HEALS or docs/infra/dispatch-heals.jsonl) and prints a
    loud [verify] line.  The record still carries healed_by=dispatcher — the
    dispatcher is the actor (F4/T513: the heals log is the census of who
    reopens; any record not carrying it is a second owner) — but `healed:
    false` marks it as NO reopen having happened.
    """
    import json
    rec = {
        "task_id": task_id,
        "model": model,
        "exit_code": rc,
        "wall_seconds": round(wall_seconds, 1),
        # F4/T513: "dispatcher" duplicates dispatch_verify.HEAL_OWNER on
        # purpose — a broken contract must not be able to break the marker.
        "healed_by": "dispatcher",
        "healed": False,
        "needs_manual_heal": True,
        "error": "%s: %s" % (type(exc).__name__, exc),
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    path = (os.environ.get("WEIZIGO_DISPATCH_HEALS")
            or os.path.join(ROOT, "docs", "infra", "dispatch-heals.jsonl"))
    try:
        with open(path, "a") as f:
            f.write(json.dumps(rec) + "\n")
        note = "marker appended to %s" % path
    except OSError as e:
        note = "MARKER WRITE FAILED (%s)" % e
    print("[verify] HEAL CRASHED for %s (%s: %s) — row may be in_progress and "
          "needs a MANUAL heal; %s"
          % (task_id, type(exc).__name__, exc, note), file=sys.stderr)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
