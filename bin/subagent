#!/usr/bin/env python3
"""Dispatch a worker.  bin/subagent --provider <deepseek|ollama|claude|pi> <T-ID|path.md> [--model <tag>] [--wall=N] [--rss-cap-mb=N] [--dry-run]

  --provider deepseek    dispatch via DeepSeek (requires DEEPSEEK_API_KEY)
  --provider ollama      dispatch via Ollama (requires --model <tag>)
  --provider pi          dispatch via the pi harness, openrouter backend (requires --model <serving tag>)
  --model <tag>          Ollama model tag, e.g. glm-5.2:cloud (ollama only)
  --wall=N               wall-clock guard, default 1800s
  --rss-cap-mb=N         RSS cap in MB, default 4096 (deepseek only)
  --dry-run              print the command, spawn nothing
  --override-window-cooldown=<reason>
                         bypass the T628 window-cooldown refusal for THIS
                         launch only, with the operator's reason REQUIRED
                         and recorded (append-only,
                         untracked/fleet-window-overrides.jsonl — the T677
                         escape hatch, in the --allow-unisolated spirit).
                         subagent is where every lane actually launches, so
                         the cooldown is ENFORCED here (T677/D040) — a
                         gate only in bin/dispatch is advisory, and the
                         probe lane went around it tonight.
  --ram-mb=N             declared peak RSS need in MB (ORC-GD-1); overrides
                         the per-provider default (T821,
                         docs/infra/host/ram-policy.md).
  --override-admission=<reason>
                         bypass an admission REFUSAL for THIS launch only,
                         with the operator's reason REQUIRED (printed
                         loudly, nothing recorded — the per-launch human
                         decision, the --allow-unisolated spirit).  T821
                         replaces the T713 local-model-only gate with
                         admission for EVERY lane: the declared need (a
                         registry figure for a resident local model, a
                         per-provider default otherwise) is checked against
                         what tools/runner's arbiter has already admitted;
                         list-wait is the intended behaviour — killing a
                         running lane is not.

  test-only flags (T411 — the regression uses them; production dispatches never do):
  --test-root=<dir>    resolve the repo from <dir> instead of the script location
  --test-worker=<cmd>  run <cmd> <prompt> instead of the real worker, so a
                       stub worker can exercise the full dispatch+verify path
                       without an LLM (tools/regression-dispatch-verification.sh)

bin/subagent dispatches either a DeepSeek or Ollama worker, selected by the
REQUIRED --provider flag. A bare call exits non-zero naming "provider" (C2.1).

Workers can reach Ollama models through `ollama launch pi` — the depth cap
stops bin/subagent recursion but does not stop Ollama launches (T320, 2026-08-03).
Claude seats run from the Claude Code harness (`claude -p`); a non-Claude
worker may launch a headless claude -p session (T494, correcting the prior
reading of the rule — docs/infra/agents/subdelegation.md:152-156: the
prohibition is about the harness, not the dispatcher: Claude must never run
*inside* a pi/Ollama process driving the Anthropic API). Depth increments per
dispatch and refuses at MAX_DEPTH (3), so a manager may delegate a manager
and the chain still ends. The depth cap stops runaway recursion; it is not a
security boundary — see docs/infra/agents/subdelegation.md.

Dispatch verification (T411, 2026-08-07): an agent that replies "OK." and
runs nothing is the most dangerous defect this project has seen (T408/kimi).
After the worker returns, this script verifies the WORK mechanically — the
injected nonce appears in the captured stdout, every declared deliverable
exists, and the kanban row left `dispatchable` — and fails the dispatch
(exit 2, loud report naming every failing check) when a success claim does
not hold. The worker's text is never trusted. See tools/dispatch_verify.py.
"""
import glob, itertools, os, re, subprocess, sys, time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# T677: the provider-window policy (reset watcher + token meter) is read
# here as well as in bin/dispatch — subagent is the real launch chokepoint
# (D040/T612: tonight's probe lane went around dispatch's gate via
# subagent).  Working-tree import, same as bin/dispatch; window_policy is
# my own serial-held file (T677 holds=).
sys.path.insert(0, os.path.join(ROOT, "tools"))
import window_policy  # noqa: E402


def _load_pinned_dispatch_verify():
    """T631: import the dispatch contract from HEAD, never the working tree.

    The 2026-08-22 T616 incident: T625's worker was mid-edit on
    tools/dispatch_verify.py when T616's lane started; the import read a
    half-written copy (valid syntax, broken semantics — heal_dispatch had
    lost its directive_kill initialisation) and the heal crashed with
    `UnboundLocalError: local variable 'directive_kill' referenced before
    assignment`, leaving T616 a silent in_progress zombie — the only lane of
    that outage not reopened.  `holds` protects writers of a file from each
    other; nothing protected the in-flight dispatches that READ it, and every
    live lane reads this module at exit.

    Fix: load the module from the committed revision — `git show
    HEAD:tools/dispatch_verify.py` reads the object database, never the
    working tree, so an in-flight edit cannot reach a running verifier.  The
    committed source is written to a disposable temp file and imported
    through the normal machinery (same module name, real __file__ for
    tracebacks, cached in sys.modules).

    When the pin cannot engage (no git / not a repo / path absent from HEAD
    — e.g. the T513 scratch regression, which extracts the committed
    contract into a scratch tree whose HEAD does not contain it), fall back
    to the working-tree copy WITH a loud warning: in that scratch case the
    fallback IS the committed contract, and refusing would silently break
    dispatch in any environment without git.  WEIZIGO_DISPATCH_VERIFY_UNPINNED=1
    forces the fallback for a developer editing the module (T629/T630) who
    wants to test through bin/subagent without committing first.
    """
    import importlib.util
    import tempfile

    if os.environ.get("WEIZIGO_DISPATCH_VERIFY_UNPINNED") == "1":
        sys.stderr.write("[subagent] T631 WARNING: WEIZIGO_DISPATCH_VERIFY_UNPINNED=1 — "
                         "importing the working-tree dispatch_verify.py; a mid-edit "
                         "file CAN reach this verifier\n")
        sys.path.insert(0, os.path.join(ROOT, "tools"))
        return __import__("dispatch_verify")

    proc = None
    err = None
    try:
        proc = subprocess.run(
            ["git", "-C", ROOT, "show", "HEAD:tools/dispatch_verify.py"],
            capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        err = "git unavailable: %r" % (e,)
    if proc is not None and proc.returncode == 0 and proc.stdout:
        try:
            tmp_dir = tempfile.mkdtemp(
                prefix="t631-pinned-",
                dir="/tmp/weizigo" if os.path.isdir("/tmp/weizigo") else None)
            path = os.path.join(tmp_dir, "dispatch_verify.py")
            with open(path, "w") as f:
                f.write(proc.stdout)
            spec = importlib.util.spec_from_file_location("dispatch_verify", path)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            sys.modules["dispatch_verify"] = mod
            return mod
        except Exception as e:
            err = "pinned import failed: %r" % (e,)
    elif err is None:
        err = ("git show HEAD:tools/dispatch_verify.py exited %d"
               % (proc.returncode if proc is not None else -1))
    sys.stderr.write("[subagent] T631 WARNING: pin failed (%s) — importing the "
                     "working-tree copy of tools/dispatch_verify.py; a mid-edit "
                     "file CAN reach this verifier\n" % err)
    sys.path.insert(0, os.path.join(ROOT, "tools"))
    return __import__("dispatch_verify")


dispatch_verify = _load_pinned_dispatch_verify()

DEPTH_VAR = "WEIZIGO_AGENT_DEPTH"
MAX_DEPTH = 3

# ── provider configuration ─────────────────────────────────────────────────
PROVIDERS = {"deepseek", "ollama", "claude", "pi"}

# T891: per-provider telemetry + argv spec — ONE table, not four drifted
# builders.  Each provider declares how its lane is constructed and what
# telemetry it supplies, so the argv and the telemetry annotation come from
# the same source (scope item 3: the four builders had already drifted
# twice — deepseek got --mode json + --session, ollama got --session only,
# pi got neither, claude got --output-format json and no meter).  Fields:
#   session     'pi_session'  — the lane writes a pi --session JSONL token
#                              meter (deepseek/ollama/pi); watch-fleet reads
#                              untracked/tokens/sessions/T\u003cid\u003e.* for the
#                              in-flight rate, so a --session path is REQUIRED
#                              for a numeric rate on those lanes.
#                'claude_env' — the token meter is the claude --output-format
#                              json envelope captured by the runner at
#                              completion; the in-flight rate is Unknown until
#                              the lane closes (claude -p buffers).  No --session.
#   mode_json   True — pass --mode json so the pi child streams session events
#                              to stdout in real time (the liveness signal;
#                              the nonce-stall failure mode was a pi worker
#                              producing ZERO stdout and being SIGKILLed mid-work).
#                              False — the harness streams by another path
#                              (ollama streams via ollama; claude uses its
#                              envelope).  Not passed when False.
#   liveness    the stdout-liveness mechanism name (for the telemetry record).
#   meter_reason a NAMED reason (S11 trivalence: Measured / Unknown(reason) /
#                Refused(reason)) when the in-flight token meter cannot be a
#                pi --session JSONL; empty when session == 'pi_session'.
#                A silent UNKNOWN standing in for "nobody asked" is the defect.
#   pi_routed   True for providers that run under the `pi` binary and accept
#                --thinking (deepseek/ollama/pi); False for claude (the Claude
#                Code harness, which uses --effort, not pi --thinking).
LANE_SPECS = {
    "deepseek": {"session": "pi_session", "mode_json": True,
                  "liveness": "pi-json-stdout+session-mtime",
                  "meter_reason": "", "pi_routed": True},
    "ollama":   {"session": "pi_session", "mode_json": False,
                  "liveness": "ollama-stream+session-mtime",
                  "meter_reason": "", "pi_routed": True},
    "pi":       {"session": "pi_session", "mode_json": True,
                  "liveness": "pi-json-stdout+session-mtime",
                  "meter_reason": "", "pi_routed": True},
    "claude":   {"session": "claude_env", "mode_json": False,
                  "liveness": "claude-transcript-mtime",
                  "meter_reason": (
                      "claude -p has no --session flag; per amendment 3 "
                      "it already writes a growing JSONL transcript to "
                      "~/.claude/projects/<slug>/<uuid>.jsonl carrying "
                      "message.usage.output_tokens per assistant turn — the "
                      "right in-flight meter source, already complete; "
                      "watch-fleet does NOT read that dir in production "
                      "(WEIZIGO_CLAUDE_TRANSCRIPT_DIR unset) and its read_tx "
                      "parses type:'message'/usage.output (pi) or top-level "
                      "output_tokens, NOT type:'assistant'/message.usage."
                      "output_tokens, so the in-flight rate is "
                      "Unknown(unread-transcript) — the smallest fix is a "
                      "watch-fleet row (default the claude base + parse the "
                      "assistant shape), not a bin/subagent argv; completion "
                      "tokens come from the --output-format json envelope"),
                  "pi_routed": False},
}

# pi --thinking accepts exactly these levels (pi --help).  An out-of-set
# value is REFUSED at dispatch so a typo never silently runs at the default.
PI_THINKING_LEVELS = ("off", "minimal", "low", "medium", "high", "xhigh", "max")

# DeepSeek model map (flags → canonical labels)
DS_MODELS = {"--dspro": "deepseek-v4-pro", "--dsflash": "deepseek-v4-flash"}

# Claude canonical labels (T317 canonical_models[] — the only claude labels
# bin/subagent admits; the headless `claude -p --model <label>` form runs in
