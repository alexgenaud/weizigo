#!/usr/bin/env python3
"""Dispatch a DeepSeek worker.  bin/subagent <T-ID|path.md> --dspro|--dsflash [--wall=N] [--rss-cap-mb=N] [--dry-run]

  --dspro     DeepSeek-v4-Pro          --wall=N        wall-clock guard, default 1800s
  --dsflash   DeepSeek-v4-Flash        --rss-cap-mb=N  RSS cap in MB, default 4096
                                       --dry-run       print the command, spawn nothing

  test-only flags (T411 — the regression uses them; production dispatches never do):
  --test-root=<dir>    resolve the repo from <dir> instead of the script location
  --test-worker=<cmd>  run <cmd> <prompt> instead of the runner+pi command, so a
                       stub worker can exercise the full dispatch+verify path
                       without an LLM (tools/regression-dispatch-verification.sh)

Bin/subagent dispatches DeepSeek only by construction (hardcoded model list,
requires DEEPSEEK_API_KEY). Workers can reach Ollama models through
`ollama launch pi` — the depth cap stops bin/subagent recursion but does not
stop Ollama launches (T320, 2026-08-03). Claude seats use the Claude Code
harness and must never be dispatched by a non-Claude harness (human rule).
Depth increments per dispatch and refuses at MAX_DEPTH (3), so a manager may
delegate a manager and the chain still ends. The depth cap stops runaway recursion;
it is not a security boundary — see docs/infra/agents/subdelegation.md.

Dispatch verification (T411, 2026-08-07): an agent that replies "OK." and
runs nothing is the most dangerous defect this project has seen (T408/kimi).
After the worker returns, this script verifies the WORK mechanically — the
injected nonce appears in the captured stdout, every declared deliverable
exists, and the kanban row left `dispatchable` — and fails the dispatch
(exit 2, loud report naming every failing check) when a success claim does
not hold. The worker's text is never trusted. See tools/dispatch_verify.py.
"""
import glob, os, re, subprocess, sys, time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "tools"))
import dispatch_verify  # noqa: E402

DEPTH_VAR = "WEIZIGO_AGENT_DEPTH"
# T431: the cap bounds RECURSION; it does not ban delegation. Depth increments
# by one per dispatch and refuses at MAX_DEPTH, so a manager may dispatch a
# manager (which may dispatch a leaf) and the chain still terminates. Before
# T431 every child was stamped 2 and refused at 2, making every child a leaf —
# which meant a sprint console could not dispatch its own phase audits and had
# to ask the human to paste them. That made the operator the transport layer.
MAX_DEPTH = 3
MODELS = {"--dspro": "deepseek-v4-pro", "--dsflash": "deepseek-v4-flash"}
KNOWN = set(MODELS) | {"--dry-run"}


def run_worker(cmd, cwd, env):
    """Run the worker, streaming its stdout to the parent while capturing it.

    The captured stdout is what verification greps for the nonce — the
    runner's argv echo (which also contains the token) goes to stderr, so it
    can never contaminate the check.  stderr is inherited and streams live.
    """
    proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE,
                            text=True, bufsize=1)
    chunks = []
    for line in proc.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        chunks.append(line)
    rc = proc.wait()
    return rc, "".join(chunks)


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    flags = [a for a in argv if a.startswith("--")]
    unknown = [f for f in flags
               if f not in KNOWN
               and not f.startswith("--wall=")
               and not f.startswith("--rss-cap-mb=")
               and not f.startswith("--test-root=")
               and not f.startswith("--test-worker=")]
    if len(args) != 1 or unknown:
        sys.exit((f"subagent: unknown flag(s) {' '.join(unknown)}\n" if unknown else "")
                 + __doc__)

    try:  # fail closed: an unreadable depth is treated as a worker
        depth = int(os.environ.get(DEPTH_VAR, "1"))
    except ValueError:
        depth = MAX_DEPTH
    if depth >= MAX_DEPTH:
        sys.exit(f"subagent: REFUSED — you are at the delegation cap (depth {depth} "
                 f"of {MAX_DEPTH}). The chain has to end somewhere and it ends with "
                 f"you.\nWrite your output to a file or return it to your manager, "
                 f"then stop.\nIf the task genuinely needs delegating, say so and let "
                 f"your manager decide.")

    chosen = [f for f in flags if f in MODELS]
    if len(chosen) != 1:
        sys.exit("subagent: name exactly one model — --dspro or --dsflash")
    model = MODELS[chosen[0]]

    target, wall = args[0], next(
        (f.split("=")[1] for f in flags if f.startswith("--wall=")), "1800")
    rss_mb = next(
        (f.split("=")[1] for f in flags if f.startswith("--rss-cap-mb=")), None)
    test_root = next(
        (f.split("=", 1)[1] for f in flags if f.startswith("--test-root=")), None)
    test_worker = next(
        (f.split("=", 1)[1] for f in flags if f.startswith("--test-worker=")), None)
    root = os.path.abspath(test_root) if test_root else ROOT

    # T411: one random echo token per dispatch; the worker's captured stdout
    # must contain it, or the dispatch fails verification (didn't-read case).
    nonce = dispatch_verify.generate_nonce()

    task_id = None
    deliverables = []
    if re.fullmatch(r"T\d+", target):
        hits = glob.glob(os.path.join(root, "untracked", f"{target}-*.md"))
        if len(hits) != 1:
            sys.exit(f"subagent: expected one bundle for {target}, found {len(hits)}")
        bundle = os.path.relpath(hits[0], root)
        task_id = target
        slug = re.sub(rf"^{target}-|\.md$", "", os.path.basename(bundle))
        # T317 item 5 / T411: the declared deliverables are part of the
        # closing contract — name them in the prompt and verify them after.
        deliverables = dispatch_verify.parse_deliverables(
            hits[0], f"findings/{target}-{slug}.json")
        dl_lines = "\n".join(f"  - {d}" for d in deliverables)
        prompt = (f"Follow {bundle}\n\n"
                  f"FIRST: bin/managent claim {target} --agent {model}\n"
                  f"You are a worker. The brief carries everything.\n\n"
                  f"{dispatch_verify.nonce_prompt_lines(nonce)}"
                  f"WHEN DONE, before any other output:\n"
                  f"  Deliverables declared by the bundle (managent done checks every one):\n"
                  f"{dl_lines}\n"
                  f"  1. Write these files per findings/README.md\n"
                  f"  2. bin/managent done {target} --agent {model} --status <pass|pass-with-findings|"
                  f"fail-found|blocked|abandoned> --note <one line>\n\n"
                  f"INBOX LOOP (T352):\n"
                  f"  The human used to relay messages between consoles by hand. That relay\n"
                  f"  is now a `managent tell` directive you can poll for.  At each natural\n"
                  f"  checkpoint — after a commit, before starting a new sub-step, and\n"
                  f"  before reporting done — run:\n"
                  f"      bin/managent inbox {target} --ack\n"
                  f"  A directive of `pause`, `amend` or `question` is actionable: act on\n"
                  f"  it and record the directive ID (D0NN) in your findings file's\n"
                  f"  `notes` field, so the Orchestrator can see you read it.  A directive\n"
                  f"  of `kill` writes your context dump and exits.  An empty inbox is a\n"
                  f"  no-op (do not be alarmed).  The brief carries everything else.\n")
    elif os.path.isfile(target):
        prompt = f"Follow {os.path.relpath(os.path.abspath(target), root)}\n"
        prompt += "\n" + dispatch_verify.nonce_prompt_lines(nonce)
        # A bare dispatch may still carry a bundle meta header with
        # deliverables=; parse it so the side effects can be verified.
        deliverables = dispatch_verify.parse_deliverables(
            os.path.abspath(target))
    else:
        sys.exit(f"subagent: no such task or file: {target}")

    # Credential by environment, never argv: tools/runner echoes argv and the
    # heartbeat writer records it, so --api-key would leak the key into logs and
    # evidence on every dispatch.
    if not test_worker and not os.environ.get("DEEPSEEK_API_KEY"):
        sys.exit("subagent: DEEPSEEK_API_KEY is not set")
    env = dict(os.environ, **{DEPTH_VAR: str(depth + 1)})
    if task_id:
        env["MANAGENT_TASK_ID"] = task_id

    if test_worker:
        # Test-only path (T411): run the stub worker directly — no runner, no
        # API call — so the regression can exercise the full dispatch+verify
        # path with a seeded worker.
        cmd = [test_worker, prompt]
    else:
        cmd = ["tools/runner", "--max-wall", wall]
        if rss_mb:
            cmd.extend(["--rss-cap-mb", rss_mb])
        cmd.extend(["--", "pi", "--provider", "deepseek", "--model", model, "-p", prompt])
    if "--dry-run" in flags:
        print(f"{DEPTH_VAR}={depth + 1}")
        if task_id:
            # T370: identity is propagated by env so nested runner calls inherit it.
            print(f"MANAGENT_TASK_ID={task_id}")
        print(" ".join(repr(c) if "\n" in c else c for c in cmd))
        return 0

    rc, stdout = run_worker(cmd, root, env)

    # ── T411: verify the WORK, never the reply ────────────────────────────
    t0 = time.monotonic()
    exit_code, summary, details, perf = dispatch_verify.verify_dispatch(
        root=root, task_id=task_id, model=model, nonce=nonce, stdout=stdout,
        rc=rc, store_env=os.environ.get("MANAGENT_STORE"),
        deliverables=deliverables)
    verify_ms = (time.monotonic() - t0) * 1000.0
    print(f"[verify] {summary}", file=sys.stderr)
    for line in details:
        print(f"[verify]   {line}", file=sys.stderr)
    print(f"[verify] verification phase took {verify_ms:.0f} ms", file=sys.stderr)
    dispatch_verify.record_perf(root, perf)
    return exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
