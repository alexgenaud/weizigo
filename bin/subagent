#!/usr/bin/env python3
"""Dispatch a worker.  bin/subagent --provider <deepseek|ollama|claude|pi> <T-ID|path.md> [--model <tag>] [--wall=N] [--rss-cap-mb=N] [--dry-run]

  --provider deepseek    dispatch via DeepSeek (requires DEEPSEEK_API_KEY)
  --provider ollama      dispatch via Ollama (requires --model <tag>)
  --provider pi          dispatch via the pi harness, openrouter backend (requires --model <serving tag>)
  --model <tag>          Ollama model tag, e.g. glm-5.2:cloud (ollama only)
  --wall=N               wall-clock guard, default 1800s
  --rss-cap-mb=N         RSS cap in MB, default 4096 (deepseek only)
  --dry-run              print the command, spawn nothing
  --override-window-cooldown=<reason>
                         bypass the T628 window-cooldown refusal for THIS
                         launch only, with the operator's reason REQUIRED
                         and recorded (append-only,
                         untracked/fleet-window-overrides.jsonl — the T677
                         escape hatch, in the --allow-unisolated spirit).
                         subagent is where every lane actually launches, so
                         the cooldown is ENFORCED here (T677/D040) — a
                         gate only in bin/dispatch is advisory, and the
                         probe lane went around it tonight.
  --override-memory-gate=<reason>
                         bypass the T713 resident-aware memory gate for THIS
                         launch only, with the operator's reason REQUIRED
                         (printed loudly, nothing recorded — the per-launch
                         human decision, the --allow-unisolated spirit).
                         The gate refuses a LOCAL-model lane (provider
                         ollama, non-:cloud tag) when a resident model
                         server is detected and the host reports less than
                         lane-cost + margin MB available; list-wait is the
                         intended behaviour — killing a running lane is not.

  test-only flags (T411 — the regression uses them; production dispatches never do):
  --test-root=<dir>    resolve the repo from <dir> instead of the script location
  --test-worker=<cmd>  run <cmd> <prompt> instead of the real worker, so a
                       stub worker can exercise the full dispatch+verify path
                       without an LLM (tools/regression-dispatch-verification.sh)

bin/subagent dispatches either a DeepSeek or Ollama worker, selected by the
REQUIRED --provider flag. A bare call exits non-zero naming "provider" (C2.1).

Workers can reach Ollama models through `ollama launch pi` — the depth cap
stops bin/subagent recursion but does not stop Ollama launches (T320, 2026-08-03).
Claude seats run from the Claude Code harness (`claude -p`); a non-Claude
worker may launch a headless claude -p session (T494, correcting the prior
reading of the rule — docs/infra/agents/subdelegation.md:152-156: the
prohibition is about the harness, not the dispatcher: Claude must never run
*inside* a pi/Ollama process driving the Anthropic API). Depth increments per
dispatch and refuses at MAX_DEPTH (3), so a manager may delegate a manager
and the chain still ends. The depth cap stops runaway recursion; it is not a
security boundary — see docs/infra/agents/subdelegation.md.

Dispatch verification (T411, 2026-08-07): an agent that replies "OK." and
runs nothing is the most dangerous defect this project has seen (T408/kimi).
After the worker returns, this script verifies the WORK mechanically — the
injected nonce appears in the captured stdout, every declared deliverable
exists, and the kanban row left `dispatchable` — and fails the dispatch
(exit 2, loud report naming every failing check) when a success claim does
not hold. The worker's text is never trusted. See tools/dispatch_verify.py.
"""
import glob, itertools, os, re, subprocess, sys, time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# T677: the provider-window policy (reset watcher + token meter) is read
# here as well as in bin/dispatch — subagent is the real launch chokepoint
# (D040/T612: tonight's probe lane went around dispatch's gate via
# subagent).  Working-tree import, same as bin/dispatch; window_policy is
# my own serial-held file (T677 holds=).
sys.path.insert(0, os.path.join(ROOT, "tools"))
import window_policy  # noqa: E402


def _load_pinned_dispatch_verify():
    """T631: import the dispatch contract from HEAD, never the working tree.

    The 2026-08-22 T616 incident: T625's worker was mid-edit on
    tools/dispatch_verify.py when T616's lane started; the import read a
    half-written copy (valid syntax, broken semantics — heal_dispatch had
    lost its directive_kill initialisation) and the heal crashed with
    `UnboundLocalError: local variable 'directive_kill' referenced before
    assignment`, leaving T616 a silent in_progress zombie — the only lane of
    that outage not reopened.  `holds` protects writers of a file from each
    other; nothing protected the in-flight dispatches that READ it, and every
    live lane reads this module at exit.

    Fix: load the module from the committed revision — `git show
    HEAD:tools/dispatch_verify.py` reads the object database, never the
    working tree, so an in-flight edit cannot reach a running verifier.  The
    committed source is written to a disposable temp file and imported
    through the normal machinery (same module name, real __file__ for
    tracebacks, cached in sys.modules).

    When the pin cannot engage (no git / not a repo / path absent from HEAD
    — e.g. the T513 scratch regression, which extracts the committed
    contract into a scratch tree whose HEAD does not contain it), fall back
    to the working-tree copy WITH a loud warning: in that scratch case the
    fallback IS the committed contract, and refusing would silently break
    dispatch in any environment without git.  WEIZIGO_DISPATCH_VERIFY_UNPINNED=1
    forces the fallback for a developer editing the module (T629/T630) who
    wants to test through bin/subagent without committing first.
    """
    import importlib.util
    import tempfile

    if os.environ.get("WEIZIGO_DISPATCH_VERIFY_UNPINNED") == "1":
        sys.stderr.write("[subagent] T631 WARNING: WEIZIGO_DISPATCH_VERIFY_UNPINNED=1 — "
                         "importing the working-tree dispatch_verify.py; a mid-edit "
                         "file CAN reach this verifier\n")
        sys.path.insert(0, os.path.join(ROOT, "tools"))
        return __import__("dispatch_verify")

    proc = None
    err = None
    try:
        proc = subprocess.run(
            ["git", "-C", ROOT, "show", "HEAD:tools/dispatch_verify.py"],
            capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        err = "git unavailable: %r" % (e,)
    if proc is not None and proc.returncode == 0 and proc.stdout:
        try:
            tmp_dir = tempfile.mkdtemp(
                prefix="t631-pinned-",
                dir="/tmp/weizigo" if os.path.isdir("/tmp/weizigo") else None)
            path = os.path.join(tmp_dir, "dispatch_verify.py")
            with open(path, "w") as f:
                f.write(proc.stdout)
            spec = importlib.util.spec_from_file_location("dispatch_verify", path)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            sys.modules["dispatch_verify"] = mod
            return mod
        except Exception as e:
            err = "pinned import failed: %r" % (e,)
    elif err is None:
        err = ("git show HEAD:tools/dispatch_verify.py exited %d"
               % (proc.returncode if proc is not None else -1))
    sys.stderr.write("[subagent] T631 WARNING: pin failed (%s) — importing the "
                     "working-tree copy of tools/dispatch_verify.py; a mid-edit "
                     "file CAN reach this verifier\n" % err)
    sys.path.insert(0, os.path.join(ROOT, "tools"))
    return __import__("dispatch_verify")


dispatch_verify = _load_pinned_dispatch_verify()

DEPTH_VAR = "WEIZIGO_AGENT_DEPTH"
MAX_DEPTH = 3

# ── provider configuration ─────────────────────────────────────────────────
PROVIDERS = {"deepseek", "ollama", "claude", "pi"}

# DeepSeek model map (flags → canonical labels)
DS_MODELS = {"--dspro": "deepseek-v4-pro", "--dsflash": "deepseek-v4-flash"}

# Claude canonical labels (T317 canonical_models[] — the only claude labels
# bin/subagent admits; the headless `claude -p --model <label>` form runs in
# the Claude Code harness, never through the Anthropic API from here).
CLAUDE_MODELS = {
    "claude-opus-5",
    "claude-sonnet-5",
    "claude-fable-5",
    "claude-haiku-4-5-20251001",
}

# Tools the headless claude session may use (the T481/t490 precedent set).
CLAUDE_ALLOWED_TOOLS = "Read,Write,Edit,Bash,Grep,Glob"

# Ollama tag → canonical model label mapping (must stay in sync with
# src/managent/main.zig canonical_models[] — T317 item 2).
OLLAMA_TAG_TO_CANONICAL = {
    "glm-5.2": "glm-5.2",
    "glm-5.2:cloud": "glm-5.2",
    "minimax-m3": "minimax-m3",
    "minimax-m3:cloud": "minimax-m3",
    "kimi-k2.7": "kimi-k2.7",
    "kimi-k2.7-code": "kimi-k2.7",
    "kimi-k2.7:cloud": "kimi-k2.7",
    "kimi-k2.7-code:cloud": "kimi-k2.7",
    "qwen3.8:27b-mlx": "qwen3.8:27b-mlx",
    "qwen3.8:27b-mlx:cloud": "qwen3.8:27b-mlx",
}

# pi (openrouter) serving tag → canonical label mapping (T732).  The serving
# tag stealth/ox-alpha never reaches the ledger; the stored label is always
# ox-alpha (src/managent/main.zig canonical_models[]).
PI_TAG_TO_CANONICAL = {
    "stealth/ox-alpha": "ox-alpha",
}

# ── resident-aware memory gate (T713) ─────────────────────────────────
# The resident MLX/Ollama model server (`ollama runner --mlx-engine`, the
# qwen 27b MLX engine, ~15–20 GB RSS) is a NAMED tenant OUTSIDE every runner
# process group that reduces the memory budget the fleet may spend.  The
# runner's host guard (T362/T711) already stops reading the tenant as an
# emergency; what this gate adds is the DISPATCH side: when the model server
# is resident, the dispatcher knows the reduced budget (host total minus the
# tenant) and refuses to launch a memory-heavy lane that the host cannot
# physically take — instead of launching it and letting the runner's guard
# kill a running lane when pressure lands (fratricide, T712's job to
# coordinate the response).  Operator intent (T713): list-wait is acceptable
# (the row stays dispatchable, nothing is killed), killing a running lane is
# not.  Cloud-API lanes (deepseek / claude / pi-openrouter / `:cloud` ollama
# tags) keep a small local RSS and dispatch freely — the gate never applies.
#
# Decision rule (active gate, memory-heavy lane only):
#   admit iff available_memory >= lane_cost + margin
# where available_memory is the system-wide reading — which ALREADY reflects
# the tenant's footprint (its RSS is anonymous/wired, not reclaimable), so
# the tenant is what makes the budget reduced and the gate tight.  The
# T711 "available-to-the-fleet = available + tenant" arithmetic is NOT
# applied here: that was for the guard's panic-floor comparison (the tenant
# cancels out of it); a NEW lane cannot reclaim the tenant's RSS, so adding
# it back would let two 16 GB lanes onto a host that fits one.  In-flight
# lanes are charged implicitly — each resident lane lowers the next reading.
#
# Reading is unavailable ⇒ gate inert (cannot measure = cannot refuse, the
# runner guard's stance).  An explicit override (--override-memory-gate=
# <reason>, the --allow-unisolated spirit) launches anyway, loudly.
#
# Test hooks (the same inject-don't-exhaust family as tools/runner's
# WEIZIGO_HOST_MEM_AVAIL_MB / WEIZIGO_HOST_TENANT_RESERVATION_MB):
#   WEIZIGO_HOST_MEM_AVAIL_MB   inject the available-memory reading (MB)
#   WEIZIGO_HOST_TENANT_RESERVATION_MB  declare the resident tenant (MB);
#                               when set, no auto-detection runs (the test
#                               owns the whole scenario — same rule as the
#                               runner); 0 = explicitly no tenant
#   WEIZIGO_HOST_TOTAL_MB       inject total physical memory (MB)
#   WEIZIGO_HOST_MEM_UNAVAIL=1  force the reading to None (inert path)
#   WEIZIGO_LANE_COST_MB        the charge of one memory-heavy lane (MB)

MEMORY_GATE_MARGIN_MB = 2048             # safety margin above a lane's charge
LOCAL_LANE_COST_DEFAULT_MB = 16384       # one 27b MLX model (~15–20 GB)


def _host_total_mb():
    """Total physical memory in MB, or None.  WEIZIGO_HOST_TOTAL_MB injects
    the reading (mirror of tools/runner's WEIZIGO_HOST_MEM_AVAIL_MB hook).
    macOS: `sysctl -n hw.memsize`; Linux: /proc/meminfo MemTotal kB."""
    injected = os.environ.get("WEIZIGO_HOST_TOTAL_MB")
    if injected is not None:
        try:
            return int(injected)
        except ValueError:
            pass  # fall through to the real reading
    if sys.platform == 'linux' and os.path.isdir('/proc'):
        try:
            with open("/proc/meminfo") as f:
                for line in f:
                    if line.startswith("MemTotal:"):
                        return int(line.split()[1]) // 1024
        except (OSError, ValueError, IndexError):
            return None
        return None
    try:
        out = subprocess.run(
            ["sysctl", "-n", "hw.memsize"],
            capture_output=True, text=True, timeout=2.0,
        )
        if out.returncode == 0 and out.stdout.strip():
            return int(out.stdout.strip()) // (1024 * 1024)
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


def _host_avail_mb():
    """System-wide available memory in MB, or None.  WEIZIGO_HOST_MEM_AVAIL_MB
    injects the reading (MB, verbatim — the same hook tools/runner uses, so
    the T714 fixture vocabulary applies); WEIZIGO_HOST_MEM_UNAVAIL=1 forces
    None (the gate's inert path).  macOS: vm_stat reclaimable page classes
    (free + inactive + purgeable + speculative) × page size; Linux:
    /proc/meminfo MemAvailable kB."""
    if os.environ.get("WEIZIGO_HOST_MEM_UNAVAIL") == "1":
        return None
    injected = os.environ.get("WEIZIGO_HOST_MEM_AVAIL_MB")
    if injected is not None:
        try:
            return int(injected)
        except ValueError:
            pass  # fall through to the real reading
    if sys.platform == 'linux' and os.path.isdir('/proc'):
        try:
            with open("/proc/meminfo") as f:
                for line in f:
                    if line.startswith("MemAvailable:"):
                        return int(line.split()[1]) // 1024
        except (OSError, ValueError, IndexError):
            return None
        return None
    try:
        out = subprocess.run(
            ["vm_stat"], capture_output=True, text=True, timeout=2.0,
        )
        if out.returncode != 0:
            return None
        page = 4096
        classes = {"Pages free:": 0, "Pages inactive:": 0,
                  "Pages purgeable:": 0, "Pages speculative:": 0}
        for line in out.stdout.splitlines():
            ls = line.strip()
            if "page size of" in ls:
                m = re.search(r'page size of (\d+)', ls)
                if m:
                    page = int(m.group(1))
                continue
            for key in classes:
                if ls.startswith(key):
                    # "Pages free:  832602." -> strip the trailing dot
                    tail = ls[len(key):].strip().rstrip('.')
                    try:
                        classes[key] = int(tail)
                    except ValueError:
                        pass
        return (sum(classes.values()) * page) // (1024 * 1024)
    except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
        pass
    return None


def _resident_tenant_mb():
    """The resident model server footprint in MB (0 = none).  Mirror of
    tools/runner._declared_tenant_reservation_bytes, in MB:
      1. WEIZIGO_HOST_TENANT_RESERVATION_MB — declared reservation, verbatim
         (including 0 = explicitly no tenant);
      2. when the available reading is INJECTED, no auto-detection runs —
         the test owns the whole scenario, a tenant must be declared;
      3. otherwise: the summed RSS of every process whose command carries
         `ollama runner --mlx-engine` (the resident MLX engine — the
         multi-GB holder).  No match ⇒ 0."""
    injected = os.environ.get("WEIZIGO_HOST_TENANT_RESERVATION_MB")
    if injected is not None:
        try:
            return int(injected)
        except ValueError:
            return 0
    if os.environ.get("WEIZIGO_HOST_MEM_AVAIL_MB") is not None:
        return 0
    try:
        out = subprocess.run(
            ["ps", "-axo", "pid=,rss=,command="],
            capture_output=True, text=True, timeout=2.0,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return 0
    if out.returncode != 0:
        return 0
    total = 0
    for line in out.stdout.splitlines():
        if "ollama runner --mlx-engine" not in line:
            continue
        parts = line.split(None, 2)
        if len(parts) < 2:
            continue
        try:
            total += int(parts[1]) // 1024   # ps RSS is in kB
        except ValueError:
            continue
    return total


def _lane_is_memory_heavy(provider, raw_model):
    """A lane is memory-heavy when it loads a big LOCAL model: provider
    ollama with a non-`:cloud` tag.  Cloud-API lanes (deepseek, claude,
    pi/openrouter) and `:cloud` ollama tags keep a small local RSS — they
    dispatch freely, the gate never applies to them."""
    if provider != "ollama":
        return False
    if raw_model and ":cloud" in raw_model:
        return False
    return True


def _memory_gate_verdict(provider, raw_model, tenant_mb):
    """→ (admit, reason).  Cloud-API lanes always admit.  A memory-heavy
    lane is admitted only while a resident tenant is present AND the host
    has at least lane_cost + margin MB genuinely available; no tenant ⇒ no
    reduced budget ⇒ gate inactive; reading unavailable ⇒ gate inert."""
    if not _lane_is_memory_heavy(provider, raw_model):
        return True, None
    if tenant_mb <= 0:
        return True, None
    avail = _host_avail_mb()
    if avail is None:
        return True, None
    try:
        cost = int(os.environ.get("WEIZIGO_LANE_COST_MB")
                   or LOCAL_LANE_COST_DEFAULT_MB)
    except ValueError:
        cost = LOCAL_LANE_COST_DEFAULT_MB
    margin = MEMORY_GATE_MARGIN_MB
    if avail >= cost + margin:
        return True, None
    return False, (
        f"memory budget cannot take another memory-heavy lane (T713): host "
        f"reports {avail} MB available and the model server is resident "
        f"(tenant ~{tenant_mb} MB); a local model lane costs "
        f"~{cost} MB (+ {margin} MB margin).  Launching it now would push "
        f"the host toward OOM — where the runner's host guard would have to "
        f"kill a running lane (fratricide).  List-wait: leave the row "
        f"dispatchable and re-dispatch when a lane finishes; idle is "
        f"acceptable, killing a running lane is not (operator intent)."
    )


_session_path_counter = itertools.count()


def _pi_session_path(task_id):
    """Per-lane pi session file for the token meter (T662).

    `pi --session <path>` writes its session JSONL to exactly this file;
    the runner reads it after the lane closes and records the usage split
    (fresh vs cache_read) in the run record, trailer and ledger.  The path
    is unique per dispatch attempt — T792: the original `int(time.time())`
    (whole-second) formula let two attempts of the same task launched
    within one wall-clock second collide on the same filename, exactly the
    overwrite T650/T662 exist to prevent.  `time.time_ns()` alone is not
    sufficient EITHER — on this host two calls a few instructions apart can
    still land on the same clock tick — so the path also carries the pid
    (disambiguates concurrent processes at the same tick) and a per-process
    monotonic counter (disambiguates repeated calls within one process).
    Nothing parses this timestamp, so widening the format is safe.  Lives
    under untracked/tokens/ (the capture home); the runner mkdirs the
    parent at launch."""
    ident = task_id if task_id else "lane"
    return (f"untracked/tokens/sessions/{ident}.{time.time_ns()}."
            f"{os.getpid()}.{next(_session_path_counter)}.jsonl")


def run_worker(cmd, cwd, env):
    """Run the worker, streaming its stdout to the parent while capturing it."""
    proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE,
                            text=True, bufsize=1)
    chunks = []
    for line in proc.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        chunks.append(line)
    rc = proc.wait()
    return rc, "".join(chunks)


def parse_argv(argv):
    """Split argv into (positional args, flags dictionary)."""
    args, flags, i = [], {}, 0
    while i < len(argv):
        a = argv[i]
        if a in ("--model", "--wall", "--provider") and i + 1 < len(argv) and not argv[i + 1].startswith("--"):
            flags[a.lstrip("-")] = argv[i + 1]
            i += 2
            continue
        if "=" in a and a.startswith("--"):
            k, v = a.split("=", 1)
            flags[k.lstrip("-")] = v
            i += 1
            continue
        if a.startswith("--"):
            flags[a.lstrip("-")] = True
            i += 1
            continue
        args.append(a)
        i += 1
    return args, flags


def _resolve_model(provider, raw_model, flags):
    """→ (model, error).  Turn a provider + raw dispatch tag into the
    canonical label bin/managent's canonical_models[] expects (the same
    fact surface as docs/infra/model-registry.md and
    src/managent/main.zig's canonicalizeModelTag).  `error` is None on
    success and a ready-to-print message (for `sys.exit`) otherwise.

    A bare `--model` with no value parses as flags['model'] is True
    (parse_argv), not a string; treating that the same as "missing" (T792
    fix) avoids a TypeError crash that `re.sub(..., True)` used to raise
    for the ollama branch below when a caller passed the flag with no tag.

    ollama fallback (T792 finding, not changed here): a tag outside
    OLLAMA_TAG_TO_CANONICAL is accepted by stripping a trailing `:cloud`
    rather than refused — the same permissive behaviour as
    canonicalizeModelTag, so it is not a NEW divergence, but it means a
    typo'd or retired tag (e.g. `kimi-k2-thinking:cloud`, retired per
    model-registry.md) silently produces a non-canonical label instead of
    an error a human would see immediately."""
    if raw_model is True:
        raw_model = None
    if provider == "deepseek":
        # DeepSeek: model is chosen from --dspro/--dsflash flags
        chosen_ds = [f"--{k}" for k in ("dspro", "dsflash") if flags.get(k) is True]
        if len(chosen_ds) != 1:
            return None, "subagent: for --provider deepseek, name exactly one model — --dspro or --dsflash"
        return DS_MODELS[chosen_ds[0]], None
    if provider == "claude":
        # Claude: --model <canonical claude label> is required; the label is
        # passed straight to `claude -p --model`, so it must be canonical.
        if not raw_model:
            return None, ("subagent: for --provider claude, --model <canonical claude label> "
                          "is required\n  canonical: " + ", ".join(sorted(CLAUDE_MODELS)) + "\n")
        if raw_model not in CLAUDE_MODELS:
            return None, (f"subagent: '{raw_model}' is not a canonical claude label.\n"
                          f"  canonical: {', '.join(sorted(CLAUDE_MODELS))}\n")
        return raw_model, None
    if provider == "pi":
        # T732: pi harness, openrouter backend.  --model is the SERVING tag
        # (stealth/ox-alpha); model is the canonical label (ox-alpha) so the
        # serving tag never reaches the ledger.
        if not raw_model:
            return None, "subagent: for --provider pi, --model <serving tag> is required\n"
        model = PI_TAG_TO_CANONICAL.get(raw_model)
        if model is None:
            return None, (f"subagent: '{raw_model}' is not a known pi serving tag.\n"
                          f"  known: {', '.join(sorted(PI_TAG_TO_CANONICAL))}\n")
        return model, None
    # ollama
    if not raw_model:
        return None, "subagent: for --provider ollama, --model <tag> is required\n"
    model = OLLAMA_TAG_TO_CANONICAL.get(raw_model)
    if model is None:
        model = re.sub(r":cloud$", "", raw_model)
    return model, None


def main(argv):
    args, flags = parse_argv(argv)
    provider = flags.get("provider")

    # C2.1: --provider is REQUIRED
    if not provider:
        sys.exit("subagent: missing --provider (deepseek|ollama|claude|pi)\n" + __doc__)
    if provider not in PROVIDERS:
        sys.exit(f"subagent: unknown provider '{provider}' — must be one of "
                 f"{', '.join(sorted(PROVIDERS))}\n")

    # Depth cap (shared, before provider branch — NF2 resolved)
    try:
        depth = int(os.environ.get(DEPTH_VAR, "1"))
    except ValueError:
        depth = MAX_DEPTH
    if depth >= MAX_DEPTH:
        sys.exit(f"subagent: REFUSED — you are at the delegation cap (depth {depth} "
                 f"of {MAX_DEPTH}). The chain has to end somewhere and it ends with "
                 f"you.\nWrite your output to a file or return it to your manager, "
                 f"then stop.\nIf the task genuinely needs delegating, say so and let "
                 f"your manager decide.")

    target = args[0] if args else None
    if not target or len(args) != 1:
        sys.exit(__doc__)

    wall = flags.get("wall", "1800")
    rss_mb = flags.get("rss-cap-mb")  # deepseek only
    raw_model = flags.get("model")    # ollama only
    test_root = flags.get("test-root")
    test_worker = flags.get("test-worker")
    dry_run = "dry-run" in flags
    root = os.path.abspath(test_root) if test_root else ROOT

    # ── Resolve model ──────────────────────────────────────────────────
    model, resolve_err = _resolve_model(provider, raw_model, flags)
    if resolve_err:
        sys.exit(resolve_err)

    # ── resident-aware memory gate (T713) ────────────────────────────────
    # When the model server is resident, the dispatcher knows the reduced
    # memory budget (host total − tenant) and refuses a memory-heavy lane
    # the host cannot take — list-wait, never a kill.  Cloud-API lanes
    # (deepseek / claude / pi / :cloud ollama tags) dispatch freely; the
    # gate only ever applies to local-model lanes (provider ollama, local
    # tag).  This is the launch chokepoint — every lane, dispatch or hand,
    # passes through here (the T677/D040 principle), so a gate only in
    # bin/dispatch would be advisory.  A dry-run reveals the refusal the
    # same way a launch would.
    if _lane_is_memory_heavy(provider, raw_model):
        tenant = _resident_tenant_mb()
        total = _host_total_mb()
        if tenant > 0 and total is not None:
            print(f"[subagent] T713: model server resident (tenant {tenant} MB) — "
                  f"fleet budget reduced to {total - tenant} MB "
                  f"(total {total} MB)", file=sys.stderr)
        elif total is not None:
            print(f"[subagent] T713: memory-heavy lane ({raw_model}) — no resident "
                  f"model server detected; host total {total} MB", file=sys.stderr)
        override = flags.get("override-memory-gate")
        if override is True:   # bare flag, no value — parse_argv yields True
            sys.exit("subagent: --override-memory-gate requires a reason: "
                     "--override-memory-gate=<reason> (T713).\n"
                     "  The flag exists for 'I have checked the host myself; "
                     "proceed', not for convenience.")
        admit, mem_reason = _memory_gate_verdict(provider, raw_model, tenant)
        if not admit:
            override = (flags.get("override-memory-gate") or "").strip()
            if override:
                print(f"subagent: WARNING — memory gate OVERRIDDEN for this launch "
                      f"by operator reason {override!r} (T713); the host is tight "
                      f"and the lane may compete for memory", file=sys.stderr)
            else:
                sys.exit("subagent: REFUSED — " + mem_reason + "\n"
                         "  If you have checked the host yourself, launch with a "
                         "recorded reason: --override-memory-gate=<reason> (T713).\n")

    # ── provider-window gate (T628 + T677): the real launch chokepoint ──
    # bin/dispatch gates too, but subagent is where every lane actually
    # launches — a gate only in dispatch is advisory (D040/T612: tonight's
    # probe lane went around it via subagent).  A family in window cooldown
    # refuses HERE with the same recorded override escape hatch.  The
    # cooldown arms only from a terminal run record of a lane of that
    # family (T677) — worker stdout is not evidence — so enforcement is
    # safe: the false-arm class that locked claude out tonight is gone.
    fam = window_policy.family_of(model)
    if fam != "other":
        now = time.time()
        c = window_policy.family_cooldown(root, now).get(fam)
        if c is not None:
            override_reason = (flags.get("override-window-cooldown") or "").strip()
            if override_reason:
                if not dry_run:
                    window_policy.record_override(
                        root, task_id if task_id else (target or "?"),
                        fam, c, override_reason, now)
                print(f"subagent: WARNING — window cooldown for family {fam} "
                      f"OVERRIDDEN for this launch by operator reason "
                      f"{override_reason!r} (T677)", file=sys.stderr)
            else:
                fallback_note = ""
                if c.get("fallback"):
                    fallback_note = (
                        "\n"
                        f"  The reset could not be parsed, so this is a SHORT fallback "
                        f"cooldown (probe scheduled for the reset time above); the "
                        f"watcher re-checks the provider with ONE lane then.  If you "
                        f"have checked the provider yourself, override with "
                        f"--override-window-cooldown=<reason> (T677).")
                sys.exit(
                    f"subagent: REFUSED — family {fam} is in window cooldown until "
                    f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(c['until']))} "
                    f"(reset {c.get('reset_text') or '?'!r} from {c.get('source') or '?'}) "
                    f"(T628).\n"
                    f"  The provider's 5-hour window limit is still in force; a lane now "
                    f"would die of the same limit (2026-08-22 12:47Z: five claude lanes "
                    f"re-fired into the dead window).  This gate is ENFORCED at "
                    f"subagent — every lane launch, dispatch or hand (T677/D040)."
                    + fallback_note)

    # ── Nonce ──────────────────────────────────────────────────────────
    nonce = dispatch_verify.generate_nonce()

    # ── Task resolution ────────────────────────────────────────────────
    task_id = None
    deliverables = []
    if re.fullmatch(r"T\d+", target):
        hits = glob.glob(os.path.join(root, "untracked", f"{target}-*.md"))
        if len(hits) != 1:
            sys.exit(f"subagent: expected one bundle for {target}, found {len(hits)}")
        bundle = os.path.relpath(hits[0], root)
        task_id = target
        slug = re.sub(rf"^{target}-|\.md$", "", os.path.basename(bundle))
        deliverables = dispatch_verify.parse_deliverables(
            hits[0], f"findings/{target}-{slug}.json")
        dl_lines = "\n".join(f"  - {d}" for d in deliverables)
        delegate_note = (
            "You are a manager: you may dispatch your own sub-rows with "
            "bin/subagent or bin/ollama-subagent, and you never ask the human "
            "to relay a dispatch. The brief carries everything.\n\n"
            if depth + 1 < MAX_DEPTH else
            "You are a leaf: you are at the delegation cap and do not dispatch. "
            "The brief carries everything.\n\n"
        )
        prompt = (f"Follow {bundle}\n\n"
                  f"BEFORE READING THE BUNDLE: run `bin/managent orient` — it prints the\n"
                  f"≤150-line worker preamble (principles, live gates, the kanban, fresh\n"
                  f"activity) composed at read time, replacing the AGENTS.md/DELEGATEE.md/\n"
                  f"sprint.md/DIRECTION.md/WAYPOINTS.md/STATE.md reading list. The bundle and\n"
                  f"the sprint's ratified spec/plan are still required; orient is the\n"
                  f"preamble, not a replacement for them.\n\n"
                  f"FIRST: bin/managent claim {target} --agent {model}\n"
                  + delegate_note
                  + f"{dispatch_verify.nonce_prompt_lines(nonce)}"
                  f"WHEN DONE, before any other output:\n"
                  f"  Deliverables declared by the bundle (managent done checks every one):\n"
                  f"{dl_lines}\n"
                  f"  1. Write these files per findings/README.md\n"
                  f"  2. bin/managent done {target} --agent {model} --status <pass|pass-with-findings|"
                  f"fail-found|blocked|abandoned> --note <one line> --impression <one line> (or\n"
                  f"     --impression-waiver <reason> when no impression is owed)\n\n"
                  f"INBOX LOOP (T352):\n"
                  f"  The human used to relay messages between consoles by hand. That relay\n"
                  f"  is now a `managent tell` directive you can poll for.  At each natural\n"
                  f"  checkpoint — after a commit, before starting a new sub-step, and\n"
                  f"  before reporting done — run:\n"
                  f"      bin/managent inbox {target} --ack\n"
                  f"  A directive of `pause`, `amend` or `question` is actionable: act on\n"
                  f"  it and record the directive ID (D0NN) in your findings file's\n"
                  f"  `notes` field, so the Orchestrator can see you read it.  A directive\n"
                  f"  of `kill` writes your context dump and exits.  An empty inbox is a\n"
                  f"  no-op (do not be alarmed).  The brief carries everything else.\n")
    elif os.path.isfile(target):
        prompt = f"Follow {os.path.relpath(os.path.abspath(target), root)}\n"
        prompt += "\n" + dispatch_verify.nonce_prompt_lines(nonce)
        deliverables = dispatch_verify.parse_deliverables(os.path.abspath(target))
    else:
        sys.exit(f"subagent: no such task or file: {target}")

    # ── Environment ────────────────────────────────────────────────────
    if provider == "deepseek" and not test_worker:
        if not os.environ.get("DEEPSEEK_API_KEY"):
            sys.exit("subagent: DEEPSEEK_API_KEY is not set")
    env = dict(os.environ, **{DEPTH_VAR: str(depth + 1)})
    if task_id:
        env["MANAGENT_TASK_ID"] = task_id

    # ── Build command ──────────────────────────────────────────────────
    if test_worker:
        cmd = [test_worker, prompt]
    elif provider == "deepseek":
        cmd = ["tools/runner", "--max-wall", wall]
        if rss_mb:
            cmd.extend(["--rss-cap-mb", rss_mb])
        # T586: --mode json makes pi stream its session events (reasoning,
        # tool calls, usage) to stdout in real time instead of buffering
        # until the final reply.  That stream is the liveness signal
        # tools/runner needs to tell a working worker from a hung one — the
        # nonce-stall failure mode was a pi worker producing ZERO stdout
        # for its whole run and being SIGKILLed at --max-wall mid-work.
        # T662: --session <per-lane path> — pi writes its session JSONL
        # (the token meter) to this exact file, so the runner can read the
        # usage after the lane closes (T558 made the same change for
        # bakeoff deepseek lanes).
        session_rel = _pi_session_path(task_id)
        cmd.extend(["--", "pi", "--provider", "deepseek", "--model", model,
                    "--mode", "json", "--session", session_rel, "-p", prompt])
    elif provider == "claude":
        # T494: the headless Claude Code harness. The model runs in its own
        # process (claude -p), never through the Anthropic API from here —
        # the fence the rule actually draws (subdelegation.md:152-156).
        # runner supplies the wall/RSS guards the T481 precedent logged.
        # T521: --output-format json — the usage envelope is the token-
        # capture source (G1 is run-time, not retroactive); the runner
        # unwraps the text for verification, so the lane's stdout and the
        # nonce check are unchanged.
        # T552: the same envelope carries the resumable session handle;
        # the runner records it beside the token counts (run record,
        # lane trailer, ledger line) — null with a reason for the
        # pi/ollama lanes, which never emit one. The dispatch shape is
        # unchanged; capture is the wrapper's job.
        cmd = ["tools/runner", "--max-wall", wall, "--",
               "claude", "-p", prompt, "--model", model,
               "--allowedTools", CLAUDE_ALLOWED_TOOLS,
               "--output-format", "json"]
    elif provider == "pi":
        # T732: headless pi against the openrouter backend.  The serving tag
        # (raw_model = stealth/ox-alpha) goes to pi's --model; the canonical
        # label (model = ox-alpha) is what verification/ledger sees.  Shape
        # is the operator-verified form
        # (`pi --provider openrouter --model stealth/ox-alpha -p "<prompt>"`),
        # wrapped in tools/runner for the wall guard.
        cmd = ["tools/runner", "--max-wall", wall, "--",
               "pi", "--provider", "openrouter", "--model", raw_model,
               "-p", prompt]
    else:  # ollama
        # T662: --session <per-lane path> goes to the INNER pi (after the
        # `--` ollama's separator), so the ollama lane's session JSONL is
        # a known per-lane file the runner reads after close — the meter
        # works for local lanes too, not just deepseek.
        session_rel = _pi_session_path(task_id)
        cmd = ["tools/runner", "--max-wall", wall, "--",
               "ollama", "launch", "pi", "--model", raw_model, "-y", "--",
               "--session", session_rel, "-p", prompt]

    if dry_run:
        print(f"{DEPTH_VAR}={depth + 1}")
        if task_id:
            print(f"MANAGENT_TASK_ID={task_id}")
        print(" ".join(repr(c) if "\n" in c else c for c in cmd))
        return 0

    t_run0 = time.monotonic()
    rc, stdout = run_worker(cmd, root, env)
    wall_seconds = time.monotonic() - t_run0

    # ── T411: verify the WORK, never the reply ────────────────────────
    t0 = time.monotonic()
    exit_code, summary, details, perf = dispatch_verify.verify_dispatch(
        root=root, task_id=task_id, model=model, nonce=nonce, stdout=stdout,
        rc=rc, store_env=os.environ.get("MANAGENT_STORE"),
        deliverables=deliverables)
    verify_ms = (time.monotonic() - t0) * 1000.0
    print(f"[verify] {summary}", file=sys.stderr)
    for line in details:
        print(f"[verify]   {line}", file=sys.stderr)
    print(f"[verify] verification phase took {verify_ms:.0f} ms", file=sys.stderr)
    dispatch_verify.record_perf(root, perf)

    # ── T477: heal the one wound the dispatcher can heal ───────────────
    # If verification failed AND the worker died (rc != 0) leaving the row
    # in_progress, reopen it so it returns to dispatchable — the process
    # that watched the worker die is still running and already knows. Heal
    # ONLY this case; every other failure is left for the Orchestrator.
    if exit_code != 0:
        try:
            healed, heal_line = dispatch_verify.heal_dispatch(
                root=root, real_root=ROOT, task_id=task_id, model=model,
                rc=rc, wall_seconds=wall_seconds,
                store_env=os.environ.get("MANAGENT_STORE"))
            if heal_line:
                print(f"[verify] {heal_line}", file=sys.stderr)
        except Exception as e:
            # T631 invariant: a crashed heal must never leave a row SILENTLY
            # in_progress.  The heal is the one automatic reopen; if it dies
            # (a committed bug, a disk fault — anything the pin cannot cover),
            # the row is left for a human but flagged loudly and recorded in
            # the heals census, so the T616 zombie cannot recur unseen.
            if task_id is not None:
                _flag_manual_heal(task_id, model, rc, wall_seconds, e)
    return exit_code


def _flag_manual_heal(task_id, model, rc, wall_seconds, exc):
    """T631: record a heal that crashed as needing a MANUAL heal.

    Self-contained (stdlib only, no dispatch_verify calls) so a broken
    contract cannot break the marker that flags its own breakage.  Appends a
    `needs_manual_heal` record to the same heals log heal_dispatch writes
    (WEIZIGO_DISPATCH_HEALS or docs/infra/dispatch-heals.jsonl) and prints a
    loud [verify] line.  The record still carries healed_by=dispatcher — the
    dispatcher is the actor (F4/T513: the heals log is the census of who
    reopens; any record not carrying it is a second owner) — but `healed:
    false` marks it as NO reopen having happened.
    """
    import json
    rec = {
        "task_id": task_id,
        "model": model,
        "exit_code": rc,
        "wall_seconds": round(wall_seconds, 1),
        # F4/T513: "dispatcher" duplicates dispatch_verify.HEAL_OWNER on
        # purpose — a broken contract must not be able to break the marker.
        "healed_by": "dispatcher",
        "healed": False,
        "needs_manual_heal": True,
        "error": "%s: %s" % (type(exc).__name__, exc),
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    path = (os.environ.get("WEIZIGO_DISPATCH_HEALS")
            or os.path.join(ROOT, "docs", "infra", "dispatch-heals.jsonl"))
    try:
        with open(path, "a") as f:
            f.write(json.dumps(rec) + "\n")
        note = "marker appended to %s" % path
    except OSError as e:
        note = "MARKER WRITE FAILED (%s)" % e
    print("[verify] HEAL CRASHED for %s (%s: %s) — row may be in_progress and "
          "needs a MANUAL heal; %s"
          % (task_id, type(exc).__name__, exc, note), file=sys.stderr)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
