#!/usr/bin/env python3
"""Backward-compat wrapper: bin/subagent --provider deepseek.

T440: resolve the target from THIS file's location. The original used a bare
relative "bin/subagent", so the wrapper only worked when the cwd happened to be
the repo root and died anywhere else.
"""
import os, subprocess, sys
HERE = os.path.dirname(os.path.abspath(__file__))
sys.exit(subprocess.call(
    [sys.executable, os.path.join(HERE, "subagent"), "--provider", "deepseek"] + sys.argv[1:]))
